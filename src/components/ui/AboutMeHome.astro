---
import { ui, defaultLang } from '../../i18n/ui';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

// Foto naast de tekst (staande foto's werken het mooist)
const photo = { src: '/images/about/great-ocean-road.jpg', alt: 'Great Ocean Road' };
---

<!-- Licht turquoise, zelfde als de Moments-secties op andere pagina's; de services eronder zijn licht beige -->
<section class="bg-[#E6F6F6] py-12 md:py-16">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">

    <!-- Foto -->
    <!-- Foto iets ingezoomd (scale), de ronde rand knipt de rest af -->
    <div class="mx-auto w-full min-w-0 max-w-sm overflow-hidden rounded-[2rem] shadow-[0_25px_60px_rgba(0,0,0,0.15)] lg:max-w-[24rem]">
      <img
        src={photo.src}
        alt={photo.alt}
        loading="lazy"
        class="aspect-[9/10] w-full scale-[1.15] object-cover md:aspect-[4/5]"
      />
    </div>

    <!-- Tekst (op mobiel iets meer ruimte aan de zijkanten) -->
    <div class="px-3 lg:px-0">
      <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('home.about.preheader')}</p>
      <h2 class="mt-3 text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">
        {t('home.about.title')}
      </h2>

      <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-gray-600 md:text-base">
        <p>{t('home.about.p1')}</p>
        <p>{t('home.about.p2')}</p>
      </div>

      <a
        href={`/${lang}/about`}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]"
      >
        {t('home.about.cta')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

