---
// src/components/ui/ThroughMyLens.astro
// "Een kijkje door mijn lens": mozaïek van de mooiste foto's (max 10) met lightbox.
// Volgorde loopt van links naar rechts: foto's worden om en om over de kolommen verdeeld.
// Foto's en volgorde staan in src/data/lens.ts.
import { Image, getImage } from 'astro:assets';
import { defaultLang } from '../../i18n/ui';
import { lensPhotos } from '../../data/lens';

const lang = (Astro.currentLocale || defaultLang) === 'en' ? 'en' : 'nl';

const labels = {
  nl: { title: 'Een kijkje door mijn lens', close: 'Sluiten', prev: 'Vorige', next: 'Volgende' },
  en: { title: 'A look through my lens', close: 'Close', prev: 'Previous', next: 'Next' },
}[lang];

const assetImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });

const photos = (await Promise.all(
  lensPhotos.slice(0, 10).map(async (p) => {
    const img = assetImages[`../../assets/${p.file}`]?.default;
    if (!img) return null;
    const large = await getImage({ src: img, width: 1800, format: 'webp' });
    return { img, large: large.src, location: p.location?.[lang] ?? '' };
  })
)).filter((p): p is NonNullable<typeof p> => p !== null);

// Om en om verdelen (foto 1 links, 2 midden, 3 rechts, 4 weer links…), zodat je van links naar rechts leest
// Een onvolledige laatste rij komt in het midden te staan (bijv. 1 foto onder de middelste kolom).
const toColumns = (n: number) => {
  const lastRowStart = Math.floor(photos.length / n) * n;
  const lastRowCount = photos.length - lastRowStart;
  const offset = Math.floor((n - lastRowCount) / 2);
  const colOf = (i: number) => (i < lastRowStart ? i % n : i - lastRowStart + offset);
  return Array.from({ length: n }, (_, c) => photos.map((p, i) => ({ ...p, i })).filter((p) => colOf(p.i) === c));
};
const layouts = [
  { cols: toColumns(2), class: 'flex md:hidden' },
  { cols: toColumns(3), class: 'hidden md:flex' },
];

const largeList = JSON.stringify(photos.map((p) => p.large));
const captionList = JSON.stringify(photos.map((p) => p.location));
---

{photos.length > 0 && (
<section id="lens" class="lens scroll-mt-20 bg-[#FFFDFA] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">

    <h2 class="text-center text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-left md:text-5xl">{labels.title}</h2>

    <!-- Blok: alle kolommen even hoog, foto's vullen hun vak (bijsnijden) zodat er geen gaten zijn.
         Desktop met 4 foto's: Markt links hoog, Straat + Opa in het midden, Jungle rechts hoog. -->
    {layouts.map((layout) => (
      <div class:list={['mt-12 h-[30rem] items-stretch gap-3 md:mt-14 md:h-[38rem] md:gap-4', layout.class]}>
        {layout.cols.map((col) => (
          <div class="flex min-w-0 flex-1 flex-col gap-3 md:gap-4">
            {col.map((p) => (
              <button
                type="button"
                class="group relative block min-h-0 w-full flex-1 cursor-zoom-in overflow-hidden rounded-[1.25rem] bg-[#E6F6F6]"
                data-lens-open
                data-index={p.i}
                aria-label={p.location || `${labels.title} ${p.i + 1}`}
              >
                <Image
                  src={p.img}
                  alt={p.location}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1152px) 360px, (min-width: 768px) 33vw, 50vw"
                  loading="lazy"
                  class="block h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                />
                {p.location && (
                  <span class="pointer-events-none absolute bottom-3 left-3 rounded-full bg-black/35 px-3 py-1 text-[10px] uppercase tracking-wide text-white opacity-0 backdrop-blur-sm transition duration-300 group-hover:opacity-100 md:text-xs">
                    {p.location}
                  </span>
                )}
              </button>
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>

  <!-- Lightbox -->
  <dialog class="lens-box m-0 h-full max-h-none w-full max-w-none bg-transparent p-0" data-lens-box data-large={largeList} data-captions={captionList}>
    <div class="flex h-full w-full items-center justify-center p-4 md:p-10" data-lens-backdrop>
      <img data-lens-img alt="" class="max-h-full max-w-full rounded-xl object-contain shadow-2xl" />
    </div>
    <button type="button" data-lens-close aria-label={labels.close} class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition hover:bg-white/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
    <button type="button" data-lens-prev aria-label={labels.prev} class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition hover:bg-white/25 md:left-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button type="button" data-lens-next aria-label={labels.next} class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition hover:bg-white/25 md:right-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
    <p class="absolute bottom-5 left-1/2 -translate-x-1/2 text-center text-sm text-white/85">
      <span data-lens-caption></span> <span data-lens-count class="text-white/50"></span>
    </p>
  </dialog>
</section>
)}

<style>
  .lens-box::backdrop {
    background: rgba(4, 30, 32, 0.92);
  }
  .lens-box[open] {
    animation: lens-in 0.25s ease both;
  }
  @keyframes lens-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-lens-box]').forEach((box) => {
    const section = box.closest('section');
    if (!section) return;
    const photos: string[] = JSON.parse(box.dataset.large ?? '[]');
    const captions: string[] = JSON.parse(box.dataset.captions ?? '[]');
    const img = box.querySelector<HTMLImageElement>('[data-lens-img]')!;
    const caption = box.querySelector<HTMLElement>('[data-lens-caption]')!;
    const count = box.querySelector<HTMLElement>('[data-lens-count]')!;
    let index = 0;

    const show = () => {
      img.src = photos[index];
      img.alt = captions[index] ?? '';
      caption.textContent = captions[index] ?? '';
      count.textContent = `${index + 1} / ${photos.length}`;
    };
    const step = (d: number) => {
      index = (index + d + photos.length) % photos.length;
      show();
    };

    section.querySelectorAll<HTMLButtonElement>('[data-lens-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        index = Number(btn.dataset.index ?? 0);
        show();
        box.showModal();
      });
    });

    box.querySelector('[data-lens-prev]')?.addEventListener('click', () => step(-1));
    box.querySelector('[data-lens-next]')?.addEventListener('click', () => step(1));
    box.querySelector('[data-lens-close]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-lens-backdrop]')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) box.close();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
  });
</script>
