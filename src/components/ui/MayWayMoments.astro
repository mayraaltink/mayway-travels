
---
const moments = Array.from({ length: 15 }, (_, i) => ({
  image: `/images/community/moment${(i % 5) + 1}.jpg`,
  title: `Moment ${i + 1}`,
  caption: "A special memory from the road.",
  description:
    "Here you can write a longer story about this moment. Share what happened, why this place was special or give travel tips related to the location."
}));
---

<section class="py-20 bg-[#FFFDFA] overflow-hidden">

  <!-- HEADER -->
  <div class="max-w-3xl mx-auto text-center px-6 mb-12">

    <p class="uppercase tracking-[0.2em] text-[#1CABB0] text-sm mb-3">
      Community
    </p>

    <h2 class="text-4xl font-semibold mb-4 text-gray-900">
      MAY WAY Moments
    </h2>

    <p class="text-gray-600 max-w-xl mx-auto leading-relaxed">
      Deel jouw MAY WAY momenten en laat je inspireren door verhalen, bestemmingen en herinneringen van reizigers.
    </p>

  </div>

  <!-- FULL-WIDTH SWIPE SLIDER -->
  <div
    class="w-full overflow-x-auto overflow-y-hidden pl-6 md:pl-10 pr-6 pb-6 snap-x snap-mandatory scrollbar-hide"
  >
    <div class="flex gap-5 md:gap-6 w-max">

      {moments.map((moment) => (
        <article
          class="group flex-shrink-0 w-[75vw] sm:w-[42vw] lg:w-[calc((100vw-10rem)/4)] lg:max-w-[340px] snap-start rounded-3xl overflow-hidden bg-white shadow-md hover:shadow-xl transition duration-300"
        >

          <div class="h-64 md:h-72 overflow-hidden">
            <img
              src={moment.image}
              alt={moment.title}
              loading="lazy"
              class="h-full w-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>

          <div class="p-5 md:p-6 text-left">
            <h3 class="text-lg font-semibold mb-2 text-gray-900">
              {moment.title}
            </h3>

            <p class="text-gray-500 text-sm leading-relaxed">
              {moment.caption}
            </p>
          </div>

        </article>
      ))}

    </div>
  </div>

  <!-- SWIPE INDICATOR -->
  <p class="text-center text-sm text-gray-500 mt-2">
    <span class="text-[#1CABB0]">←</span>
    &nbsp; Swipe om meer momenten te ontdekken &nbsp;
    <span class="text-[#1CABB0]">→</span>
  </p>

</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
