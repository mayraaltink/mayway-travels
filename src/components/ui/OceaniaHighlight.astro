---
// src/components/ui/OceaniaHighlight.astro
// Uitgelichte bestemming: één grote fotobanner met de tekst en knop in het midden.
// Foto hieronder te vervangen (bestand in /public).
import { ui, defaultLang } from '../../i18n/ui';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

const href = `/${lang}/destinations/australia`;
const image = '/images/australia/aus_main.jpg';
---

<!-- Zelfde beige als de footer; loopt 1.5rem door onder de ronde hoeken van de footer (-mb-6), zodat daar geen wit zichtbaar is.
     Onderkant = bovenkant + 1.5rem, zodat de zichtbare ruimte boven en onder gelijk is (4rem) -->
<section class="-mb-6 bg-[#FFFDFA] px-3 pb-[5.5rem] pt-16 md:px-6">
  <div class="relative flex min-h-[560px] items-center justify-center overflow-hidden rounded-[2.5rem] md:h-[85vh] md:max-h-[820px] md:rounded-[3.5rem]">

    <!-- Foto -->
    <img src={image} alt={t('oceania.card.title')} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/35 to-black/45"></div>

    <!-- Tekst -->
    <div class="relative z-10 mx-auto max-w-3xl px-6 py-20 text-center text-white">
      <p class="text-xs uppercase tracking-[0.2em] text-white/90">{t('oceania.eyebrow')}</p>
      <!-- Zelfde stijl als "Samen brengen we jouw merk tot leven." -->
      <h2 class="mt-3 text-4xl font-normal leading-[1.05] tracking-tight md:text-5xl" style="text-shadow: 0 3px 15px rgba(0,0,0,0.35);">
        <span class="block">{t('oceania.title.before')}</span>
        <b class="block font-semibold">{t('oceania.title.bold')}</b>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-[15px] font-medium leading-relaxed text-white/90 md:text-base" style="text-shadow: 0 2px 10px rgba(0,0,0,0.35);">
        {t('oceania.description')}
      </p>
      <a
        href={href}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-8 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#15939a]"
      >
        {t('oceania.card.button')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>
