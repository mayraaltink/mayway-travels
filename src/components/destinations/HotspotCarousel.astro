---
// src/components/destinations/HotspotCarousel.astro
// "Ontdek Hotspots": swipebare kaarten met de bijzonderste ervaringen van Australië.
// Foto's: /public/images/<naam>.jpg (bijv. whitsundays.jpg). Ontbreekt een foto, dan toont de kaart een turquoise vlak.
import fs from 'node:fs';
import path from 'node:path';
import { useTranslations } from '../../i18n/ui';
import CarouselControls from '../ui/CarouselControls.astro';

export interface Props {
  /** sleutels in ui.ts: `${key}_badge`, `_title`, `_text`, `_story` */
  hotspots?: string[];
  /** foto per hotspot; zonder foto wordt /images/<key>.jpg gezocht */
  photos?: Record<string, string>;
  descKey?: string;
}

const lang = (Astro.currentLocale ?? 'nl') as 'nl' | 'en';
const t = useTranslations(lang);
const get = (k: string) => t(k as any) as string;

function imageSrc(src: string) {
  return fs.existsSync(path.join(process.cwd(), 'public', src)) ? src : null;
}

const australiaHotspots = [
  'whitsundays',
  'fraser',
  'julian_rocks',
  'reef',
  'daintree',
  'blue_mountains',
  'hunter_valley',
  'jervis_bay',
  'mackay',
  'great_ocean',
  'kangaroo_island',
  'magnetic',
  'uluru',
  'kakadu',
  'ningaloo',
];

// Foto's die al op de site staan; de rest zoekt naar /images/<naam>.jpg
const australiaPhotos: Record<string, string> = {
  reef: '/images/australia/unnamed.jpg',
  uluru: '/images/australia/aus_main.jpg',
  great_ocean: '/images/about/great-ocean-road.jpg',
};

const {
  hotspots = australiaHotspots,
  photos = australiaPhotos,
  descKey = 'hotspots_desc',
} = Astro.props;

const items = hotspots.map((key) => ({
  key,
  src: imageSrc(photos[key] ?? `/images/${key}.jpg`),
  badge: get(`${key}_badge`),
  title: get(`${key}_title`),
  text: get(`${key}_text`),
  story: get(`${key}_story`),
}));

const desc = get(descKey);
---

<section class="bg-[#F4FBFB] px-6 pb-10 pt-20 md:pb-12 md:pt-28">
  <div data-carousel class="mx-auto max-w-6xl">

    <!-- Kop -->
    <div class="grid gap-6 md:grid-cols-2 md:items-end md:gap-12">
      <h2 class="text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">
        {t('hotspots_title_line1')}
      </h2>
      {desc && desc.length > 1 && (
        <p class="text-[15px] leading-relaxed text-gray-600 md:text-base">{desc}</p>
      )}
    </div>

    <!-- Kaarten: mobiel 1, tablet 2, desktop 4 per keer -->
    <div data-carousel-track class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth md:mt-14">
      {items.map((h) => (
        <article class="relative h-[440px] w-full shrink-0 snap-start overflow-hidden rounded-[2rem] bg-[#0B5F64] shadow-[0_20px_45px_rgba(0,0,0,0.12)] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4.5rem)/4)]">
          {h.src ? (
            <img src={h.src} alt={h.title} loading="lazy" draggable="false" class="absolute inset-0 h-full w-full object-cover" />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-[#0F7C82] to-[#084649]"></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>

          <div class="absolute inset-0 flex flex-col items-center justify-end p-6 text-center text-white">
            <p class="text-[11px] uppercase tracking-[0.2em] text-white/90">{h.badge}</p>
            <h3 class="mt-2 text-2xl font-semibold leading-tight tracking-tight">{h.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-white/80">{h.text}</p>
            <!-- Opent het verhaal van deze plek -->
            <button
              type="button"
              data-hotspot-open
              data-title={h.title}
              data-badge={h.badge}
              data-story={h.story}
              data-src={h.src ?? ''}
              class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-5 py-2 text-sm font-semibold transition hover:border-white hover:bg-white hover:text-[#0F7C82]"
            >
              {t('hotspot_btn')}
            </button>
          </div>
        </article>
      ))}
    </div>

    <CarouselControls />
  </div>

  <!-- Verhaal-popup -->
  <dialog id="hotspot-story" class="hotspot-story m-auto w-[min(92vw,34rem)] overflow-hidden rounded-[2rem] bg-white p-0 shadow-2xl">
    <div class="relative">
      <div data-story-media class="aspect-[16/10] w-full bg-gradient-to-br from-[#0F7C82] to-[#084649]">
        <img data-story-image alt="" class="hidden h-full w-full object-cover" />
      </div>
      <button type="button" data-story-close aria-label={lang === 'nl' ? 'Sluiten' : 'Close'} class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-gray-900 shadow transition hover:bg-white">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
    <div class="p-7 md:p-9">
      <p data-story-badge class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]"></p>
      <h3 data-story-title class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-black md:text-3xl"></h3>
      <p data-story-text class="mt-4 text-[15px] leading-relaxed text-gray-600 md:text-base"></p>
    </div>
  </dialog>
</section>

<style>
  .hotspot-story::backdrop {
    background: rgba(8, 70, 73, 0.55);
    backdrop-filter: blur(4px);
  }
  .hotspot-story[open] {
    animation: hotspot-in 0.3s ease both;
  }
  @keyframes hotspot-in {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  const dialog = document.getElementById('hotspot-story') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-story-image]')!;
    const badge = dialog.querySelector<HTMLElement>('[data-story-badge]')!;
    const title = dialog.querySelector<HTMLElement>('[data-story-title]')!;
    const text = dialog.querySelector<HTMLElement>('[data-story-text]')!;

    document.querySelectorAll<HTMLElement>('[data-hotspot-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const { src, badge: b, title: tt, story } = btn.dataset;
        img.classList.toggle('hidden', !src);
        if (src) {
          img.src = src;
          img.alt = tt ?? '';
        }
        badge.textContent = b ?? '';
        title.textContent = tt ?? '';
        text.textContent = story ?? '';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-story-close]')?.addEventListener('click', () => dialog.close());
    // Klik naast de popup sluit hem ook
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
