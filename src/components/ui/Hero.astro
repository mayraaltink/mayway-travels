---
// src/components/ui/Hero.astro
// Homepagina-header: foto over de volle breedte met een donker verloop, tekst links, twee knoppen.
// Foto: /public/images/hero/header-6.jpg (webversie van src/assets/header 6.JPG, staand, 1920px breed).
// De suppers staan in het midden van de foto, dus de uitsnede is gecentreerd.
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;

function t(key: keyof typeof ui[typeof defaultLang]) {
  return ui[lang][key];
}
---

<section class="hero relative -mt-16 flex min-h-[100svh] overflow-hidden md:min-h-[90svh] rounded-b-[60px] bg-[#0F7C82] md:rounded-b-[80px]">

  <!-- Foto -->
  <img
    src="/images/hero/header-6.jpg"
    alt="Luchtfoto van twee suppers op helder turquoise water met een rog eronder, Margaret River"
    class="hero-photo absolute inset-0 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Donkere laag: lichte basis, sterker aan de linkerkant achter de tekst en bovenin voor het menu -->
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/10 to-transparent"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/25 to-transparent"></div>

  <!-- Inhoud -->
  <!-- Op mobiel gecentreerd, vanaf tablet links uitgelijnd -->
  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col justify-center px-6 pb-24 pt-44 text-center md:px-12 md:pt-32 md:text-left">
    <div class="hero-content mx-auto max-w-2xl md:mx-0">
      <!-- handgeschreven accent boven de titel (lijntje alleen bij links uitlijnen) -->
      <p class="font-neucha mb-4 flex items-center justify-center gap-3 text-xl leading-none text-[#8EE3DF] md:justify-start md:text-2xl">
        <span class="hidden h-px w-10 bg-[#8EE3DF] md:block" aria-hidden="true"></span>
        {t('hero.title2')}
      </p>

      <h1 class="hero-shadow text-5xl font-bold leading-[1.02] tracking-tight text-white [text-wrap:balance] md:text-7xl">
        {t('hero.title1')}
      </h1>

      <p class="mx-auto mt-6 max-w-md text-base text-white/85 md:mx-0 md:text-lg">
        {t('hero.subtitle')}
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3 md:justify-start">
        <a
          href="#ontdek"
          class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white bg-white px-8 py-3 text-sm font-semibold text-[#0F7C82] shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#E6F6F6]"
        >
          {t('hero.cta.primary')}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
        </a>
        <a
          href={`/${lang}/destinations`}
          class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-white hover:bg-white/10"
        >
          {t('hero.cta.secondary')}
        </a>
      </div>
    </div>
  </div>

  <!-- Locatie van de foto -->
  <a
    href="https://www.google.com/maps/search/?api=1&query=Margaret+River,+Western+Australia"
    target="_blank"
    rel="noopener noreferrer"
    class="absolute bottom-5 right-5 z-10 flex items-center gap-2 rounded-full bg-black/20 px-3 py-1.5 text-white/90 backdrop-blur-md transition hover:bg-black/35 md:bottom-8 md:right-8 md:px-4 md:py-2"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 md:h-4 md:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    <span class="text-[10px] uppercase tracking-wide md:text-sm">{t('hero.location')}</span>
  </a>

  <!-- doel van "Ontdek meer" -->
  <span id="ontdek" class="absolute bottom-0" aria-hidden="true"></span>
</section>

<style>
  /* foto beweegt als een drone-shot (langzaam stijgen, draaien en zweven), tekst komt omhoog */
  :global(html) {
    scroll-behavior: smooth;
  }
  .hero-shadow {
    text-shadow: 0 2px 18px rgba(4, 40, 42, 0.35);
  }
  .hero-photo {
    transform-origin: 50% 50%;
    will-change: transform;
    animation: hero-drone 40s ease-in-out infinite alternate both;
  }
  .hero-content {
    animation: hero-up 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
  }
  /* schaal blijft minimaal 1.05 zodat de randen bij draaien en verschuiven nooit zichtbaar worden */
  @keyframes hero-drone {
    0%   { transform: scale(1.12) rotate(-1deg) translate(0.5%, 0.5%); }
    50%  { transform: scale(1.08) rotate(0deg) translate(0, -0.25%); }
    100% { transform: scale(1.05) rotate(1deg) translate(-0.5%, -0.5%); }
  }
  @keyframes hero-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo,
    .hero-content { animation: none; }
  }
</style>
