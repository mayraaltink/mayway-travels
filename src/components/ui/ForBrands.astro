---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, defaultLang } from '../../i18n/ui';
import CollaborationSection from './CollaborationSection.astro';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

const email = 'maywaytravels1@gmail.com';

// Ankerlinks onderaan de hero
const sectionLinks = [
  { href: '#services', text: t('forBrands.nav.services') },
  { href: '#creator', text: t('forBrands.nav.creator') },
  { href: '#partners', text: t('forBrands.nav.partners') },
  { href: '#contact', text: t('forBrands.nav.contact') },
];

const services = [1, 2, 3].map((num) => ({
  num: `0${num}`,
  title: t(`forBrands.services.${num}.title`),
  desc: t(`forBrands.services.${num}.desc`),
  tags: t(`forBrands.services.${num}.tags`).split('|'),
}));

const socials = [
  { platform: 'instagram', handle: '@maywaytravels', href: 'https://www.instagram.com/maywaytravels', desc: t('forBrands.socials.maywaytravels') },
  { platform: 'instagram', handle: '@mayraaltink', href: 'https://www.instagram.com/mayraaltink', desc: t('forBrands.socials.mayraaltink') },
  { platform: 'instagram', handle: '@maywaysocials', href: 'https://www.instagram.com/maywaysocials', desc: t('forBrands.socials.maywaysocials') },
  { platform: 'tiktok', handle: '@mayraxaltink', href: 'https://www.tiktok.com/@mayraxaltink', desc: t('forBrands.socials.tiktok') },
];

const stats = [1, 2, 3].map((num) => ({
  value: t(`forBrands.creator.stat${num}.value`),
  label: t(`forBrands.creator.stat${num}.label`),
}));
---

<BaseLayout title={t('forBrands.title')}>
  <div class="bg-[#FFFDFA]">

    <!-- HERO -->
    <section class="relative flex min-h-[640px] h-[100svh] items-center justify-center overflow-hidden rounded-b-[48px] md:rounded-b-[80px]">

      <img
        src="/images/travel-plan/Sydney.jpg"
        alt="Sydney"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 z-10 bg-gradient-to-b from-black/45 via-black/35 to-black/65"></div>

      <div class="relative z-20 mx-auto max-w-4xl px-6 pt-16 text-center text-white">

        <p class="text-xs font-medium uppercase tracking-[0.3em] text-white/80 md:text-sm">
          {t('forBrands.hero.eyebrow')}
        </p>

        <h1 class="mt-5 flex flex-col items-center leading-[0.85]">
          <span class="text-6xl font-bold tracking-[-0.03em] md:text-8xl lg:text-9xl">
            {t('forBrands.hero.title1')}
          </span>
          <span class="font-dancing -mt-1 text-5xl text-[#4ED2CE] md:-mt-3 md:text-7xl lg:text-8xl">
            {t('forBrands.hero.title2')}
          </span>
        </h1>

        <p class="mx-auto mt-8 max-w-2xl text-2xl font-semibold md:text-3xl">
          {t('forBrands.hero.line1')}
        </p>
        <p class="mx-auto mt-3 max-w-xl text-lg leading-snug text-white/85 md:text-xl">
          {t('forBrands.hero.line2')}
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
          <a
            href={`/${lang}/contact`}
            class="inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-8 py-3.5 text-base font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#15939a]"
          >
            {t('forBrands.hero.ctaPrimary')}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a
            href="#services"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-base font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:border-white hover:bg-white/10"
          >
            {t('forBrands.hero.ctaSecondary')}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
          </a>
        </div>
      </div>

      <!-- Ankerlinks (desktop) -->
      <nav class="absolute bottom-8 left-1/2 z-20 hidden -translate-x-1/2 items-center gap-1 rounded-full bg-black/30 p-1.5 backdrop-blur-md md:flex" aria-label="Secties">
        {sectionLinks.map((link) => (
          <a href={link.href} class="rounded-full px-5 py-2 text-sm text-white/90 transition hover:bg-white hover:text-[#1CABB0]">
            {link.text}
          </a>
        ))}
      </nav>

      <!-- Locatie -->
      <div class="absolute bottom-6 left-6 z-20 flex items-center gap-2 rounded-full bg-black/35 px-4 py-2 backdrop-blur-sm md:bottom-9">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span class="text-xs uppercase tracking-wide text-white/90">{t('forBrands.hero.location')}</span>
      </div>
    </section>


    <!-- SERVICES -->
    <section id="services" class="scroll-mt-20 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">

        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[#1CABB0]">{t('forBrands.services.eyebrow')}</p>
          <h2 class="mt-3 text-4xl font-bold tracking-[-0.02em] text-gray-900 md:text-5xl">{t('forBrands.services.title')}</h2>
          <p class="mt-4 text-lg leading-relaxed text-gray-600">{t('forBrands.services.intro')}</p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {services.map((service, i) => (
            <article class="group flex flex-col rounded-[1.75rem] bg-white p-8 shadow-[0_10px_40px_rgba(0,0,0,0.06)] ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(28,171,176,0.15)]">
              <span class="text-5xl font-bold leading-none text-[#4ED2CE]/40 transition group-hover:text-[#4ED2CE]">{service.num}</span>
              <h3 class="mt-6 text-2xl font-bold leading-tight text-gray-900">{service.title}</h3>
              <p class="mt-3 flex-1 text-base leading-relaxed text-gray-600">{service.desc}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {service.tags.map((tag) => (
                  <li class="rounded-full bg-[#E6F6F6] px-3 py-1 text-xs font-semibold text-[#1CABB0]">{tag}</li>
                ))}
              </ul>

              {i === 2 && (
                <a href="#creator" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#1CABB0] transition hover:gap-3">
                  {t('forBrands.services.3.more')}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>


    <!-- CREATOR PARTNERSHIPS -->
    <section id="creator" class="scroll-mt-20 bg-[#F4FBFB] py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16">

        <!-- Verhaal -->
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[#1CABB0]">{t('forBrands.creator.eyebrow')}</p>
          <h2 class="mt-3 text-4xl font-bold leading-[1.05] tracking-[-0.02em] text-gray-900 md:text-5xl">{t('forBrands.creator.title')}</h2>

          <div class="mt-8 space-y-5 text-lg leading-relaxed text-gray-700">
            <p>{t('forBrands.creator.p1')}</p>
            <p>{t('forBrands.creator.p2')}</p>
            <p>{t('forBrands.creator.p3')}</p>
          </div>

          <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-[#1CABB0]/15 pt-8">
            {stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd class="text-3xl font-bold text-[#1CABB0] md:text-4xl">{stat.value}</dd>
                <dd class="mt-1 text-sm leading-snug text-gray-600">{stat.label}</dd>
              </div>
            ))}
          </dl>

          <p class="mt-10 text-base leading-relaxed text-gray-700">
            {t('forBrands.creator.mail1')}{' '}
            <a href={`mailto:${email}?subject=Collaboration%20MAY%20WAY`} class="font-semibold text-[#1CABB0] underline decoration-[#1CABB0]/30 underline-offset-4 transition hover:decoration-[#1CABB0]">{email}</a>.
            {' '}{t('forBrands.creator.mail2')}
          </p>
        </div>

        <!-- Socials -->
        <div class="lg:pt-10">
          <h3 class="font-dancing text-4xl text-[#1CABB0]">{t('forBrands.socials.title')}</h3>

          <ul class="mt-6 space-y-4">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-[0_8px_30px_rgba(0,0,0,0.05)] ring-1 ring-black/5 transition duration-300 hover:-translate-y-0.5 hover:ring-[#4ED2CE]"
                >
                  <span class:list={[
                    'flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl text-white',
                    social.platform === 'instagram'
                      ? 'bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#8134AF]'
                      : 'bg-black'
                  ]}>
                    {social.platform === 'instagram' ? (
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
                    ) : (
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
                    )}
                  </span>

                  <span class="min-w-0 flex-1">
                    <span class="block text-lg font-bold text-gray-900">{social.handle}</span>
                    <span class="block text-sm text-gray-500">
                      {social.platform === 'instagram' ? 'Instagram' : 'TikTok'} · {social.desc}
                    </span>
                  </span>

                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-gray-300 transition group-hover:translate-x-1 group-hover:text-[#1CABB0]" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>


    <!-- EERDERE SAMENWERKINGEN -->
    <div id="partners" class="scroll-mt-20">
      <CollaborationSection showStory={false} />
    </div>


    <!-- AFSLUITENDE CTA -->
    <section id="contact" class="scroll-mt-20 bg-gradient-to-br from-[#1CABB0] via-[#1ba9ae] to-[#15939a] py-20 text-center text-white md:py-24">
      <div class="mx-auto max-w-2xl px-6">
        <span class="inline-block rounded-full bg-white/15 px-4 py-1 text-xs font-semibold uppercase tracking-wider">
          {t('forBrands.cta.badge')}
        </span>
        <h2 class="mt-6 text-4xl font-bold tracking-[-0.02em] md:text-5xl">{t('forBrands.cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-lg text-lg text-white/85">{t('forBrands.cta.text')}</p>

        <div class="mt-10 flex flex-col items-center gap-4">
          <a
            href={`/${lang}/contact`}
            class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 font-semibold text-[#1CABB0] shadow-xl transition-all duration-300 hover:scale-105 hover:bg-[#E6F6F6] hover:text-[#15939a]"
          >
            {t('forBrands.cta.btn')}
          </a>
          <a href={`mailto:${email}?subject=Collaboration%20MAY%20WAY`} class="text-sm text-white/80 underline-offset-4 transition hover:text-white hover:underline">
            {email}
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
