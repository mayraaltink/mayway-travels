---
import DestinationContent from "./DestinationContent.astro";
import DestinationIntro from './DestinationIntro.astro';
import RouteAtlas from './RouteAtlas.astro';
import HotspotCarousel from './HotspotCarousel.astro';
import { newZealandRoutes } from '../../data/routes';
import { ui, defaultLang } from '../../i18n/ui';

// Get current language
const currentPath = Astro.url.pathname;
const lang = (Astro.currentLocale || (currentPath.startsWith('/en') ? 'en' : defaultLang)) as keyof typeof ui;

// Translation helper
function t(key: keyof typeof ui[typeof lang]) {
  return ui[lang][key];
}

const hotspots = [
  'nz_milford',
  'nz_tongariro',
  'nz_hobbiton',
  'nz_rotorua',
  'nz_waitomo',
  'nz_cathedral_cove',
  'nz_abel_tasman',
  'nz_franz_josef',
  'nz_queenstown',
  'nz_tekapo',
];
---

<DestinationContent
  title={t('nz.page.title')}
  description={t('nz.page.desc')}
  capital={t('nz.page.capital')}
  language={t('nz.page.language')}
  currency={t('nz.page.currency')}
  flightTime={t('nz.page.flightTime')}
  imageSrc="/images/new-zealand/nz_main.jpg"
  imageAlt="Beautiful landscape in New Zealand"
  planUrl={lang === 'nl' ? '/nl/route-planner?country=new-zealand' : '/en/route-planner?country=new-zealand'}
  guideUrl={lang === 'nl' ? '/eguides/' : '/en/eguides/'}
>
  <DestinationIntro prefix="nz" />
  <RouteAtlas
    map="/images/new-zealand/new-zealand-shape.svg"
    routes={newZealandRoutes}
    subtitleKey="routes.nz.subtitle"
  />
  <HotspotCarousel hotspots={hotspots} photos={{}} descKey="hotspots_descNZ" />
</DestinationContent>
