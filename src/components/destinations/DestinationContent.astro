---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTAButtons from "../ui/CTAButtons.astro";
import { ui, defaultLang } from '../../i18n/ui';

export interface Props {
  title: string;
  description: string;
  capital: string;
  language: string;
  currency: string;
  flightTime: string;
  imageSrc: string;
  imageAlt: string;
  planUrl: string;
  guideUrl: string;
  // Optioneel: locatie van de foto (label op de foto, alleen mobiel)
  location?: string;
  // Optioneel: knoppen onder de iconen op mobiel, die naar secties verderop springen
  links?: { href: string; label: string }[];
}


const {
  title,
  description,
  capital,
  language,
  currency,
  flightTime,
  imageSrc,
  imageAlt,
  planUrl,
  guideUrl,
  location,
  links = []
} = Astro.props;

// Get current language for generic UI labels
const currentPath = Astro.url.pathname;
const lang = (Astro.currentLocale || (currentPath.startsWith('/en') ? 'en' : defaultLang)) as keyof typeof ui;

function t(key: keyof typeof ui[typeof lang]) {
  return ui[lang][key];
}
---

<BaseLayout title={title}>
<!-- Mobiel: foto bovenaan, loopt door achter de menubalk (op desktop staat de foto naast de tekst) -->
<div class="bg-[#1CABB0] lg:hidden">
  <div class="relative h-[65svh] min-h-[420px] overflow-hidden">
    <img src={imageSrc} alt={imageAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/30 to-transparent"></div>

    {location && (
      <span class="absolute bottom-10 right-10 flex items-center gap-2 rounded-full bg-black/35 px-4 py-2 text-white/90 backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="text-[10px] uppercase tracking-wide md:text-sm">{location}</span>
      </span>
    )}
  </div>
</div>

<div class="bg-[#1CABB0] pt-10 lg:pt-32 pb-24 px-6 font-zain overflow-hidden relative">
    

    <div class="max-w-6xl mx-auto relative z-10">
      
      <!-- Back Button -->
      <!-- If you have a translation for 'Back to Destinations', you can replace the text below with {t('labels.back')} -->
      <a href={`/${lang}/destinations`} class="hidden lg:inline-flex items-center text-[#FFFFFF] hover:text-[#1CABB0] font-bold mb-10 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Destinations
      </a>

      <!-- 2-Column Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- LEFT COLUMN: Text & Icons -->
        <div class="flex flex-col">
          <h1 class="font-libre text-5xl md:text-6xl font-semibold text-white mb-6 leading-tight">
            {title}
          </h1>
          
          <p class="text-lg md:text-s text-white leading-relaxed mb-10">
            {description}
          </p>

          <!-- Quick Facts -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 sm:gap-6 bg-white p-5 md:p-8 rounded-3xl shadow-sm border border-white">
            
            <!-- Capital -->
            <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
              <div class="w-9 h-9 sm:w-12 sm:h-12 bg-[#E8FAF9] text-[#1CABB0] rounded-full flex items-center justify-center mb-2 sm:mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <span class="text-[11px] sm:text-sm font-bold text-gray-400 uppercase tracking-wider mb-0.5 sm:mb-1">{t('labels.capital')}</span>
              <span class="text-gray-900 font-bold text-[15px] leading-tight sm:text-lg">{capital}</span>
            </div>

            <!-- Language -->
            <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
              <div class="w-9 h-9 sm:w-12 sm:h-12 bg-[#E8FAF9] text-[#1CABB0] rounded-full flex items-center justify-center mb-2 sm:mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                </svg>
              </div>
              <span class="text-[11px] sm:text-sm font-bold text-gray-400 uppercase tracking-wider mb-0.5 sm:mb-1">{t('labels.language')}</span>
              <span class="text-gray-900 font-bold text-[15px] leading-tight sm:text-lg">{language}</span>
            </div>

            <!-- Currency -->
            <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
              <div class="w-9 h-9 sm:w-12 sm:h-12 bg-[#E8FAF9] text-[#1CABB0] rounded-full flex items-center justify-center mb-2 sm:mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-[11px] sm:text-sm font-bold text-gray-400 uppercase tracking-wider mb-0.5 sm:mb-1">{t('labels.currency')}</span>
              <span class="text-gray-900 font-bold text-[15px] leading-tight sm:text-lg">{currency}</span>
            </div>

<!-- Flight time -->
<div class="flex flex-col items-center sm:items-start text-center sm:text-left">
  <div class="w-9 h-9 sm:w-12 sm:h-12 bg-[#E8FAF9] text-[#1CABB0] rounded-full flex items-center justify-center mb-2 sm:mb-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 16l8.5-2.5V18l2-1 2 1v-4.5L21.5 16l-1-2.5-7-4V6a1 1 0 10-2 0v3.5l-7 4L2.5 16z" />
    </svg>
  </div>
  <span class="text-[11px] sm:text-sm font-bold text-gray-400 uppercase tracking-wider mb-0.5 sm:mb-1">
    {t('labels.flighttime')}
  </span>
  <span class="text-gray-900 font-bold text-[15px] leading-tight sm:text-lg">
    {flightTime}
  </span>
</div>
          </div>
        </div>

      


        <!-- RIGHT COLUMN: Bubble Card Image -->
        <div class="relative hidden lg:block w-full aspect-[4/5] max-w-[500px] mx-auto lg:ml-auto">
          <!-- Offset decoration blob -->
          <div class="absolute inset-0 bg-[#4ED2CE] rounded-[3rem] translate-x-4 translate-y-4 lg:translate-x-6 lg:translate-y-6 opacity-50"></div>
          
          <!-- Image Wrapper -->
          <div class="absolute inset-0 rounded-[3rem] overflow-hidden shadow-2xl border-[6px] border-white z-10 bg-gray-200">
            <img 
              src={imageSrc} 
              alt={imageAlt} 
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobiel: knoppen naar de secties verderop, onder het turquoise blok -->
  {links.length > 0 && (
    <div class="flex flex-wrap justify-center gap-3 bg-[#FFFDFA] px-6 pt-10 font-zain lg:hidden">
      {links.map((l) => (
        <a href={l.href} class="rounded-full bg-[#4ED2CE] px-6 py-3 text-base font-semibold text-white shadow-md transition hover:bg-[#1CABB0]">
          {l.label}
        </a>
      ))}
    </div>
  )}

  <!-- This slot allows us to inject the correct Carousel at the bottom of the page -->
  <slot />


</BaseLayout>