---
import { ui, defaultLang } from '../../i18n/ui';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

// Foto's in de swipe (hier toevoegen of vervangen, staande foto's werken het mooist)
const photos = [
  { src: '/images/about/Mayra-foto.jpg', alt: 'Mayra' },
  { src: '/images/about/reis-specialist.jpg', alt: 'Mayra' },
  { src: '/images/about/sydney-opera.jpg', alt: 'Sydney' },
  { src: '/images/about/great-ocean-road.jpg', alt: 'Great Ocean Road' },
];
---

<section class="bg-gradient-to-b from-[#F3FBFB] to-[#FFFDFA] py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">

    <!-- Foto-swipe -->
    <div class="about-swipe mx-auto w-full min-w-0 max-w-md lg:max-w-[30rem]">
      <div class="relative">
        <div class="about-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-[2rem] shadow-[0_25px_60px_rgba(0,0,0,0.15)]">
          {photos.map((photo, i) => (
            <img
              src={photo.src}
              alt={photo.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              draggable="false"
              class="aspect-[4/5] w-full shrink-0 snap-center object-cover"
            />
          ))}
        </div>

        <!-- Pijltjes (desktop) -->
        <div class="absolute bottom-4 right-4 hidden gap-2 md:flex">
          <button type="button" class="about-prev flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-gray-900 shadow-md backdrop-blur-sm transition hover:bg-white disabled:opacity-40" aria-label="Vorige foto">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="about-next flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-gray-900 shadow-md backdrop-blur-sm transition hover:bg-white disabled:opacity-40" aria-label="Volgende foto">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- Bolletjes -->
      <div class="mt-5 flex justify-center gap-2">
        {photos.map((_, i) => (
          <button type="button" class="about-dot h-2 w-2 rounded-full bg-gray-300 transition-all duration-300" data-index={i} aria-label={`Foto ${i + 1}`}></button>
        ))}
      </div>
    </div>

    <!-- Tekst -->
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('home.about.preheader')}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">
        {t('home.about.title')}
      </h2>

      <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-gray-600 md:text-base">
        <p>{t('home.about.p1')}</p>
        <p>{t('home.about.p2')}</p>
      </div>

      <a
        href={`/${lang}/about`}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]"
      >
        {t('home.about.cta')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

<script>
  function initAboutSwipe() {
    const root = document.querySelector<HTMLElement>('.about-swipe');
    if (!root) return;

    const track = root.querySelector<HTMLElement>('.about-track');
    const prev = root.querySelector<HTMLButtonElement>('.about-prev');
    const next = root.querySelector<HTMLButtonElement>('.about-next');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.about-dot'));
    if (!track) return;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });

    const update = () => {
      const i = current();
      dots.forEach((dot, d) => {
        dot.classList.toggle('bg-[#1CABB0]', d === i);
        dot.classList.toggle('w-6', d === i);
        dot.classList.toggle('bg-gray-300', d !== i);
      });
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= dots.length - 1;
    };

    prev?.addEventListener('click', () => goTo(current() - 1));
    next?.addEventListener('click', () => goTo(current() + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    track.addEventListener('scroll', update, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutSwipe);
  } else {
    initAboutSwipe();
  }
</script>

<style>
  .about-track {
    scrollbar-width: none;
  }
  .about-track::-webkit-scrollbar {
    display: none;
  }
</style>
