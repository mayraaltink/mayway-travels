const cardPhotos: Record<string, string | null> = { coffee: photos.coffee, barefoot: photos.barefoot, bbq: photos.bbq };
---

<!-- Turquoise placeholder als een foto (nog) ontbreekt -->
<article class="bg-[#FFFDFA] px-6 pb-24 pt-32 md:pb-32 md:pt-40">
  <div class="mx-auto max-w-5xl">

    <!-- Intro: titel "Het leven in Australië" links, verhaal ("het is de vibe") rechts -->
    <section class="grid gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14">
      <!-- "in Australië" op een eigen regel -->
      <h1 class="text-5xl font-normal leading-[1.0] tracking-tight text-black md:text-6xl [&_strong]:block [&_strong]:font-bold">
        <Fragment set:html={content.vibeTitle} />
      </h1>
      <div class="space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base">
        {content.vibe.map((p) => <p set:html={rich(p)} />)}
      </div>
    </section>

    <!-- Ga snel naar: zelfde knoppen als in de andere blogs -->
    <nav aria-label={content.tocTitle} class="mt-12 md:mt-16">
      <p class="text-xs uppercase tracking-[0.2em] text-gray-500">{content.tocTitle}</p>
      <ol class="mt-4 flex flex-wrap gap-2">
        {content.toc.map((item) => (
          <li>
            <a href={`#${item.id}`} class="inline-flex whitespace-nowrap rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-semibold text-gray-800 transition hover:border-[#1CABB0] hover:bg-[#1CABB0] hover:text-white">{item.label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <figure class="relative mt-10 overflow-hidden rounded-[2rem] md:mt-16 md:rounded-[2.5rem]">
      {photos.bondi ? (
        <img src={photos.bondi} alt={content.bondiCaption} class="aspect-[16/9] w-full object-cover md:aspect-[21/9]" />
      ) : (
        <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#4ED2CE] to-[#0F7C82] md:aspect-[21/9]"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></div>
      <figcaption class="absolute bottom-5 left-6 text-sm font-semibold text-white md:bottom-7 md:left-8">{content.bondiCaption}</figcaption>
    </figure>

    <!-- Laid-back mentaliteit -->
    <section id="laid-back" class="mx-auto mt-20 max-w-3xl scroll-mt-28 md:mt-28">
      <!-- "Laid-back" dikgedrukt, "mentaliteit" normaal; zelfde grootte als de hoofdtitels in de andere blogs -->
      <h2 class="text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl [&_strong]:font-bold" set:html={content.laidbackTitle} />
      <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base">
        {content.laidback.map((p) => <p set:html={rich(p)} />)}
      </div>

      <!-- Onderdelen met tussenkopje; cijfertegels, Aussie-woordjes en een afsluitend petrol blok -->
      {content.laidbackParts.map((part) => (
        part.highlight ? (
          <div class="mt-14 rounded-[2rem] bg-[#0F7C82] p-7 text-white md:p-10 [&_strong]:text-white">
            <h3 class="text-2xl font-semibold tracking-tight md:text-[1.75rem]">{part.title}</h3>
            <div class="mt-4 space-y-4 text-[15px] leading-relaxed text-white/90 md:text-base">
              {part.text.map((p) => <p set:html={rich(p)} />)}
            </div>
          </div>
        ) : (
          <div class="mt-12 md:mt-14">
            <h3 class="text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{part.title}</h3>
            <div class="mt-4 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base">
              {part.text.map((p) => <p set:html={rich(p)} />)}
            </div>

            {'stats' in part && part.stats && (
              <div class="mt-6 grid gap-3 sm:grid-cols-3">
                {part.stats.map((s) => (
                  <div class="rounded-[1.5rem] bg-[#E6F6F6] p-5">
                    <p class="text-2xl font-bold leading-tight tracking-tight text-[#0F7C82]">{s.value}</p>
                    <p class="mt-2 text-sm leading-snug text-gray-700">{s.label}</p>
                  </div>
                ))}
              </div>
            )}

            {'slang' in part && part.slang && (
              <div class="mt-6 flex flex-wrap gap-2">
                {part.slang.map(([word, meaning]) => (
                  <span class="inline-flex items-center gap-2 rounded-full bg-[#E6F6F6] px-4 py-2 text-[15px]">
                    <b class="font-semibold text-[#0F7C82]">{word}</b>
                    <span class="text-gray-400" aria-hidden="true">=</span>
                    <span class="text-gray-700">{meaning}</span>
                  </span>
                ))}
              </div>
            )}

            {'after' in part && part.after && (
              <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base">
                {part.after.map((p) => <p set:html={rich(p)} />)}
              </div>
            )}
          </div>
        )
      ))}
    </section>

    <!-- Typisch Aussie: overkoepelende titel boven de twee kaarten (Koffie & café cultuur, Blote voeten) -->
    <section id="typisch-aussie" class="mt-20 scroll-mt-28 md:mt-28">
      <h2 class="text-center text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl [&_strong]:font-bold" set:html={content.cardsTitle} />
      <!-- drie kaarten naast elkaar op desktop, twee op tablet; op desktop breder dan de tekstkolom -->
      <div class="mt-10 grid gap-6 md:grid-cols-2 md:items-start lg:-mx-16 lg:grid-cols-3 xl:-mx-32">

      {content.cards.map((card) => (
        <div class="rounded-[2rem] bg-white p-4 shadow-[0_20px_50px_rgba(0,0,0,0.07)] ring-1 ring-black/5 md:p-5">
          <div class="relative overflow-hidden rounded-[1.5rem]">
            {cardPhotos[card.key] ? (
              <img src={cardPhotos[card.key]!} alt={card.title} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            ) : (
              <div class="aspect-[4/3] w-full bg-gradient-to-br from-[#4ED2CE] to-[#0F7C82]"></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
            <!-- zelfde grootte als de tussenkopjes bij Laid-back mentaliteit -->
            <h3 class="absolute bottom-4 left-5 text-2xl font-semibold tracking-tight text-white md:text-[1.75rem]">{card.title}</h3>
          </div>
          <div class="space-y-4 px-2 pb-3 pt-6 text-[15px] leading-relaxed text-gray-700 md:text-base">
            {card.text.map((p) => <p set:html={rich(p)} />)}
          </div>
        </div>
      ))}
      </div>
    </section>

    <!-- Actieve lifestyle -->
    <!-- Eén kolom in delen: intro + foto, buitenleven + cijfers + foto, steden-kaartjes + parkrun-blok,
         zwemmen + races + Nippers-blok met foto, pilates in een kaart -->
    <section id="actief" class="mx-auto mt-20 max-w-3xl scroll-mt-28 text-[15px] leading-relaxed text-gray-700 md:mt-28 md:text-base">
      <h2 class="text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl [&_strong]:font-bold" set:html={content.activeTitle} />
      <div class="mt-6 space-y-5">
        {content.active.intro.map((p) => <p set:html={rich(p)} />)}
      </div>

      <!-- Foto: Run Club -->
      <figure class="mt-10 lg:-mx-16">
        <div class="overflow-hidden rounded-[2rem]">
          {photos.runclub ? (
            <img src={photos.runclub} alt={content.active.captions.runclub} loading="lazy" class="aspect-[16/9] w-full object-cover" />
          ) : (
            <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#4ED2CE] to-[#0F7C82]"></div>
          )}
        </div>
        <figcaption class="mt-3 text-sm font-semibold text-gray-900">{content.active.captions.runclub}</figcaption>
      </figure>

      <!-- Het buitenleven ís het leven -->
      <h3 class="mt-14 text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{content.active.outdoors.title}</h3>
      <div class="mt-4 space-y-5">
        {content.active.outdoors.text.map((p) => <p set:html={rich(p)} />)}
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3">
        {content.active.outdoors.stats.map((s) => (
          <div class="rounded-[1.5rem] bg-[#E6F6F6] p-5 md:p-6">
            <p class="text-4xl font-bold leading-none tracking-tight text-[#0F7C82] md:text-5xl">{s.value}</p>
            <p class="mt-2 text-sm leading-snug text-gray-700">{s.label}</p>
          </div>
        ))}
      </div>

      <!-- Foto: Bronte Pools -->
      <figure class="mt-10 lg:-mx-16">
        <div class="overflow-hidden rounded-[2rem]">
          {photos.bronte ? (
            <img src={photos.bronte} alt={content.active.captions.bronte} loading="lazy" class="aspect-[16/9] w-full object-cover" />
          ) : (
            <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#4ED2CE] to-[#0F7C82]"></div>
          )}
        </div>
        <figcaption class="mt-3 text-sm font-semibold text-gray-900">{content.active.captions.bronte}</figcaption>
      </figure>

      <!-- En de rest van Australië? Rustige lijst: stad dikgedrukt, tekst erachter, dunne lijntjes ertussen -->
      <h3 class="mt-14 text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{content.active.country.title}</h3>
      <p class="mt-4" set:html={rich(content.active.country.intro)} />
      <ul class="mt-4 divide-y divide-gray-200 border-y border-gray-200">
        {content.active.country.cities.map((c) => (
          <li class="py-4">
            <span class="font-semibold text-gray-900">{c.name}</span>
            <span class="text-[#1CABB0]"> · </span>
            <span set:html={rich(c.text)} />
          </li>
        ))}
      </ul>
      <p class="mt-6" set:html={rich(content.active.country.parkrun.text)} />

      <!-- Zwemmen, surfen en alles daartussen -->
      <h3 class="mt-14 text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{content.active.swim.title}</h3>
      <p class="mt-4" set:html={rich(content.active.swim.text)} />
      <ul class="mt-3 list-disc space-y-1.5 pl-5 marker:text-[#1CABB0]">
        {content.active.swim.races.map(([name, place]) => (
          <li><span class="font-semibold text-gray-900">{name}</span> ({place})</li>
        ))}
      </ul>
      <p class="mt-5" set:html={rich(content.active.swim.nippers.text)} />

      <!-- Foto: Nippers -->
      <figure class="mt-10 lg:-mx-16">
        <div class="overflow-hidden rounded-[2rem]">
          {photos.nippers ? (
            <img src={photos.nippers} alt={content.active.captions.nippers} loading="lazy" class="aspect-[16/9] w-full object-cover" />
          ) : (
            <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#4ED2CE] to-[#0F7C82]"></div>
          )}
        </div>
        <figcaption class="mt-3 text-sm font-semibold text-gray-900">{content.active.captions.nippers}</figcaption>
      </figure>

      <p class="mt-10" set:html={rich(content.active.swim.after)} />

      <!-- Pilates -->
      <h3 class="mt-14 text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{content.active.pilates.title}</h3>
      <p class="mt-4" set:html={rich(content.active.pilates.text)} />
    </section>

  </div>
</article>
