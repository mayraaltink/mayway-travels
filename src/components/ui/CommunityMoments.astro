---
// src/components/ui/CommunityMoments.astro
// "Jullie momenten": goedgekeurde inzendingen van volgers + formulier om zelf een moment te delen.
// Werkt via de Cloudflare Pages Functions in functions/api/ (zie db/schema.sql).
// Lokaal met `astro dev` draaien die functions niet; dan toont het blok de lege staat.
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

// Teksten die het script nodig heeft
const messages = {
  sending: t('cmoments.form.sending'),
  error: t('cmoments.form.error'),
  size: t('cmoments.form.errorSize'),
};
---

<section id="community-moments" class="scroll-mt-20 bg-[#F4FBFB] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Kop -->
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">{t('cmoments.title')}</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">{t('cmoments.intro')}</p>
      </div>
      <button
        type="button"
        data-open-share
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a] md:self-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        {t('cmoments.cta')}
      </button>
    </div>

    <!-- Momenten (worden geladen) -->
    <div id="cmoments-grid" class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4"></div>

    <!-- Lege staat -->
    <div id="cmoments-empty" class="mt-12 rounded-[1.75rem] border-2 border-dashed border-[#1CABB0]/25 px-6 py-14 text-center" hidden>
      <p class="text-lg font-semibold text-gray-900">{t('cmoments.empty.title')}</p>
      <p class="mt-2 text-[15px] text-gray-600">{t('cmoments.empty.text')}</p>
      <button type="button" data-open-share class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]">
        {t('cmoments.cta')}
      </button>
    </div>
  </div>

  <!-- Formulier (pop-up) -->
  <dialog id="share-dialog" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-[1.75rem] p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
    <form id="share-form" class="relative p-6 md:p-8" novalidate>
      <button type="button" data-close-share class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>

      <div data-form-fields>
        <h3 class="pr-10 text-2xl font-semibold tracking-tight text-black">{t('cmoments.form.title')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">{t('cmoments.form.intro')}</p>

        <!-- Foto -->
        <label class="mt-6 flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-[#1CABB0]/30 bg-[#F4FBFB] text-center transition hover:border-[#1CABB0]">
          <img id="share-preview" alt="" class="hidden aspect-[4/3] w-full object-cover" />
          <span id="share-photo-label" class="flex flex-col items-center gap-2 px-4 py-8 text-sm text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
            <span class="font-semibold text-gray-900">{t('cmoments.form.photo')}</span>
            <span class="text-xs">{t('cmoments.form.photoHint')}</span>
          </span>
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required class="sr-only" />
        </label>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <input name="name" required maxlength="60" placeholder={t('cmoments.form.name')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
          <input name="location" required maxlength="80" placeholder={t('cmoments.form.location')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
        </div>
        <textarea name="story" required maxlength="600" rows="4" placeholder={t('cmoments.form.story')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]"></textarea>
        <input name="instagram" maxlength="40" placeholder={t('cmoments.form.instagram')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />

        <!-- Spam-val: onzichtbaar voor mensen -->
        <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <label class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-gray-600">
          <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#1CABB0]" />
          {t('cmoments.form.consent')}
        </label>

        <p id="share-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></p>

        <button type="submit" class="mt-6 w-full rounded-full bg-[#1CABB0] px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-[#15939a] disabled:opacity-60">
          {t('cmoments.form.submit')}
        </button>
      </div>

      <!-- Bedankt -->
      <div data-form-thanks class="hidden py-6 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0]">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
        </div>
        <h3 class="mt-5 text-2xl font-semibold tracking-tight text-black">{t('cmoments.thanks.title')}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-600">{t('cmoments.thanks.text')}</p>
        <button type="button" data-close-share class="mt-6 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]">
          {t('cmoments.form.close')}
        </button>
      </div>
    </form>
  </dialog>
</section>

<script define:vars={{ messages }}>
  const grid = document.getElementById('cmoments-grid');
  const empty = document.getElementById('cmoments-empty');
  const dialog = document.getElementById('share-dialog');
  const form = document.getElementById('share-form');
  const errorBox = document.getElementById('share-error');
  const preview = document.getElementById('share-preview');
  const photoLabel = document.getElementById('share-photo-label');
  const fields = form.querySelector('[data-form-fields]');
  const thanks = form.querySelector('[data-form-thanks]');
  const submit = form.querySelector('button[type="submit"]');
  const submitText = submit.textContent;

  const escape = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Goedgekeurde momenten laden
  fetch('/api/moments')
    .then((r) => (r.ok ? r.json() : []))
    .catch(() => [])
    .then((items) => {
      if (!Array.isArray(items) || items.length === 0) {
        empty.hidden = false;
        return;
      }
      grid.innerHTML = items.map((m) => `
        <article class="break-inside-avoid overflow-hidden rounded-[1.5rem] bg-white shadow-[0_10px_30px_rgba(0,0,0,0.06)]">
          <img src="${escape(m.photo)}" alt="${escape(m.location)}" loading="lazy" class="w-full object-cover" />
          <div class="p-5">
            <p class="text-xs uppercase tracking-[0.15em] text-[#1CABB0]">${escape(m.location)}</p>
            <p class="mt-2 text-[15px] leading-relaxed text-gray-700">${escape(m.story)}</p>
            <p class="mt-3 text-sm font-semibold text-gray-900">${escape(m.name)}${m.instagram ? ` <a href="https://www.instagram.com/${encodeURIComponent(m.instagram)}/" target="_blank" rel="noopener noreferrer" class="font-normal text-[#1CABB0] hover:underline">@${escape(m.instagram)}</a>` : ''}</p>
          </div>
        </article>`).join('');
    });

  // Pop-up openen en sluiten
  document.querySelectorAll('[data-open-share]').forEach((btn) => btn.addEventListener('click', () => dialog.showModal()));
  form.querySelectorAll('[data-close-share]').forEach((btn) => btn.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    if (!thanks.classList.contains('hidden')) {
      form.reset();
      preview.classList.add('hidden');
      photoLabel.classList.remove('hidden');
      fields.classList.remove('hidden');
      thanks.classList.add('hidden');
    }
  });

  // Fotovoorbeeld
  form.photo.addEventListener('change', () => {
    const file = form.photo.files[0];
    if (!file) return;
    preview.src = URL.createObjectURL(file);
    preview.classList.remove('hidden');
    photoLabel.classList.add('hidden');
  });

  // Versturen
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (form.photo.files[0].size > 5 * 1024 * 1024) {
      errorBox.textContent = messages.size;
      errorBox.classList.remove('hidden');
      return;
    }

    submit.disabled = true;
    submit.textContent = messages.sending;
    try {
      const res = await fetch('/api/moments', { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error();
      fields.classList.add('hidden');
      thanks.classList.remove('hidden');
    } catch {
      errorBox.textContent = messages.error;
      errorBox.classList.remove('hidden');
    } finally {
      submit.disabled = false;
      submit.textContent = submitText;
    }
  });
</script>
