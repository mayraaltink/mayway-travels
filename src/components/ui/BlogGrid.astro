---
// src/components/ui/BlogGrid.astro
// Blogs op de Australië-pagina.
// Mobiel: per categorie een swipe met grote fotokaarten. Desktop: alle blogs door elkaar in een mozaïek.
import CarouselControls from './CarouselControls.astro';

const { lang = "en" } = Astro.props;
const nl = lang === "nl";

// Categorieën in deze volgorde op mobiel
const categories = [
  { id: "working-holiday", name: "Working Holiday" },
  { id: "over", name: nl ? "Over Australië" : "About Australia" },
  { id: "reizen", name: nl ? "Reizen naar Australië" : "Travelling to Australia" },
];

// Volgorde hier = volgorde in het mozaïek op desktop (de eerste kaart is de grote)
// position (optioneel): welk deel van de foto in beeld blijft, bijv. "center 60%"
// zoom (optioneel): inzoomen, bijv. "transform: scale(1.15); transform-origin: 50% 100%"
const blogs = [
  {
    title: nl ? "Aanvraag: Eerste Working Holiday in Australië" : "Application: First Working Holiday in Australia",
    image: "/images/australia/voorbereiding.jpg",
    // uitsnede iets lager in de foto, zodat de meeuw in het midden van de kaart vliegt
    position: "center 60%",
    slug: "VisaAus",
    category: "working-holiday",
  },
  {
    title: nl ? "Voorbereidingen Working Holiday" : "Preparing for your Working Holiday",
    image: "/images/australia/workingholiday.jpg",
    slug: "voorbereidingen",
    category: "working-holiday",
  },
  {
    title: nl ? "Het leven in Australië" : "Life in Australia",
    image: "/images/australia/laidback.jpg",
    slug: "travel-budget",
    category: "over",
  },
  {
    title: nl ? "Welk seizoen is het beste om te reizen?" : "Which season is best to travel?",
    image: "/images/australia/seizoen.jpg",
    // iets ingezoomd vanaf de onderkant, zodat de strook lucht bovenin wegvalt
    zoom: "transform: scale(1.15); transform-origin: 50% 100%",
    slug: "beste-reisseizoen",
    category: "reizen",
  },
].map((b) => ({
  ...b,
  // uitsnede en inzoom samen als style op de foto
  imgStyle: [
    'position' in b && b.position ? `object-position: ${b.position}` : '',
    'zoom' in b && b.zoom ? b.zoom : '',
  ].filter(Boolean).join('; ') || undefined,
  href: `/${lang}/blogs/${b.slug}`,
  categoryName: categories.find((c) => c.id === b.category)?.name ?? "",
}));
---

<section class="bg-white pt-16 pb-8 md:pt-28 md:pb-10">
<div class="max-w-6xl mx-auto px-4 md:px-6">

  <!-- Intro -->
  <div class="max-w-3xl mx-auto mb-10 md:mb-12 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">Blogs</p>
    <h2 class="mt-3 text-4xl md:text-5xl font-normal tracking-tight text-black">
      {nl ? "Reistips" : "Travel tips"} <b class="font-semibold">{nl ? "voor Australië" : "for Australia"}</b>
    </h2>
  </div>

  <!-- Mobiel: categorieën onder elkaar, per categorie swipen -->
  <div class="flex flex-col gap-4 md:hidden">
    {categories.map((cat) => (
      <div data-carousel>
        <div data-carousel-track class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth">
          {blogs.filter((b) => b.category === cat.id).map((blog) => (
            <a href={blog.href} class="relative aspect-[4/5] w-full shrink-0 snap-start overflow-hidden rounded-[2rem] bg-[#0B5F64] shadow-lg">
              <img src={blog.image} alt={blog.title} loading="lazy" draggable="false" style={blog.imgStyle} class="absolute inset-0 h-full w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
              <h4 class="absolute inset-x-0 bottom-0 p-6 text-2xl font-bold leading-tight text-white">{blog.title}</h4>
            </a>
          ))}
        </div>
        <CarouselControls class="!mt-3" />
      </div>
    ))}
  </div>

  <!-- Desktop: één blok. Links de eerste blog groot (2 rijen hoog),
       rechts de tweede breed bovenin en de derde en vierde eronder naast elkaar -->
  <div class="hidden md:grid grid-cols-4 auto-rows-[15rem] lg:auto-rows-[18rem] gap-3 lg:gap-4">
    {blogs.map((blog, i) => (
      <a href={blog.href} class:list={["group relative overflow-hidden rounded-2xl bg-[#0B5F64]", { "col-span-2 row-span-2": i === 0, "col-span-2": i === 1 }]}>
        <img src={blog.image} alt={blog.title} loading="lazy" style={blog.imgStyle} class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-5 lg:p-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-white/85">{blog.categoryName}</p>
          <h3 class:list={["mt-1 font-bold leading-snug text-white", i === 0 ? "text-2xl lg:text-3xl" : "text-lg lg:text-xl"]}>{blog.title}</h3>
        </div>
      </a>
    ))}
  </div>

</div>
</section>
