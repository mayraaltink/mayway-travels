---
// src/components/destinations/HotspotCarousel.astro
// "Ontdek Hotspots": swipebare kaarten met de bijzonderste ervaringen van Australië.
// Foto's: /public/images/<naam>.jpg (bijv. whitsundays.jpg). Ontbreekt een foto, dan toont de kaart een turquoise vlak.
import fs from 'node:fs';
import path from 'node:path';
import { useTranslations } from '../../i18n/ui';
import CarouselControls from '../ui/CarouselControls.astro';

export interface Props {
  /** sleutels in ui.ts: `${key}_badge`, `_title`, `_text`, `_story` */
  hotspots?: string[];
  /** foto per hotspot; zonder foto wordt /images/<key>.jpg gezocht */
  photos?: Record<string, string>;
  descKey?: string;
}

const lang = (Astro.currentLocale ?? 'nl') as 'nl' | 'en';
const t = useTranslations(lang);
const get = (k: string) => t(k as any) as string;

// %20 in de link (spatie in de mapnaam) eerst terugvertalen voor de controle op schijf
function imageSrc(src: string) {
  return fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(src))) ? src : null;
}

// Volgorde zoals ze op de site staan (teksten in ui.ts)
const australiaHotspots = [
  'cape_tribulation',
  'reef',
  'fraser',
  'hunter_valley',
  'atherton',
  'great_ocean',
  'whitsundays',
  'julian_rocks',
  'blue_mountains',
];

// Foto's die al op de site staan; de rest zoekt naar /images/<naam>.jpg
// (map "hotspots aus" heeft een spatie in de naam, daarom %20 in de link)
const ha = (file: string) => `/images/hotspots%20aus/${file}`;
const australiaPhotos: Record<string, string> = {
  reef: ha('greatbarrier.jpg'),
  whitsundays: ha('whitsundays.jpg'),
  fraser: ha('fraser.jpg'),
  atherton: ha('altheron.jpg'),
  cape_tribulation: ha('cape.jpg'),
  great_ocean: ha('great.jpg'),
  blue_mountains: ha('bluemountain.jpg'),
  hunter_valley: ha('hunter.jpg'),
  julian_rocks: ha('rocks.jpg'),
};

const {
  hotspots = australiaHotspots,
  photos = australiaPhotos,
  descKey = 'hotspots_desc',
} = Astro.props;

const items = hotspots.map((key) => ({
  key,
  src: imageSrc(photos[key] ?? `/images/${key}.jpg`),
  badge: get(`${key}_badge`),
  title: get(`${key}_title`),
  text: get(`${key}_text`),
  story: get(`${key}_story`),
}));

const desc = get(descKey);
---

<section class="bg-[#F4FBFB] px-6 pb-10 pt-20 md:pb-12 md:pt-28">
  <div data-carousel class="mx-auto max-w-6xl">

    <!-- Kop -->
    <!-- Gecentreerd; zelfde grootte als "Avontuur in Down Under" -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl">
        {lang === 'nl' ? 'Ontdek' : 'Discover'} <b class="font-semibold">Hotspots</b>
      </h2>
      {desc && desc.length > 1 && (
        <p class="mt-6 text-[15px] leading-relaxed text-gray-600 md:text-base">{desc}</p>
      )}
    </div>

    <!-- Kaarten: mobiel 1, tablet 2, desktop 3 per keer -->
    <div data-carousel-track class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth md:mt-14">
      {items.map((h) => (
        <article class="relative cursor-pointer h-[500px] sm:h-[440px] w-full shrink-0 snap-start overflow-hidden rounded-[2rem] bg-[#0B5F64] shadow-[0_20px_45px_rgba(0,0,0,0.12)] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
          {h.src ? (
            <img src={h.src} alt={h.title} loading="lazy" draggable="false" class="absolute inset-0 h-full w-full object-cover" />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-[#0F7C82] to-[#084649]"></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>

          <div class="absolute inset-0 flex flex-col items-center justify-end p-6 text-center text-white">
            <p class="text-[11px] uppercase tracking-[0.2em] text-white/90">{h.badge}</p>
            <h3 class="mt-2 text-2xl font-semibold leading-tight tracking-tight">{h.title}</h3>
            <!-- Altijd 2 regels hoog, zodat titels op elke kaart op dezelfde hoogte staan -->
            <p class="mt-2 line-clamp-2 min-h-[2.5rem] text-sm text-white/80">{h.text}</p>
            <!-- Opent het verhaal van deze plek -->
            <button
              type="button"
              data-hotspot-open
              data-title={h.title}
              data-badge={h.badge}
              data-story={h.story}
              data-src={h.src ?? ''}
              class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-5 py-2 text-sm font-semibold transition hover:border-white hover:bg-white hover:text-[#0F7C82]"
            >
              {t('hotspot_btn')}
            </button>
          </div>
        </article>
      ))}
    </div>

    <CarouselControls />
  </div>

  <!-- Verhaal-popup: zelfde opbouw als de MAY WAY Moments-popup (die werkt goed op de iPhone).
       De dialog zelf blijft een gewoon blok; de binnenste laag regelt de indeling en de maximale hoogte.
       Mobiel: kaartje met foto boven (±45% van het scherm), titel en tekst eronder die scrollt.
       Desktop: foto links, tekst rechts. -->
  <dialog id="hotspot-story" class="hotspot-story m-auto w-[calc(100%-2rem)] max-w-4xl overflow-hidden rounded-[1.75rem] p-0 md:w-[min(92vw,56rem)] md:rounded-[2rem]">
    <div class="relative flex max-h-[90dvh] flex-col md:max-h-[90svh] md:flex-row">
    <div data-story-media class="relative h-[45dvh] w-full shrink-0 bg-gradient-to-br from-[#0F7C82] to-[#084649] md:h-auto md:min-h-[32rem] md:w-[52%]">
      <img data-story-image alt="" class="hidden h-full w-full object-cover" />
      <!-- subtiele pijltjes: vorige / volgende hotspot (zelfde als bij MAY WAY Moments) -->
      <button type="button" data-story-prev aria-label={lang === 'nl' ? 'Vorige hotspot' : 'Previous hotspot'} class="absolute left-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/25 text-white/90 backdrop-blur-sm transition hover:bg-black/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button type="button" data-story-next aria-label={lang === 'nl' ? 'Volgende hotspot' : 'Next hotspot'} class="absolute right-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/25 text-white/90 backdrop-blur-sm transition hover:bg-black/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>
    <!-- mobiel: zelfde opmaak als de MAY WAY Moments-popup (tekst begint bovenaan en scrollt) -->
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain p-6 md:p-9">
      <!-- desktop: kort verhaal in het midden, lang verhaal begint bovenaan en scrollt -->
      <div class="md:my-auto">
        <p data-story-badge class="pr-10 text-xs uppercase tracking-[0.15em] text-[#1CABB0] md:tracking-[0.2em]"></p>
        <h3 data-story-title class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-black md:text-3xl"></h3>
        <!-- whitespace-pre-line: een witregel (\n\n) in de tekst wordt een nieuwe alinea -->
        <p data-story-text class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-gray-600 md:mt-4 md:text-base"></p>
      </div>
    </div>
    <!-- kruisje rechtsboven (mobiel op de foto, desktop boven de tekst); scrollt niet mee -->
    <button type="button" data-story-close aria-label={lang === 'nl' ? 'Sluiten' : 'Close'} class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200 md:h-10 md:w-10 md:text-gray-900">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
    </div>
  </dialog>
</section>

<style>
  .hotspot-story::backdrop {
    background: rgba(8, 70, 73, 0.55);
    backdrop-filter: blur(4px);
  }
  /* mobiel: zelfde donkere achtergrond als de MAY WAY Moments-popup */
  @media (max-width: 767px) {
    .hotspot-story::backdrop { background: rgba(0, 0, 0, 0.7); }
  }
  .hotspot-story[open] {
    animation: hotspot-in 0.3s ease both;
  }
  @keyframes hotspot-in {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  const dialog = document.getElementById('hotspot-story') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-story-image]')!;
    const badge = dialog.querySelector<HTMLElement>('[data-story-badge]')!;
    const title = dialog.querySelector<HTMLElement>('[data-story-title]')!;
    const text = dialog.querySelector<HTMLElement>('[data-story-text]')!;

    const spots = Array.from(document.querySelectorAll<HTMLElement>('[data-hotspot-open]'));
    let current = 0;

    function show(i: number) {
      // rondlopen: na de laatste hotspot weer de eerste
      current = (i + spots.length) % spots.length;
      const { src, badge: b, title: tt, story } = spots[current].dataset;
      img.classList.toggle('hidden', !src);
      if (src) {
        img.src = src;
        img.alt = tt ?? '';
      }
      // nieuwe plek: tekst weer bovenaan beginnen
      text.closest<HTMLElement>('.overflow-y-auto')!.scrollTop = 0;
      badge.textContent = b ?? '';
      title.textContent = tt ?? '';
      text.textContent = story ?? '';
    }

    // de hele kaart (foto én knop) opent het verhaal; de klik op de knop komt hier ook binnen
    spots.forEach((btn, i) => {
      btn.closest('article')!.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-story-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-story-next]')?.addEventListener('click', () => show(current + 1));

    dialog.querySelector('[data-story-close]')?.addEventListener('click', () => dialog.close());
    // Klik naast de popup sluit hem ook
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
