---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, defaultLang } from '../../i18n/ui';
import CollaborationSection from './CollaborationSection.astro';
import Portfolio from './Portfolio.astro';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}


// id="service-1" t/m 3: de fotokaarten op de homepagina linken hiernaartoe
// Per service een grote en een kleine foto (hier te vervangen)
const services = [
  { num: 1, image: '/images/australia/surf-boys.jpg', imageSmall: '/images/about/great-ocean-road.jpg' },
  { num: 2, image: '/images/about/reis-specialist.jpg', imageSmall: '/images/about/sydney-opera.jpg' },
  { num: 3, image: '/images/about/Mayra-foto.jpg', imageSmall: '/images/australia/aus_main.webp' },
].map((s) => ({
  ...s,
  title: t(`forBrands.services.${s.num}.title`),
  intro: t(`forBrands.services.${s.num}.intro`),
  offer: t(`forBrands.services.${s.num}.offer`).split('|'),
}));

const socials = [
  { platform: 'instagram', handle: '@mayraaltink', href: 'https://www.instagram.com/mayraaltink', followers: '18.4K' },
  { platform: 'tiktok', handle: '@mayraxaltink', href: 'https://www.tiktok.com/@mayraxaltink', followers: '10.6K' },
];

---

<BaseLayout title={t('forBrands.title')}>
  <div class="bg-[#FFFDFA]">

    <!-- HERO -->
    <section class="relative flex min-h-[640px] h-[100svh] items-center justify-center overflow-hidden rounded-b-[48px] md:rounded-b-[80px]">

      <img
        src="/images/travel-plan/Sydney.jpg"
        alt="Sydney"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 z-10 bg-gradient-to-b from-gray-900/60 via-gray-900/30 to-gray-900/40"></div>

      <div class="relative z-20 mx-auto max-w-3xl px-6 text-center text-white">

        <h1 class="flex flex-col items-center leading-[0.85] tracking-[-0.03em]" style="text-shadow: 0 3px 15px rgba(0,0,0,0.65);">
          <span class="font-neucha text-5xl font-bold text-[#4ED2CE] md:text-6xl">
            {t('forBrands.hero.title1')}
          </span>
          <span class="text-3xl font-medium text-white md:text-4xl">
            {t('forBrands.hero.title2')}
          </span>
        </h1>

        <p class="mt-4 text-base font-medium tracking-[0.02em] text-white md:text-lg" style="text-shadow: 0 3px 15px rgba(0,0,0,0.4);">
          {t('forBrands.hero.line1')}
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={`/${lang}/contact`}
            class="inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-8 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#15939a]"
          >
            {t('forBrands.hero.ctaPrimary')}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a
            href="#services"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-white hover:bg-white/10"
          >
            {t('forBrands.hero.ctaSecondary')}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
          </a>
        </div>
      </div>

      <!-- Locatie -->
      <div class="absolute bottom-6 left-6 z-20 flex items-center gap-2 rounded-full bg-black/35 px-4 py-2 backdrop-blur-sm md:bottom-9">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span class="text-xs uppercase tracking-wide text-white/90">{t('forBrands.hero.location')}</span>
      </div>
    </section>


    <!-- SERVICES -->
    <section id="services" class="scroll-mt-20 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">

        <p class="text-center text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('forBrands.services.eyebrow')}</p>
        <h2 class="mt-3 text-center text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">
          {t('forBrands.services.heading')}
        </h2>

        <!-- Services onder elkaar: foto-collage en tekst, om en om links/rechts -->
        <div class="mt-16 space-y-24 md:mt-24 md:space-y-32">
          {services.map((service) => {
            const flip = service.num % 2 === 0;
            return (
              <article
                id={`service-${service.num}`}
                class="scroll-mt-28 grid items-center gap-14 lg:grid-cols-2 lg:gap-20"
              >
                <!-- Foto's -->
                <div class:list={['relative mx-auto w-full max-w-md lg:max-w-none', { 'lg:order-last': flip }]}>
                  <img
                    src={service.image}
                    alt=""
                    loading="lazy"
                    class:list={[
                      'aspect-[4/5] w-[82%] rounded-[2rem] object-cover shadow-[0_25px_60px_rgba(0,0,0,0.15)]',
                      { 'ml-auto': flip }
                    ]}
                  />
                  <img
                    src={service.imageSmall}
                    alt=""
                    loading="lazy"
                    class:list={[
                      'absolute -bottom-8 aspect-square w-[44%] rounded-[1.5rem] border-[6px] border-[#FFFDFA] object-cover shadow-xl',
                      flip ? 'left-0 -rotate-3' : 'right-0 rotate-3'
                    ]}
                  />
                  <span class:list={[
                    'absolute -top-5 flex h-14 w-14 items-center justify-center rounded-full bg-[#1CABB0] text-lg font-semibold text-white shadow-lg',
                    flip ? 'right-4 rotate-6' : 'left-4 -rotate-6'
                  ]}>
                    0{service.num}
                  </span>
                </div>

                <!-- Tekst -->
                <div>
                  <h3 class="text-3xl font-semibold leading-[1.05] tracking-tight text-black md:text-4xl">{service.title}</h3>
                  <p class="mt-5 text-base leading-relaxed text-gray-600 md:text-lg">{service.intro}</p>

                  <div class="mt-8 rounded-2xl bg-[#F4FBFB] p-6 md:p-7">
                    <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('forBrands.services.offerTitle')}</p>
                    <ul class="mt-4 space-y-2.5">
                      {service.offer.map((item) => (
                        <li class="flex items-start gap-3 text-gray-700">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-1 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                    <a
                      href={`/${lang}/contact`}
                      class="inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]"
                    >
                      {t('forBrands.services.cta')}
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    </a>
                    {service.num === 3 && (
                      <a href="#creator" class="text-sm font-semibold text-[#1CABB0] underline-offset-4 hover:underline">
                        {t('forBrands.services.3.more')}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>


    <!-- SAMENWERKEN: creator partnerships -->
    <section id="creator" class="scroll-mt-20 bg-[#F4FBFB] pt-20 pb-14 md:pt-28">
      <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16">

        <!-- Verhaal -->
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('forBrands.creator.eyebrow')}</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-tight text-gray-900 md:text-5xl">{t('forBrands.creator.title')}</h2>

          <div class="mt-8 space-y-5 text-lg leading-relaxed text-gray-700">
            <p>{t('forBrands.creator.p1')}</p>
            <p>{t('forBrands.creator.p2')}</p>
          </div>

          <a
            href={`/${lang}/contact`}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]"
          >
            {t('forBrands.creator.cta')}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>

        <!-- Socials -->
        <div class="lg:pt-10">
          <h3 class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('forBrands.socials.title')}</h3>

          <ul class="mt-6 space-y-4">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-2xl border border-black/5 bg-white p-4 transition duration-300 hover:border-[#4ED2CE]/60"
                >
                  <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0]">
                    {social.platform === 'instagram' ? (
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
                    ) : (
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
                    )}
                  </span>

                  <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-gray-900">{social.handle}</span>
                    <span class="block text-sm text-gray-500">
                      {social.platform === 'instagram' ? 'Instagram' : 'TikTok'} · <span class="font-semibold text-[#1CABB0]">{social.followers}</span> {t('forBrands.socials.followers')}
                    </span>
                  </span>

                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-gray-300 transition group-hover:translate-x-1 group-hover:text-[#1CABB0]" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>


    <!-- EERDERE SAMENWERKINGEN: logo's -->
    <div id="partners" class="scroll-mt-20">
      <CollaborationSection showStory={false} />
    </div>


    <!-- MIJN PROJECTEN: mini-portfolio -->
    <Portfolio />

  </div>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
