---
// src/components/ui/blogs/Voorbereidingen.astro
// Blog "Voorbereidingen Working Holiday".
// Checklists zijn echt aan te vinken; wat je aanvinkt wordt in je eigen browser onthouden.
// Teksten per taal hieronder; <b> = dikgedrukt, links staan als <a> in de tekst.
// Foto bij Klimaat: /public/images/blogs/klimaat.jpg (ontbreekt die, dan toont het vlak een turquoise placeholder).
import fs from 'node:fs';
import path from 'node:path';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'nl') as 'nl' | 'en';

const climatePhoto = fs.existsSync(path.join(process.cwd(), 'public', '/images/blogs/klimaat.jpg')) ? '/images/blogs/klimaat.jpg' : null;

const ext = (href: string, label: string, light = false) =>
  `<a href="${href}" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4 transition ${light ? 'text-white decoration-white/50 hover:decoration-white' : 'text-[#1CABB0] decoration-[#1CABB0]/40 hover:text-[#0F7C82]'}">${label}</a>`;
const jump = (id: string, label: string) =>
  `<a href="#${id}" class="font-normal italic underline decoration-white/50 underline-offset-4 hover:decoration-white">${label}</a>`;

const URL_ANWB = 'https://www.anwb.nl';
const URL_ALLIANZ = 'https://allianzretailportal.com/nl/#/b2b2c/APN/travel-module/trip-details';
const URL_CBA = 'https://www.commbank.com.au/digital/eosmartaccess/ntb';
const URL_FELIX = 'https://felixmobile.com.au/plan';

const content = {
  nl: {
    eyebrow: 'Blog · Australië',
    title: 'Voorbereidingen <b>Working Holiday</b>',
    tocTitle: 'Spring naar',
    toc: [
      { id: 'meenemen', label: 'Wat neem je mee?' },
      { id: 'zorgverzekering', label: 'Zorgverzekering' },
      { id: 'betaalmiddelen', label: 'Betaalmiddelen' },
      { id: 'simkaart', label: 'Simkaart' },
      { id: 'klimaat', label: 'Klimaat' },
      { id: 'kleding', label: 'Kleding' },
      { id: 'apps', label: 'Handige apps' },
    ],
    checkTitle: 'Wat neem je mee naar Australië?',
    checkIntro: 'Voordat je op het vliegtuig stapt richting Australië, is een goede voorbereiding key. Zorg dat je onderstaande checkboxen op orde hebt, zodat je de reis stressvrij kunt beginnen.',
    checklist: [
      'Geldig paspoort (minimaal 6 maanden geldig)',
      'Goedgekeurd visum (bijv. Tourist, Working Holiday, Student)',
      'Voldoende financiële middelen om je eerste periode te overbruggen (minstens <b>$5.000 AUD</b> kunnen aantonen voor eten, drinken en verblijf)',
      'Kopieën van de belangrijkste documenten in je mail en cloud (paspoort, rijbewijs, goedkeuring visum)',
      `Internationaal rijbewijs (haal je bij de ${ext(URL_ANWB, 'ANWB', true)}, handig voor roadtrips en vanlife)`,
      `Internationaal werkende betaalmiddelen ${jump('betaalmiddelen', '(lees hieronder meer)')}`,
      `Goede reis- en zorgverzekering ${jump('zorgverzekering', '(lees hieronder meer)')}`,
    ],
    insuranceTitle: 'Zorgverzekering in Australië',
    insuranceSub: 'Working Holiday visum',
    insurance: [
      'Ga je met een Working Holiday visum naar Australië? Dan heb je als Nederlandse reiziger recht op <b>Medicare</b> via het <b>Reciprocal Health Care Agreement</b>. Dit betekent dat medisch noodzakelijke zorg, zoals een bezoek aan de huisarts of behandeling in een openbaar ziekenhuis, wordt vergoed. Zodra je aankomt in Australië kun je Medicare zelf aanvragen via de officiële overheidswebsite.',
      'Houd er rekening mee dat de dekking beperkt is: <b>ambulance, tandarts, fysiotherapie, repatriëring</b> en <b>werk- of reisgerelateerde ongevallen</b> vallen hier niet onder. Het is daarom slim om Medicare te combineren met een <b>langdurige reisverzekering met werkdekking</b>, inclusief de medische kostenoptie, zodat je voor repatriëring, ambulance en spoedeisende hulp goed beschermd bent.',
      `Er zijn speciale verzekeringen voor reizen én werken, zoals de ${ext(URL_ALLIANZ, 'Globetrotter Verzekering van Allianz Global Assistance')}. Die biedt deze dekking voor reizen tot <b>24 maanden</b>, inclusief werken, medische kosten en andere extra's.`,
    ],
    paymentTitle: 'Betaalmiddelen',
    payment: 'Het is uiteraard handig om je credit- en debitkaarten te regelen voordat je naar Australië komt. Voor reizen, wonen of werken kun je een <b>Wise</b> en/of <b>Revolut</b> kaart aanschaffen. Een lokale bankrekening bij de <b>Commonwealth Bank of Australia</b> is een handige must als je hier langere tijd, bijvoorbeeld 6 maanden, gaat werken. Zo kun je gemakkelijk in Australische dollars betalen en geld ontvangen.',
    revolutTitle: 'Revolut & Wise',
    revolut: [
      'Ga je reizen, wonen en/of werken in Australië, dan is het handig om een Revolut en/of Wise account aan te maken. Je kunt de kaarten toevoegen aan de wallet op je telefoon, waarmee je contactloos betaalt.',
      'Het grootste voordeel is dat je via deze apps gemakkelijk euro\'s omzet naar Australische dollars (AUD), tegen <b>lage transactiekosten</b> en een <b>gunstige wisselkoers</b>. Binnen enkele seconden zet je geld via iDEAL op je account, waarna je het direct omzet naar AUD om in lokale valuta te betalen.',
      'Daarnaast kun je eenvoudig geld naar vrienden of collega\'s sturen, veilig online betalen en al je uitgaven overzichtelijk bijhouden in de app.',
    ],
    cbaTitle: 'Commonwealth Bank',
    cba: [
      'Ben je echt van plan om langer dan 3 maanden in Australië te wonen en te werken? Dan raad ik je aan om een Commonwealth account te openen. De <b>Commonwealth Bank of Australia</b> is een van de grootste en bekendste banken van Australië, vergelijkbaar met de ING of ABN AMRO in Nederland.',
      'Een groot voordeel van een Australische bankrekening is dat je eenvoudig geld van werkgevers ontvangt, Australische bankoverschrijvingen doet en minder afhankelijk bent van internationale transacties.',
    ],
    cbaStepsTitle: 'Zo open je je rekening',
    cbaSteps: [
      `<b>Vraag je account aan vanuit Nederland.</b> Ik raad aan om dit ongeveer een week voor vertrek te regelen, want geregeld is geregeld! Via de officiële website vraag je online een ${ext(URL_CBA, 'Everyday Smart Access Account')} aan. Je vult je persoonlijke gegevens, paspoortinformatie en visumgegevens in.`,
      '<b>Kies een filiaal.</b> Kies een locatie dicht bij je eerste verblijfplaats. Verblijf je in het centrum van Sydney? Kies dan een centrale locatie, zoals Town Hall of George & Market Street.',
      '<b>Laat je identiteit verifiëren.</b> Ga na aankomst langs bij het filiaal dat je hebt gekozen. Neem je paspoort mee en het uitgeprinte formulier dat je per e-mail ontvangt. Een medewerker controleert je gegevens en activeert je rekening.',
      '<b>Klaar!</b> Na de verificatie kun je je rekening direct gebruiken. Je debitkaart wordt meestal binnen ongeveer 5 werkdagen naar je postadres gestuurd (dit mag ook een hostel- of hoteladres zijn).',
    ],
    simTitle: 'Simkaart regelen',
    sim: [
      'Je kunt een prepaid simkaart (fysiek of eSIM) eenvoudig aanschaffen bij aankomst in Australië, bijvoorbeeld op de luchthaven bij de kiosken van <b>Telstra</b>, <b>Optus</b> of <b>Vodafone</b>.',
      'Ik heb destijds een deal bij Optus op het vliegveld van Sydney afgesloten: voor <b>$39 AUD (€23)</b> per maand kreeg ik 40 GB data, onbeperkt bellen en sms\'en binnen Australië en 400 internationale belminuten. Tegenwoordig heb je Optus al voor <b>$13 AUD</b> in de eerste maand. Ik ben tevreden over Optus en vond het fijn dat ze alles ter plekke voor me installeerden en regelden.',
      `Tegenwoordig is er ook een sterke deal bij ${ext(URL_FELIX, 'Felix Mobile')}: <b>$20 AUD per maand</b> voor onbeperkt internet, bellen en sms'en binnen Australië, de eerste 6 maanden. Je kiest bij Felix Mobile tussen een eSIM of een fysieke simkaart. De fysieke simkaart ontvang je binnen 5 werkdagen. Een eSIM kun je al van tevoren aanschaffen, maar activeren en gebruiken kan pas zodra je in Australië bent.`,
