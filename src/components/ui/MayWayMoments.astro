---
// src/components/ui/MayWayMoments.astro
// Jouw eigen favoriete momenten als swipe. De momenten staan in src/data/moments.ts.
import fs from 'node:fs';
import path from 'node:path';
import { ui, defaultLang } from '../../i18n/ui';
import { moments as allMoments } from '../../data/moments';
import CarouselControls from './CarouselControls.astro';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

const moments = allMoments.map((m) => ({
  src: fs.existsSync(path.join(process.cwd(), 'public', m.image)) ? m.image : null,
  title: m.title[lang],
  location: m.location,
  story: m.story[lang],
  zoomStyle: m.zoom ? `transform: scale(${m.zoom.scale}); transform-origin: ${m.zoom.origin}` : undefined,
}));
---

<section id="moments" class="mt-16 scroll-mt-20 bg-[#E6F6F6] py-16 md:mt-24 md:py-24">
  <div data-carousel class="mx-auto max-w-7xl">

    <!-- Kop -->
    <!-- Mobiel: onder elkaar, gecentreerd. Desktop: titel links, tekst rechts -->
    <div class="mx-auto px-6 text-center md:flex md:items-end md:justify-between md:gap-12 md:px-10 md:text-left">
      <!-- Eerste woord (MAY) dikgedrukt, de rest normaal -->
      <h2 class="shrink-0 md:pl-8 text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl">
        <b class="font-semibold">{t('moments.title').split(' ')[0]}</b> {t('moments.title').split(' ').slice(1).join(' ')}
      </h2>
      <p class="mx-auto mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:mx-0 md:mt-0 md:text-base">{t('moments.intro')}</p>
    </div>

    <!-- Swipe (bediening: CarouselControls, zelfde stijl op de hele site) -->
    <div class="mx-auto mt-10 px-6 md:mt-12 md:px-10">
      <div data-carousel-track class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth md:gap-5">
      {moments.map((moment) => (
        <button
          type="button"
          class="moment-card group relative block aspect-[4/5] w-full shrink-0 snap-center sm:snap-start overflow-hidden rounded-[1.75rem] bg-[#0B5F64] text-left sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2.5rem)/3)]"
          data-src={moment.src ?? ''}
          data-title={moment.title}
          data-location={moment.location}
          data-story={moment.story}
        >
          {moment.src ? (
            <img src={moment.src} alt={moment.title} loading="lazy" draggable="false" style={moment.zoomStyle} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-[#0F7C82] to-[#084649]"></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>

          <div class="absolute inset-x-0 bottom-0 p-5 text-white md:p-6">
            <p class="flex items-center gap-1.5 text-xs uppercase tracking-[0.15em] text-white/80">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              {moment.location}
            </p>
            <h3 class="mt-2 text-xl font-semibold leading-tight tracking-tight md:text-2xl">{moment.title}</h3>
          </div>

          <!-- Plusje: klik voor het verhaal -->
          <span class="absolute right-4 top-4 flex h-6 w-6 items-center justify-center rounded-full bg-white/25 text-white backdrop-blur-sm transition group-hover:rotate-90 group-hover:bg-white group-hover:text-[#1CABB0]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
          </span>
        </button>
      ))}
      </div>
    </div>

    <CarouselControls />
  </div>

  <!-- Moment met verhaal (opent bij klikken) -->
  <dialog class="moment-story m-auto w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-[1.75rem] p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm">
    <div class="grid md:grid-cols-[1.1fr_1fr]">
      <div class="relative aspect-[4/5] bg-gradient-to-br from-[#0F7C82] to-[#084649] md:aspect-auto md:min-h-[28rem]">
        <img data-story-photo alt="" class="absolute inset-0 hidden h-full w-full object-cover" />
      </div>
      <div class="relative flex flex-col justify-center p-6 md:p-9">
        <button type="button" data-story-close class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <p data-story-location class="flex items-center gap-1.5 pr-10 text-xs uppercase tracking-[0.15em] text-[#1CABB0]"></p>
        <h3 data-story-title class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-black md:text-3xl"></h3>
        <p data-story-text class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-gray-600 md:text-base"></p>      </div>
    </div>
  </dialog>
</section>

<script>
  // Moment openen met het verhaal (de swipe zelf regelt CarouselControls)
  function initMomentStories() {
    const dialog = document.querySelector<HTMLDialogElement>('.moment-story');
    if (!dialog) return;
    const photo = dialog.querySelector<HTMLImageElement>('[data-story-photo]')!;
    const set = (selector: string, value: string) => { dialog.querySelector(selector)!.textContent = value; };

    document.querySelectorAll<HTMLElement>('.moment-card').forEach((card) => {
      card.addEventListener('click', () => {
        const { src = '', title = '', location = '', story = '' } = card.dataset;
        photo.classList.toggle('hidden', !src);
        if (src) { photo.src = src; photo.alt = title; }
        set('[data-story-location]', location);
        set('[data-story-title]', title);
        set('[data-story-text]', story);
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-story-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMomentStories);
  } else {
    initMomentStories();
  }
</script>
