const checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';
---

<article data-prep class="bg-[#FFFDFA] px-6 pb-24 pt-32 md:pb-32 md:pt-40 [&_b]:font-semibold">
  <div class="mx-auto max-w-5xl">

    <!-- Kop -->
    <header id="top" class="text-center">
      <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{content.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl [&_b]:font-bold">
        <Fragment set:html={content.title} />
      </h1>
      <nav aria-label={content.tocTitle} class="mt-8">
        <ol class="flex flex-wrap justify-center gap-2">
          {content.toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="inline-flex rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-semibold text-gray-800 transition hover:border-[#1CABB0] hover:bg-[#1CABB0] hover:text-white">{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <!-- Checklist: wat neem je mee -->
    <section id="meenemen" class="mt-12 scroll-mt-28 rounded-[2.5rem] bg-[#5FCDD0] px-5 py-10 text-white md:mt-16 md:rounded-[3.5rem] md:px-16 md:py-14">
