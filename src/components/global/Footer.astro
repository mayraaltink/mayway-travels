---
import { useTranslations } from '../../i18n/ui';

const lang = (Astro.currentLocale ?? 'nl') as 'nl' | 'en';
const t = useTranslations(lang);

// Zelfde pagina's als de menubalk
const links = [
  { href: '/', text: t('nav.home') },
  { href: '/for-brands', text: t('nav.forbrands') },
  { href: '/community', text: t('nav.community') },
  { href: '/about', text: t('nav.about') },
  { href: '/contact', text: t('nav.contact') },
];

const year = new Date().getFullYear();
---

<footer class="rounded-t-3xl border-t border-black/5 bg-[#FFFDFA]">
  <div class="mx-auto max-w-6xl px-6 pt-12 pb-6 md:pt-16">

    <!-- Desktop: logo en titel even hoog, zodat beide teksten op dezelfde lijn beginnen; knoppen onderaan -->
    <div class="grid grid-cols-1 gap-12 text-center md:grid-cols-3 md:items-start md:gap-10 md:text-left">

      <!-- LINKS: logo + omschrijving -->
      <div class="flex flex-col items-center md:items-start">
        <a href={`/${lang}`} class="font-neucha text-4xl font-bold leading-none tracking-tight text-[#4ED2CE]">
          MAY WAY<span class="ml-[0.04em] text-[0.93em]">S</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-gray-600">
          {t('footer.description')}
        </p>
      </div>

      <!-- MIDDEN: pagina's -->
      <nav class="flex flex-wrap justify-center gap-2.5 md:self-end" aria-label="Footer">
        {links.map((link) => (
          <a
            href={`/${lang}${link.href === '/' ? '' : link.href}`}
            class="inline-flex items-center rounded-full bg-[#1CABB0] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#15939a]"
          >
            {link.text}
          </a>
        ))}
      </nav>

      <!-- RECHTS: socials -->
      <!-- Desktop: icoontjes hangen onder de tekst, zodat de tekst zelf op de onderlijn staat -->
      <div class="relative flex flex-col items-center md:items-end md:text-right">
        <h4 class="text-xl font-semibold text-gray-900 md:text-2xl md:leading-9">{t('footer.followTitle')}</h4>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-gray-600 md:mt-4">{t('footer.followText')}</p>

        <div class="mt-5 flex gap-3 md:absolute md:right-0 md:top-full">
          <a
            href="https://www.instagram.com/mayraaltink/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram @mayraaltink"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0] transition hover:bg-[#1CABB0] hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
          </a>
          <a
            href="https://www.tiktok.com/@mayraxaltink"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok @mayraxaltink"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0] transition hover:bg-[#1CABB0] hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- ONDERBALK -->
    <div class="mt-10 flex flex-col items-center gap-2 md:mt-20 border-t border-black/5 pt-5 text-xs text-gray-500 md:flex-row md:justify-between">
      <p>© {year} MAY WAYS · {t('footer.copyright')}</p>
      <a href="mailto:maywaytravels1@gmail.com" class="transition hover:text-[#1CABB0]">maywaytravels1@gmail.com</a>
    </div>
  </div>
</footer>
