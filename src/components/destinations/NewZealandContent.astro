---
import DestinationContent from "./DestinationContent.astro";
import DestinationIntro from './DestinationIntro.astro';
import RouteAtlas from './RouteAtlas.astro';
import HotspotCarousel from './HotspotCarousel.astro';
import { newZealandRoutes } from '../../data/routes';
import { ui, defaultLang } from '../../i18n/ui';

// Get current language
const currentPath = Astro.url.pathname;
const lang = (Astro.currentLocale || (currentPath.startsWith('/en') ? 'en' : defaultLang)) as keyof typeof ui;

// Translation helper
function t(key: keyof typeof ui[typeof lang]) {
  return ui[lang][key];
}

const hotspots = [
  'nz_tongariro',
  'nz_hooker_kea',
  'nz_milford',
  'nz_waitomo',
  'nz_kawarau',
  'nz_hot_water_beach',
  'nz_heli_glaciers',
  'nz_redwoods',
  'nz_te_anau',
  'nz_hobbiton',
  'nz_ben_lomond',
  'nz_huka',
];

// Foto per hotspot (map public/images/new-zealand); zonder foto toont de kaart een turquoise vlak
const photos: Record<string, string> = {
  nz_hooker_kea: '/images/new-zealand/hooker.jpg',
  nz_redwoods: '/images/new-zealand/woodstrail.jpg',
  nz_hot_water_beach: '/images/new-zealand/hotwater.jpg',
  nz_milford: '/images/new-zealand/milford.jpg',
  nz_huka: '/images/new-zealand/huka.jpg',
  nz_tongariro: '/images/new-zealand/tongariro.jpg',
  nz_hobbiton: '/images/new-zealand/hobbiton.jpg',
  nz_heli_glaciers: '/images/new-zealand/fox.jpg',
  nz_waitomo: '/images/new-zealand/cave.jpg',
  nz_kawarau: '/images/comfortzone/lach.jpg',
  nz_te_anau: '/images/new-zealand/teanau.jpg',
  nz_ben_lomond: '/images/new-zealand/benlomond.webp',
};
---

<DestinationContent
  title={t('nz.page.title')}
  description={t('nz.page.desc')}
  capital={t('nz.page.capital')}
  language={t('nz.page.language')}
  currency={t('nz.page.currency')}
  flightTime={t('nz.page.flightTime')}
  location={t('nz.page.location')}
  imageSrc="/images/new-zealand/meer.JPG"
  imageAlt="Beautiful landscape in New Zealand"
  planUrl={lang === 'nl' ? '/nl/route-planner?country=new-zealand' : '/en/route-planner?country=new-zealand'}
  guideUrl={lang === 'nl' ? '/eguides/' : '/en/eguides/'}
>
  <DestinationIntro prefix="nz" />
  <HotspotCarousel hotspots={hotspots} photos={photos} descKey="hotspots_descNZ" />
  <RouteAtlas
    map="/images/new-zealand/new-zealand-shape.svg"
    routes={newZealandRoutes}
    subtitleKey="routes.nz.subtitle"
  />
</DestinationContent>
