---
// src/components/ui/blogs/Voorbereidingen.astro
// Blog "Voorbereidingen Working Holiday".
// Checklists zijn echt aan te vinken; wat je aanvinkt wordt in je eigen browser onthouden.
// Teksten per taal hieronder; <b> = dikgedrukt, links staan als <a> in de tekst.

const lang = (Astro.currentLocale === 'en' ? 'en' : 'nl') as 'nl' | 'en';

const ext = (href: string, label: string, light = false) =>
  `<a href="${href}" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4 transition ${light ? 'text-white decoration-white/50 hover:decoration-white' : 'text-[#1CABB0] decoration-[#1CABB0]/40 hover:text-[#0F7C82]'}">${label}</a>`;
const jump = (id: string, label: string) =>
  `<a href="#${id}" class="font-normal italic underline decoration-white/50 underline-offset-4 hover:decoration-white">${label}</a>`;

const URL_ANWB = 'https://www.anwb.nl/auto/rijbewijs/het-rijbewijs/internationaal-rijbewijs';
const URL_ALLIANZ = 'https://allianzretailportal.com/nl/#/b2b2c/APN/travel-module/trip-details';
const URL_MEDICARE = 'https://www.servicesaustralia.gov.au/reciprocal-health-care-agreements-visiting-from-netherlands?context=22481';
const URL_CBA = 'https://www.commbank.com.au/digital/eosmartaccess/ntb';
const URL_OPTUS = 'https://www.optus.com.au/deals#prepaid';
const URL_FELIX = 'https://felixmobile.com.au/plan';
const URL_BOOST = 'https://boost.com.au/esims';
const URL_AMAYSIM = 'https://www.amaysim.com.au/';
const URL_TELSTRA = 'https://www.telstra.com.au/';
const URL_WHISTLEOUT = 'https://www.whistleout.com.au/MobilePhones/Guides/what-is-esim';
const URL_FINDER = 'https://www.finder.com.au/mobile-plans/esim';

const content = {
  nl: {
    eyebrow: 'Blog · Australië',
    title: 'Voorbereidingen <b>Working Holiday</b>',
    tocTitle: 'Ga snel naar',
    toc: [
      { id: 'meenemen', label: 'Wat neem je mee?' },
      { id: 'zorgverzekering', label: 'Zorgverzekering' },
      { id: 'betaalmiddelen', label: 'Betaalmiddelen' },
      { id: 'simkaart', label: 'Simkaart' },
      { id: 'kleding', label: 'Kleding' },
      { id: 'apps', label: 'Handige apps' },
    ],
    checkTitle: 'Wat neem je mee naar Australië?',
    checkIntro: 'Voordat je op het vliegtuig stapt richting Australië, is een goede voorbereiding key. Zorg dat je onderstaande checkboxen op orde hebt, zodat je de reis stressvrij kunt beginnen.',
    checklist: [
      'Goedgekeurd visum (bijv. Tourist, Working Holiday, Student)',
      'Geldig paspoort (minimaal 6 maanden geldig)',
      'Voldoende financiële middelen om je eerste periode te overbruggen (minstens <b>$5.000 AUD</b> kunnen aantonen voor eten, drinken en verblijf)',
      'Kopieën van de belangrijkste documenten in je mail en cloud (paspoort, rijbewijs, verzekeringen, goedkeuring visum)',
      `Internationaal rijbewijs (haal je bij de ${ext(URL_ANWB, 'ANWB', true)}, handig voor roadtrips en vanlife)`,
      `Internationaal werkende betaalmiddelen: credit- & debitcards ${jump('betaalmiddelen', '(lees meer)')}`,
      `Goede reis- en zorgverzekering ${jump('zorgverzekering', '(lees meer)')}`,
    ],
    insuranceTitle: 'Zorgverzekering in Australië',
    insuranceSub: 'Working Holiday visum',
    insurance: [
      '<p>Verzekerd naar het buitenland gaan is echt mega, mega belangrijk. Een ongeluk zit in een klein hoekje: een val met surfen, een blessure tijdens je farmwerk of gewoon een flinke griep. Zonder goede verzekering kan een ziekenhuisbezoek in Australië je zomaar <b>duizenden dollars</b> kosten. Het goede nieuws: ga je met een Working Holiday visum naar Australië, dan kun je als Nederlander gebruikmaken van <b>Medicare</b>.</p>',
      '<h3>Wat is Medicare?</h3><p>Medicare is het publieke zorgstelsel van Australië, een beetje te vergelijken met onze basisverzekering. Het zorgt ervoor dat Australiërs goedkoop of gratis naar de huisarts en het openbare ziekenhuis kunnen. Nederland en Australië hebben een <b>Reciprocal Health Care Agreement</b>, en daardoor kun jij als Nederlander ook gebruikmaken van Medicare. Voorwaarde: je hebt een geldige Nederlandse basisverzekering. Medicare loopt zolang je Nederlandse zorgverzekering, je EHIC-pas en je visum geldig zijn.</p>',
      '<h3>Wat vergoedt Medicare?</h3><p>Medicare vergoedt medisch noodzakelijke zorg, zoals:</p><ul><li>een bezoek aan de huisarts (GP)</li><li>behandeling als publieke patiënt in een openbaar ziekenhuis</li><li>een deel van de medicijnen op recept</li></ul>',
      `<h3>Zo vraag je Medicare aan</h3><p>Download het ${ext(URL_MEDICARE, 'inschrijvingsformulier')} en stuur het in volgens de instructies op het formulier. Je hebt nodig:</p><ul><li>je paspoort</li><li>je visum</li><li>een bewijs van je Nederlandse zorgverzekering, of je EHIC-pas (de blauwe pas met “NL”)</li></ul>`,
      `<h3>Let op: Medicare dekt niet alles</h3><p>Medicare vergoedt geen <b>ambulance, tandarts, fysiotherapie, privéziekenhuizen of repatriëring</b>. Combineer het daarom met een <b>langdurige reisverzekering met werkdekking én medische kosten</b>, zoals de ${ext(URL_ALLIANZ, 'Globetrotter van Allianz Global Assistance')}. Die geldt voor reizen tot <b>24 maanden</b>, inclusief werken en medische kosten.</p>`,
    ],
    paymentTitle: 'Betaalmiddelen',
    payment: 'Het is uiteraard handig om je credit- en debitkaarten te regelen voordat je naar Australië komt. Voor reizen, wonen of werken kun je een <b>Wise</b> en/of <b>Revolut</b> kaart aanschaffen. Een lokale bankrekening bij de <b>Commonwealth Bank of Australia</b> is een handige must als je hier langere tijd, bijvoorbeeld 6 maanden, gaat werken. Zo kun je gemakkelijk in Australische dollars betalen en geld ontvangen.',
    revolutTitle: 'Revolut & Wise',
    revolutBadge: 'Altijd handig!',
    revolut: [
      '<p>Ga je reizen, wonen of werken in Australië? Dan is een Revolut- of Wise-account (of allebei!) echt een aanrader. Met deze apps betaal je makkelijk en goedkoop in Australische dollars, zonder de hoge kosten die je bij een gewone Nederlandse bank betaalt.</p>',
      '<h4>Waarom zijn ze zo handig?</h4><ul><li><b>Gunstige wisselkoers en lage kosten:</b> je zet euro’s met een paar tikken om naar Australische dollars (AUD), tegen een veel betere koers dan bij de meeste banken.</li><li><b>Contactloos betalen:</b> voeg je kaart toe aan Apple Pay of Google Pay en betaal gewoon met je telefoon. In Australië kan dat bijna overal.</li><li><b>Alles in één overzicht:</b> je ziet direct wat je uitgeeft, en zo houd je je budget goed in de gaten.</li><li><b>Australische rekeninggegevens bij Wise:</b> je krijgt een BSB en een rekeningnummer, zodat je ook geld in AUD kunt ontvangen, bijvoorbeeld je salaris.</li></ul>',
      '<h4>Zo zet je geld op je kaart en wissel je het om naar AUD</h4><ol><li><b>Geld storten:</b> open de Revolut- of Wise-app, kies voor “geld toevoegen” en betaal via iDEAL met je Nederlandse bankrekening. Binnen een paar seconden tot minuten staan je euro’s op je account.</li><li><b>Omzetten naar AUD:</b> kies in de app voor “wisselen” of “converteren”, vul het bedrag in en zet je euro’s om naar Australische dollars. Dat gaat direct, en je ziet vooraf precies welke koers en kosten je betaalt.</li><li><b>Betalen:</b> betaal gewoon met je kaart of telefoon. De app gebruikt automatisch je AUD-saldo.</li></ol>',
      '<p>Houd wel rekening met de <b>verwerkingstijd</b>. Storten via iDEAL gaat meestal razendsnel, maar een gewone overboeking vanaf je bank kan soms tot een werkdag duren. Stuur je geld vanuit Wise of Revolut naar een Australische bankrekening, dan kan dat tot twee werkdagen duren. Houd hier rekening mee.</p>',
    ],
    cbaTitle: 'Commonwealth Bank',
    cbaBadge: '+3 maanden',
    cba: [
      'Ben je echt van plan om langer dan 3 maanden in Australië te wonen en te werken? Dan raad ik je aan om een Commonwealth account te openen. De <b>Commonwealth Bank of Australia</b> is een van de grootste en bekendste banken van Australië, vergelijkbaar met de ING of ABN AMRO in Nederland.',
      'Een groot voordeel van een Australische bankrekening is dat je eenvoudig geld van werkgevers ontvangt, Australische bankoverschrijvingen doet en minder afhankelijk bent van internationale transacties.',
    ],
    cbaStepsTitle: 'Zo open je je rekening',
    cbaSteps: [
      `<b>Vraag je account aan vanuit Nederland.</b> Ik raad aan om dit ongeveer een week voor vertrek te regelen, want geregeld is geregeld! Via de officiële website vraag je online een ${ext(URL_CBA, 'Everyday Smart Access Account')} aan. Je vult je persoonlijke gegevens, paspoortinformatie en visumgegevens in.`,
      '<b>Kies een filiaal.</b> Kies een locatie dicht bij je eerste verblijfplaats. Verblijf je in het centrum van Sydney? Kies dan een centrale locatie, zoals Town Hall of George & Market Street.',
      '<b>Laat je identiteit verifiëren.</b> Ga na aankomst langs bij het filiaal dat je hebt gekozen. Neem je paspoort mee en het uitgeprinte formulier dat je per e-mail ontvangt. Een medewerker controleert je gegevens en activeert je rekening.',
      '<b>Klaar!</b> Na de verificatie kun je je rekening direct gebruiken. Je debitkaart wordt meestal binnen ongeveer 5 werkdagen naar je postadres gestuurd (dit mag ook een hostel- of hoteladres zijn).',
    ],
    simTitle: 'Simkaart regelen',
    sim: [
      `<p>Een Australische simkaart is echt <b>onmisbaar</b> tijdens je working holiday. Op het vliegveld in de grote steden van <b>Sydney, Melbourne en Perth</b> vind je kiosken van <b>Telstra, Optus en Vodafone</b>. Hier kun je gemakkelijk een <b>fysieke simkaart</b> laten installeren. In de steden merk je eigenlijk weinig verschil tussen de drie, dus uiteindelijk kun je het beste gewoon voor de <b>scherpste deal</b> gaan. Ga je echt <b>afgelegen</b> werken, kies dan voor ${ext(URL_TELSTRA, 'Telstra')}.</p>`,
      `<p>Ik koos zelf voor dit gemak en sloot een deal bij Optus op het vliegveld van Sydney: voor <b>$39 AUD (€23) per maand</b> kreeg ik <b>40 GB data</b>, <b>onbeperkt bellen en sms’en</b> binnen Australië en <b>400 internationale belminuten</b>. Ik vond het superfijn dat ze alles ter plekke voor me regelden. Achteraf had ik wel <b>goedkoper uit</b> kunnen zijn: bij ${ext(URL_OPTUS, 'Optus')} betaal je online nu bijvoorbeeld maar <b>$13 AUD voor de eerste 28 dagen</b>.</p>`,
      `<h3>Liever een eSIM?</h3><p>Steeds meer mensen kiezen voor een <b>eSIM</b>, die je van tevoren al zelf kunt installeren. Een sterke deal vind je bij ${ext(URL_FELIX, 'Felix Mobile')}: de eerste 6 maanden betaal je <b>$20 AUD per maand</b> voor <b>onbeperkt internet, bellen en sms'en</b> binnen Australië. Je kiest bij Felix tussen een eSIM en een fysieke simkaart. De fysieke simkaart ontvang je <b>binnen 5 werkdagen</b>. Een eSIM kun je al <b>vóór vertrek kopen</b>, maar activeren en gebruiken kan pas <b>zodra je in Australië bent</b>.</p>`,
      `<p>Andere aanraders zijn ${ext(URL_BOOST, 'Boost Mobile')} en ${ext(URL_AMAYSIM, 'Amaysim')}. Boost gebruikt het netwerk van <b>Telstra</b> en heeft daardoor het <b>beste bereik buiten de steden</b>. Dat is ideaal als je je regionale werk op een <b>farm</b> gaat doen, want daar heb je met andere netwerken soms nauwelijks bereik. Amaysim gebruikt het netwerk van <b>Optus</b> en heeft vaak <b>scherpe prijzen</b>. Vergelijk de actuele deals even op ${ext(URL_WHISTLEOUT, 'WhistleOut')} of ${ext(URL_FINDER, 'Finder')}.</p>`,
      "<h3>Waarom een travel-eSIM geen goed idee is</h3><p>Je komt ze vast tegen: travel-eSIMs van bijvoorbeeld Airalo of Holafly. Voor een vakantie zijn ze top, maar voor een working holiday raad ik ze af. Dit is waarom:</p><ul><li><b>Je krijgt geen Australisch telefoonnummer.</b> Je hebt meestal alleen data. Juist dat nummer heb je overal voor nodig: om een bankrekening te openen, voor je TFN (belastingnummer), om te solliciteren en om bereikbaar te zijn voor werkgevers en huisbazen.</li><li><b>Werkgevers bellen je.</b> In Australië wordt veel telefonisch geregeld. Kunnen ze je niet bellen of sms'en, dan gaat de baan gewoon naar iemand anders.</li><li><b>Je mist sms-codes.</b> Australische banken en apps sturen verificatiecodes per sms naar een Australisch nummer. Zonder lokaal nummer loop je daar steeds op vast.</li><li><b>Op de lange termijn veel duurder.</b> Travel-eSIMs zijn bedoeld voor een paar dagen of weken. Voor een heel jaar betaal je per GB flink meer dan bij een lokale provider.</li></ul>",
      '<p>Een travel-eSIM kan wel handig zijn als overbrugging voor de eerste dag of twee, maar regel zo snel mogelijk een lokaal abonnement.</p>',
    ],
    clothesTitle: 'Wat voor kleding neem je mee?',
    climateMore: 'Bekijk per regio en seizoen hoe warm het is',
    clothesIntro: [
      'Je gaat voor een jaar (of misschien wel langer!) naar de andere kant van de wereld en dan wil je natuurlijk niets vergeten. Maar laat ik meteen met het belangrijkste beginnen: je kunt in Australië <b>écht alles kopen</b>.',
      'Toen ik destijds in Australië aankwam, had ik maar <b>één backpack van 70 liter</b> bij me. Ideaal was dat achteraf niet helemaal, want ik moest mijn garderobe stap voor stap aanvullen. Ik kwam namelijk vanuit de tropische temperaturen van 30+ graden terecht in <b>Sydney</b>. En geloof me, in de maanden <b>juni en juli</b> mogen die blazers, truien en lange broeken toch echt weer uit de kast komen.',
      'Het fijne is dat Australië qua winkelaanbod eigenlijk heel erg op Nederland lijkt. Je vindt er <b>dezelfde soort winkels en merken</b>, waardoor je jouw garderobe gemakkelijk weer kunt aanvullen met leuke kledingstukken. Je hoeft dus echt <b>niet je hele kledingkast</b> mee te slepen!',
    ],
    lists: [
      {
        id: 'basis',
        title: 'Basis inpaklijst',
        sub: 'Essentiële items voor elke reis',
        items: [] as string[],
        groups: [
          { title: 'Bovenkleding', items: ['Topjes / t-shirts', 'Longsleeves', 'Hoodie / sweater', 'Blazer', 'Regenjas / windjack', 'Bomberjack / warmere jas (voor de winter)'] },
          { title: 'Onderkleding', items: ['Korte broeken / shorts', 'Jurkjes', 'Rokjes', 'Lange luchtige broek / linnen broek', 'Pantalon', 'Spijkerbroek'] },
          { title: 'Sportkleding', items: ['Sporttopjes / sportshirts', 'Sportlegging / sportshort', 'Sportbeha', 'Sportschoenen'] },
          { title: 'Ondergoed & nachtkleding', items: ['Ondergoed en sokken', 'Zwemkleding / bikini', 'Pyjama / slaapkleding'] },
          { title: 'Schoenen', items: ['Sneakers', 'Slippers'] },
          { title: 'Accessoires', items: ['Pet / zonnehoed', 'Zonnebril', 'Sieraden'] },
        ],
      },
      {
        id: 'musthaves',
        title: 'Must haves',
        sub: 'Extra items voor een comfortabele reis',
        items: [
          'Zonnebrand SPF 50+ (neem een kleine fles mee en koop een grote ter plekke)',
          'After-sun',
          'Sneldrogende handdoek / strandlaken',
          'Wereldstekker (type I)',
          'Navulbare waterfles',
          'Powerbank (in je handbagage)',
          'Boek of e-reader',
          'Camera (+ oplader en extra geheugenkaart)',
          'Slotjes voor koffer of rugzak (TSA-slot)',
        ],
      },
    ],
    appsTitle: 'Handige apps voor in Australië',
    apps: [
      {
        title: 'Reizen & roadtrips',
        items: [
          ['WikiCamps', 'Dé app voor campings, free camps, douches en toiletten'],
          ['CampMate', 'Vergelijkbaar met WikiCamps: campings, parkeerplekken en faciliteiten'],
          ['Fuel Map Australia', 'De goedkoopste benzine vinden (heel handig in de Outback)'],
          ['Google Maps', 'Navigatie en offline kaarten downloaden'],
        ],
      },
      {
        title: 'Openbaar & eigen vervoer',
        items: [
          ['Lime', 'Elektrische fiets of step voor korte afstanden in de stad'],
          ['DiDi', 'Goedkope taxi-app (download via de Australische App Store)'],
          ['Uber', 'Bekende taxi-app, overal in de steden beschikbaar'],
          ['Drive Mate', 'Huur een auto van particulieren voor een dag of weekendtrip'],
        ],
      },
      {
        title: 'Bankzaken',
        items: [
          ['Valutaconverter', 'Eenvoudig valuta omrekenen'],
          ['Commonwealth Bank', 'Betaalapp voor je Australische bankrekening'],
          ['Wise / Revolut', 'Internationale betaalapps'],
        ],
      },
    ],
    back: 'Terug naar boven',
  },
  en: {
    eyebrow: 'Blog · Australia',
    title: 'Preparing for your <b>Working Holiday</b>',
    tocTitle: 'Jump to',
    toc: [
      { id: 'meenemen', label: 'What to bring?' },
      { id: 'zorgverzekering', label: 'Health insurance' },
      { id: 'betaalmiddelen', label: 'Payments' },
      { id: 'simkaart', label: 'SIM card' },
      { id: 'kleding', label: 'Clothing' },
      { id: 'apps', label: 'Useful apps' },
    ],
    checkTitle: 'What do you bring to Australia?',
    checkIntro: 'Before you board your flight to Australia, good preparation is key. Make sure you have ticked off the boxes below, so you can start your trip stress-free.',
    checklist: [
      'Approved visa (e.g. Tourist, Working Holiday, Student)',
      'Valid passport (valid for at least 6 months)',
      'Enough funds to cover your first period (be able to show at least <b>$5,000 AUD</b> for food, drinks and accommodation)',
      'Copies of your most important documents in your email and cloud (passport, driving licence, insurance policies, visa approval)',
      `International driving permit (get it from the ${ext(URL_ANWB, 'ANWB', true)}, handy for road trips and vanlife)`,
      `Internationally accepted payment methods: credit & debit cards ${jump('betaalmiddelen', '(read more)')}`,
      `Good travel and health insurance ${jump('zorgverzekering', '(read more)')}`,
    ],
    insuranceTitle: 'Health insurance in Australia',
    insuranceSub: 'Working Holiday visa',
    insurance: [
      '<p>Going abroad insured is really, really important. Accidents happen in an instant: a fall while surfing, an injury during your farm work or just a nasty flu. Without good insurance a hospital visit in Australia can easily cost you <b>thousands of dollars</b>. The good news: if you go to Australia on a Working Holiday visa, as a Dutch citizen you can use <b>Medicare</b>.</p>',
      '<h3>What is Medicare?</h3><p>Medicare is the public health care system of Australia, a bit like our Dutch basic health insurance. It makes sure Australians can see a GP and go to a public hospital cheaply or for free. The Netherlands and Australia have a <b>Reciprocal Health Care Agreement</b>, which means that as a Dutch citizen you can use Medicare too. Condition: you have valid Dutch basic health insurance. Medicare runs as long as your Dutch health insurance, your EHIC card and your visa are valid.</p>',
      '<h3>What does Medicare cover?</h3><p>Medicare covers medically necessary care, such as:</p><ul><li>a visit to the doctor (GP)</li><li>treatment as a public patient in a public hospital</li><li>part of your prescription medicines</li></ul>',
      `<h3>How to apply for Medicare</h3><p>Download the ${ext(URL_MEDICARE, 'enrolment form')} and submit it following the instructions on the form. You will need:</p><ul><li>your passport</li><li>your visa</li><li>proof of your Dutch health insurance, or your EHIC card (the blue card with “NL”)</li></ul>`,
      `<h3>Please note: Medicare does not cover everything</h3><p>Medicare does not cover <b>ambulance, dentist, physiotherapy, private hospitals or repatriation</b>. So combine it with <b>long-term travel insurance with work cover and medical expenses</b>, such as the ${ext(URL_ALLIANZ, 'Globetrotter from Allianz Global Assistance')}. It is valid for trips of up to <b>24 months</b>, including working and medical expenses.</p>`,
    ],
    paymentTitle: 'Payments',
    payment: 'It is of course handy to sort out your credit and debit cards before you come to Australia. For travelling, living or working you can get a <b>Wise</b> and/or <b>Revolut</b> card. A local bank account with the <b>Commonwealth Bank of Australia</b> is a handy must if you are going to work here for a longer time, for example 6 months. That way you can easily pay and receive money in Australian dollars.',
    revolutTitle: 'Revolut & Wise',
    revolutBadge: 'Always handy!',
    revolut: [
      '<p>Going to travel, live or work in Australia? Then a Revolut or Wise account (or both!) is a real must. With these apps you pay easily and cheaply in Australian dollars, without the high fees a regular Dutch bank charges.</p>',
      '<h4>Why are they so handy?</h4><ul><li><b>Good exchange rate and low fees:</b> convert euros to Australian dollars (AUD) in a few taps, at a much better rate than most banks.</li><li><b>Contactless payments:</b> add your card to Apple Pay or Google Pay and simply pay with your phone. In Australia that works almost everywhere.</li><li><b>Everything in one overview:</b> you see straight away what you spend, so you can keep a close eye on your budget.</li><li><b>Australian account details with Wise:</b> you get a BSB and an account number, so you can also receive money in AUD, for example your salary.</li></ul>',
      '<h4>How to top up your card and convert to AUD</h4><ol><li><b>Add money:</b> open the Revolut or Wise app, choose “add money” and pay via iDEAL from your Dutch bank account. Within seconds to minutes your euros are in your account.</li><li><b>Convert to AUD:</b> choose “exchange” or “convert” in the app, enter the amount and convert your euros to Australian dollars. It happens instantly, and you see the exact rate and fees in advance.</li><li><b>Pay:</b> just pay with your card or phone. The app automatically uses your AUD balance.</li></ol>',
      '<p>Do keep the <b>processing time</b> in mind. Topping up via iDEAL is usually lightning fast, but a regular transfer from your bank can sometimes take up to a working day. If you send money from Wise or Revolut to an Australian bank account, it can take up to two working days. Keep this in mind.</p>',
    ],
    cbaTitle: 'Commonwealth Bank',
    cbaBadge: '3+ months',
    cba: [
      'Are you really planning to live and work in Australia for more than 3 months? Then I recommend opening a Commonwealth account. The <b>Commonwealth Bank of Australia</b> is one of the largest and best-known banks in Australia, comparable to ING or ABN AMRO in the Netherlands.',
      'A big advantage of an Australian bank account is that you can easily receive money from employers, make Australian bank transfers and depend less on international transactions.',
    ],
    cbaStepsTitle: 'How to open your account',
    cbaSteps: [
      `<b>Apply from the Netherlands.</b> I recommend doing this about a week before you leave, because done is done! On the official website you apply online for an ${ext(URL_CBA, 'Everyday Smart Access Account')}. You fill in your personal details, passport information and visa details.`,
      '<b>Choose a branch.</b> Pick a location close to your first accommodation. Staying in Sydney CBD? Choose a central branch such as Town Hall or George & Market Street.',
      '<b>Verify your identity.</b> After you arrive, visit the branch you chose. Bring your passport and the printed form you receive by email. A staff member checks your details and activates your account.',
      '<b>Done!</b> After verification you can use your account straight away. Your debit card is usually sent to your postal address within about 5 working days (this can also be a hostel or hotel address).',
    ],
    simTitle: 'Getting a SIM card',
    sim: [
      `<p>An Australian SIM card is truly <b>essential</b> during your working holiday. At the airports of the big cities like <b>Sydney, Melbourne and Perth</b> you will find kiosks of <b>Telstra, Optus and Vodafone</b>. Here you can easily have a <b>physical SIM card</b> installed. In the cities you hardly notice any difference between the three, so in the end you are best off just going for the <b>sharpest deal</b>. Going to work somewhere really <b>remote</b>? Then choose ${ext(URL_TELSTRA, 'Telstra')}.</p>`,
      `<p>I went for this convenience myself and signed up for a deal with Optus at Sydney airport: for <b>$39 AUD (€23) a month</b> I got <b>40 GB of data</b>, <b>unlimited calls and texts</b> within Australia and <b>400 international minutes</b>. I loved that they arranged everything for me on the spot. Looking back, I could have been <b>cheaper off</b>: at ${ext(URL_OPTUS, 'Optus')}, for example, you now pay only <b>$13 AUD for the first 28 days</b> online.</p>`,
      `<h3>Prefer an eSIM?</h3><p>More and more people choose an <b>eSIM</b>, which you can install yourself in advance. You will find a great deal at ${ext(URL_FELIX, 'Felix Mobile')}: for the first 6 months you pay <b>$20 AUD a month</b> for <b>unlimited data, calls and texts</b> within Australia. At Felix you choose between an eSIM and a physical SIM card. The physical SIM arrives <b>within 5 working days</b>. You can <b>buy an eSIM before you leave</b>, but you can only activate and use it <b>once you are in Australia</b>.</p>`,
      `<p>Other good options are ${ext(URL_BOOST, 'Boost Mobile')} and ${ext(URL_AMAYSIM, 'Amaysim')}. Boost uses the <b>Telstra</b> network and therefore has the <b>best coverage outside the cities</b>. That is ideal if you are going to do your regional work on a <b>farm</b>, because other networks sometimes have hardly any coverage there. Amaysim uses the <b>Optus</b> network and often has <b>sharp prices</b>. Compare the current deals on ${ext(URL_WHISTLEOUT, 'WhistleOut')} or ${ext(URL_FINDER, 'Finder')}.</p>`,
      "<h3>Why a travel eSIM is not a good idea</h3><p>You will probably come across them: travel eSIMs from Airalo or Holafly, for example. They are great for a holiday, but for a working holiday I would not recommend them. Here is why:</p><ul><li><b>You do not get an Australian phone number.</b> You usually only get data. And you need that number for everything: to open a bank account, for your TFN (tax file number), to apply for jobs and to be reachable for employers and landlords.</li><li><b>Employers call you.</b> A lot is arranged by phone in Australia. If they cannot call or text you, the job simply goes to someone else.</li><li><b>You miss SMS codes.</b> Australian banks and apps send verification codes by text to an Australian number. Without a local number you keep getting stuck.</li><li><b>Much more expensive in the long run.</b> Travel eSIMs are meant for a few days or weeks. For a whole year you pay a lot more per GB than with a local provider.</li></ul>",
      '<p>A travel eSIM can be handy as a bridge for the first day or two, but get a local plan as soon as possible.</p>',
    ],
    clothesTitle: 'What clothes do you bring?',
    climateMore: 'See how warm it is per region and season',
    clothesIntro: [
      'You are going to the other side of the world for a year (or maybe even longer!), so of course you don\'t want to forget anything. But let me start with the most important thing: you can <b>really buy everything</b> in Australia.',
      'When I arrived in Australia, I only had <b>one 70-litre backpack</b> with me. Looking back, that wasn\'t ideal, because I had to build up my wardrobe step by step. I went from tropical temperatures of 30+ degrees straight into <b>Sydney</b>. And believe me, in <b>June and July</b> the blazers, jumpers and long trousers come out of the closet again.',
      'The nice thing is that the shops in Australia are actually very similar to the Netherlands. You find <b>the same kind of shops and brands</b>, so you can easily add some nice pieces to your wardrobe. So there is really <b>no need to drag your whole wardrobe</b> along!',
    ],
    lists: [
      {
        id: 'basis',
        title: 'Basic packing list',
        sub: 'Essential items for every trip',
        items: [] as string[],
        groups: [
          { title: 'Tops', items: ['Tops / t-shirts', 'Long sleeves', 'Hoodie / sweater', 'Blazer', 'Raincoat / windbreaker', 'Bomber jacket / warmer coat (for winter)'] },
          { title: 'Bottoms', items: ['Shorts', 'Dresses', 'Skirts', 'Long light trousers / linen trousers', 'Dress trousers', 'Jeans'] },
          { title: 'Sportswear', items: ['Sports tops / sports shirts', 'Sports leggings / sports shorts', 'Sports bra', 'Sports shoes'] },
          { title: 'Underwear & sleepwear', items: ['Underwear and socks', 'Swimwear / bikini', 'Pyjamas / sleepwear'] },
          { title: 'Shoes', items: ['Sneakers', 'Flip-flops'] },
          { title: 'Accessories', items: ['Cap / sun hat', 'Sunglasses', 'Jewellery'] },
        ],
      },
      {
        id: 'musthaves',
        title: 'Must haves',
        sub: 'Extra items for a comfortable trip',
        items: [
          'Sunscreen SPF 50+ (bring a small bottle and buy a big one there)',
          'After-sun',
          'Quick-dry towel / beach towel',
          'Travel adapter (type I)',
          'Refillable water bottle',
          'Power bank (in your hand luggage)',
          'Book or e-reader',
          'Camera (+ charger and extra memory card)',
          'Locks for your suitcase or backpack (TSA lock)',
        ],
      },
    ],
    appsTitle: 'Useful apps in Australia',
    apps: [
      {
        title: 'Travel & road trips',
        items: [
          ['WikiCamps', 'The app for campsites, free camps, showers and toilets'],
          ['CampMate', 'Similar to WikiCamps: campsites, parking spots and facilities'],
          ['Fuel Map Australia', 'Find the cheapest fuel (very handy in the Outback)'],
          ['Google Maps', 'Navigation and offline maps'],
        ],
      },
      {
        title: 'Public & own transport',
        items: [
          ['Lime', 'Electric bike or scooter for short trips in the city'],
          ['DiDi', 'Cheap ride-hailing app (download via the Australian App Store)'],
          ['Uber', 'Well-known ride-hailing app, available in all cities'],
          ['Drive Mate', 'Rent a car from locals for a day or weekend trip'],
        ],
      },
      {
        title: 'Banking',
        items: [
          ['Currency converter', 'Convert currencies easily'],
          ['Commonwealth Bank', 'Banking app for your Australian account'],
          ['Wise / Revolut', 'International payment apps'],
        ],
      },
    ],
    back: 'Back to top',
  },
}[lang];

const checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';
---

<article data-prep class="bg-[#FFFDFA] px-6 pb-24 pt-32 md:pb-32 md:pt-40 [&_b]:font-semibold">
  <div class="mx-auto max-w-5xl">

    <!-- Kop -->
    <header id="top" class="text-center">
      <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{content.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl [&_b]:font-bold">
        <Fragment set:html={content.title} />
      </h1>
      <!-- Knoppen in het midden; "Ga snel naar" links erboven, precies boven de eerste knop (zoals in de Working Holiday-blog) -->
      <nav aria-label={content.tocTitle} class="mx-auto mt-8 w-fit max-w-full text-left">
        <p class="text-xs uppercase tracking-[0.2em] text-gray-500">{content.tocTitle}</p>
        <!-- zelfde knoppen als in de Visum-blog -->
        <ol class="mt-4 flex flex-wrap gap-2">
          {content.toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="inline-flex items-center whitespace-nowrap rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-semibold text-gray-800 transition hover:border-[#1CABB0] hover:bg-[#1CABB0] hover:text-white">{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <!-- Checklist: wat neem je mee -->
    <!-- Zelfde stijl als de paklijsten bij Kleding: lichtturquoise blok met een turquoise kaart vol afvinkbare balkjes -->
    <section id="meenemen" class="mt-12 scroll-mt-28 rounded-[2.5rem] bg-[#B6E8E7] px-4 py-10 text-white md:mt-16 md:rounded-[3.5rem] md:px-8 md:py-14">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-center text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.checkTitle}</h2>
        <p class="mt-4 text-center text-[15px] leading-relaxed text-black/80 md:text-base">{content.checkIntro}</p>
        <div class="mt-8 rounded-[2rem] bg-[#5FCDD0] px-4 py-8 md:px-8 md:py-10">
          <ul class="space-y-3">
            {content.checklist.map((item, i) => (
              <li>
                <label class="flex cursor-pointer items-center gap-4 rounded-full bg-[#46B9BC] py-2.5 pl-3 pr-6 transition hover:bg-[#3FB0B3]">
                  <input type="checkbox" data-check={`meenemen-${i}`} class="peer sr-only" />
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-transparent transition peer-checked:text-[#0F7C82] peer-focus-visible:ring-2 peer-focus-visible:ring-white" set:html={checkSvg} />
                  <span class="text-[15px] font-semibold leading-snug decoration-2 md:text-base peer-checked:line-through peer-checked:opacity-75" set:html={item} />
                </label>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Zorgverzekering -->
    <section id="zorgverzekering" class="mx-auto mt-20 max-w-3xl scroll-mt-28 md:mt-28">
      <h2 class="text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.insuranceTitle}</h2>
      <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base [&_b]:text-gray-900 [&_h3]:pt-3 [&_h3]:text-2xl md:[&_h3]:text-[1.75rem] [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:text-black [&_li]:marker:text-[#1CABB0] [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5">
        {content.insurance.map((block) => <div class="space-y-3" set:html={block} />)}
      </div>
    </section>

    <!-- Betaalmiddelen -->
    <section id="betaalmiddelen" class="mt-20 scroll-mt-28 md:mt-28">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.paymentTitle}</h2>
        <p class="mt-6 text-[15px] leading-relaxed text-gray-700 md:text-base [&_b]:text-gray-900" set:html={content.payment} />
      </div>

      <!-- Revolut & Wise en Commonwealth onder elkaar; het stappenplan zit in het Commonwealth-blok -->
      <div class="mt-10 space-y-6">
        <div class="relative rounded-[2rem] bg-[#E6F6F6] p-7 md:p-10">
          <!-- label in de kleur van het blok, twee tinten donkerder -->
          <span class="absolute -right-2 -top-4 inline-flex rotate-12 rounded-full bg-[#5CC4C7] px-4 py-2 text-xs font-semibold uppercase tracking-wide text-white shadow-lg md:-right-4 md:-top-1 md:px-5 md:py-2.5 md:text-sm">{content.revolutBadge}</span>
          <div class="mx-auto max-w-3xl">
          <!-- zelfde grootte als de tussenkopjes bij Zorgverzekering ("Wat is Medicare?") -->
          <h3 class="text-2xl font-semibold tracking-tight text-black md:text-[1.75rem]">{content.revolutTitle}</h3>
          <div class="mt-4 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base [&_b]:text-gray-900 [&_h4]:mb-3 [&_h4]:pt-2 [&_h4]:text-lg [&_h4]:font-semibold [&_h4]:tracking-tight [&_h4]:text-black [&_li]:marker:font-semibold [&_li]:marker:text-[#1CABB0] [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
            {content.revolut.map((block) => <div set:html={block} />)}
          </div>
          </div>
        </div>

        <div class="relative rounded-[2rem] bg-[#0F7C82] p-7 text-white md:p-10">
          <span class="absolute -right-2 -top-4 inline-flex rotate-12 rounded-full bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wide text-[#0F7C82] shadow-lg md:-right-4 md:-top-1 md:px-5 md:py-2.5 md:text-sm">{content.cbaBadge}</span>
          <div class="mx-auto max-w-3xl">
          <h3 class="text-2xl font-semibold tracking-tight md:text-[1.75rem]">{content.cbaTitle}</h3>
          <div class="mt-4 space-y-4 text-[15px] leading-relaxed text-white/85 md:text-base">
            {content.cba.map((p) => <p set:html={p} />)}
          </div>

          <div class="mt-8 rounded-[1.5rem] bg-white/10 p-6 md:-mx-8 md:p-8">
            <h4 class="text-lg font-semibold tracking-tight md:text-xl">{content.cbaStepsTitle}</h4>
            <ol class="mt-5 space-y-4">
              {content.cbaSteps.map((step, i) => (
                <li class="flex items-start gap-4 text-[15px] leading-relaxed text-white/85 md:text-base [&_a]:text-white [&_a]:decoration-white/50 [&_b]:text-white">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-semibold text-[#0F7C82]">{i + 1}</span>
                  <span class="pt-1" set:html={step} />
                </li>
              ))}
            </ol>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Simkaart -->
    <section id="simkaart" class="mx-auto mt-20 max-w-3xl scroll-mt-28 md:mt-28">
      <h2 class="text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.simTitle}</h2>
      <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base [&_b]:text-gray-900 [&_h3]:mb-3 [&_h3]:pt-3 [&_h3]:text-2xl md:[&_h3]:text-[1.75rem] [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:text-black [&_li]:marker:text-[#1CABB0] [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
        {content.sim.map((block) => <div set:html={block} />)}
      </div>
    </section>


    <!-- Kleding: titel + verhaal los op de pagina (zoals Simkaart), daaronder het blok met de paklijsten -->
    <section id="kleding" class="mt-20 scroll-mt-28 md:mt-28">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.clothesTitle}</h2>
        <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-gray-700 md:text-base [&_b]:text-gray-900">
          {content.clothesIntro.map((p) => <p set:html={p} />)}
        </div>
        <!-- Doorverwijzing naar de blog over het beste reisseizoen -->
        <a href={`/${lang}/blogs/beste-reisseizoen`} class="mt-5 inline-flex items-center gap-2 text-[15px] font-semibold text-[#0F7C82] underline decoration-[#0F7C82]/40 underline-offset-4 transition hover:decoration-[#0F7C82]">
          {content.climateMore}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>

      <!-- Inpaklijsten in een eigen blok -->
      <div class="mt-10 rounded-[2.5rem] bg-[#B6E8E7] px-4 py-10 md:mt-12 md:rounded-[3.5rem] md:px-8 md:py-14">
      <div class="grid gap-5 md:grid-cols-2 md:items-start md:gap-6">
        {content.lists.map((list) => (
          <div class="rounded-[2rem] bg-[#5FCDD0] px-4 py-9 text-white md:px-8 md:py-10">
            <h3 class="text-center text-[1.75rem] font-semibold tracking-tight md:text-[2rem]">{list.title}</h3>
            <p class="mt-1 text-center text-[15px] text-white/90 md:text-base">{list.sub}</p>
            <!-- Lijst met (optioneel) categorieën, bijv. Bovenkleding / Onderkleding -->
            {('groups' in list && list.groups ? list.groups : [{ title: '', items: list.items }]).map((group, gi) => (
              <div class="mt-7">
                {group.title && (
                  <h4 class="mb-3 pl-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">{group.title}</h4>
                )}
                <ul class="space-y-3">
                  {group.items.map((item, i) => (
                    <li>
                      <label class="flex cursor-pointer items-center gap-4 rounded-full bg-[#46B9BC] py-2.5 pl-3 pr-6 transition hover:bg-[#3FB0B3]">
                        <input type="checkbox" data-check={`${list.id}-${gi}-${i}`} class="peer sr-only" />
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-transparent transition peer-checked:text-[#0F7C82] peer-focus-visible:ring-2 peer-focus-visible:ring-white" set:html={checkSvg} />
                        <span class="text-[15px] font-semibold leading-snug decoration-2 md:text-base peer-checked:line-through peer-checked:opacity-75">{item}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
      </div>
    </section>

    <!-- Apps -->
    <section id="apps" class="mt-20 scroll-mt-28 md:mt-28">
      <h2 class="text-center text-4xl font-semibold leading-[1.05] tracking-tight text-black md:text-5xl">{content.appsTitle}</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3 md:items-start">
        {content.apps.map((group) => (
          <div class="rounded-[2rem] bg-white p-7 shadow-[0_20px_50px_rgba(0,0,0,0.06)] ring-1 ring-black/5">
            <h3 class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{group.title}</h3>
            <ul class="mt-5 space-y-4">
              {group.items.map(([name, desc]) => (
                <li>
                  <p class="text-base font-semibold text-gray-900 md:text-lg">{name}</p>
                  <p class="text-[15px] leading-relaxed text-gray-600 md:text-base">{desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="#top" class="inline-flex items-center gap-2 text-sm font-semibold text-[#1CABB0] transition hover:text-[#0F7C82]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
          {content.back}
        </a>
      </div>
    </section>

  </div>
</article>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Aangevinkte items onthouden in deze browser
  const KEY = 'mayways-voorbereidingen-checks';
  let saved: Record<string, boolean> = {};
  try {
    saved = JSON.parse(localStorage.getItem(KEY) || '{}');
  } catch {
    saved = {};
  }

  document.querySelectorAll<HTMLInputElement>('[data-prep] input[data-check]').forEach((box) => {
    const id = box.dataset.check!;
    box.checked = !!saved[id];
    box.addEventListener('change', () => {
      saved[id] = box.checked;
      try {
        localStorage.setItem(KEY, JSON.stringify(saved));
      } catch {
        // Opslaan niet mogelijk (bijv. privévenster): aanvinken werkt nog steeds
      }
    });
  });
</script>
