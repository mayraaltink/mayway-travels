---
const { lang = "en" } = Astro.props;

const blogs = [
  {
    title: lang === "nl" ? "Stap in een reismentaliteit" : "Step into a travel mindset",
    image: "/images/blogs/australia.jpg",
    slug: "tips-australia"
  },
  {
    title: lang === "nl" ? "Aanvraag: Eerste Working Holiday in Australië" : "Application: First Working Holiday in Australia",
    image: "/images/blogs/nz.jpg",
    slug: "VisaAus"
  },
  {
    title: lang === "nl" ? "Voorbereidingen Working Holiday" : "Preparing for your Working Holiday",
    image: "/images/blogs/voorbereidingen.jpg",
    slug: "voorbereidingen"
  },
  {
    title: lang === "nl" ? "Het leven in Australië" : "Life in Australia",
    image: "/images/blogs/money.jpg",
    slug: "travel-budget"
  }
];
---

<section class="bg-[#CDEFEF] py-16 md:py-20">
<div class="max-w-7xl mx-auto px-6">

  <!-- Intro -->
  <div class="max-w-3xl mx-auto mb-12 text-center">
    <h2 class="text-4xl font-semibold mb-4">
      Blogs
    </h2>

    <p class="max-w-lg mx-auto text-gray-600 leading-relaxed">
      Laat je inspireren door handige tips en praktische zaken om goed voorbereid op avontuur te gaan!
    </p>
  </div>

  <!-- Blog cards -->
  <div class="flex flex-wrap justify-center gap-6">

    {blogs.map((blog) => (
      <a
       href={`/${lang}/blogs/${blog.slug}`}
        class="group w-[290px] rounded-3xl overflow-hidden shadow-lg bg-white transition duration-300 hover:-translate-y-2 hover:shadow-xl"
      >

        <img
          src={blog.image}
          alt={blog.title}
          class="aspect-[4/3] w-full object-cover group-hover:scale-105 transition duration-500"
        />

        <div class="p-5">
          <h3 class="text-lg font-semibold leading-snug text-gray-900">
            {blog.title}
          </h3>
        </div>

      </a>
    ))}

  </div>

</div>
</section>