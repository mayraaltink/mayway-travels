---
// src/components/ui/CollaborationSection.astro

import { ui, defaultLang } from '../../i18n/ui';
import CarouselControls from './CarouselControls.astro';

const lang = Astro.currentLocale || defaultLang;

// showStory={false} toont alleen de logo-carousel (gebruikt op For Brands)
const { showStory = true } = Astro.props;

function t(key: keyof typeof ui[typeof defaultLang]) {
  return ui[lang as keyof typeof ui][key];
}

// href (optioneel): link naar de Instagram van het bedrijf
// scale: optioneel, om een logo met veel witruimte in het bestand groter te tonen
const logos: { src: string; alt: string; href?: string; scale?: number }[] = [
  { src: '/images/logo/Mojo.png', alt: 'Mojo', href: 'https://www.instagram.com/mojo.surf/' },
  { src: '/images/logo/heliworks.png', alt: 'HeliWorks', href: 'https://www.instagram.com/heliworks/' },
  { src: '/images/logo/nzone.jfif', alt: 'NZone', href: 'https://www.instagram.com/nzoneskydive/' },
  { src: '/images/logo/bungee.png', alt: 'AJ Hackett Bungy', href: 'https://www.instagram.com/ajhackettbungynz/' },
  { src: '/images/logo/nomads.png', alt: 'Nomads Hostels', href: 'https://www.instagram.com/nomadshostels/' },
  { src: '/images/logo/colorful.png', alt: 'Colourful Collective', href: 'https://www.instagram.com/colourfulcollectivetravel/' },
  { src: '/images/logo/zoo.png', alt: 'Taronga Zoo', href: 'https://www.instagram.com/tarongazoo/' },
  { src: '/images/logo/milford.jfif', alt: 'Pure Milford', href: 'https://www.instagram.com/puremilfordnz/' },
  { src: '/images/logo/drifter.png', alt: 'The Hotel Drifter', href: 'https://www.instagram.com/thehoteldrifter/' },
  { src: '/images/logo/cooinda.jfif', alt: 'Cooinda Lodge', href: 'https://www.instagram.com/cooindalodgekakadu/' },
  { src: '/images/logo/discovery.png', alt: 'Discovery Parks', href: 'https://www.instagram.com/discoveryparksandresorts/' },
  { src: '/images/logo/movement.png', alt: 'Movement', href: 'https://www.instagram.com/movement_oz/' },
  { src: '/images/logo/adventurerental.png', alt: 'Adventure Rentals', href: 'https://www.instagram.com/adventurerentalsaustralia/' },
  { src: '/images/logo/kakadu.png', alt: 'Kakadu Tourism', href: 'https://www.instagram.com/kakadutourism/' },
  { src: '/images/logo/kayak.jfif', alt: 'Sydney Kayak', href: 'https://www.instagram.com/sydneykayakx/' },
  { src: '/images/logo/lylo.jfif', alt: 'Lylo', href: 'https://www.instagram.com/staylylo/' },
  { src: '/images/logo/bridgeclimb.png', alt: 'BridgeClimb', href: 'https://www.instagram.com/bridgeclimb/' },
  { src: '/images/logo/puri.png', alt: 'Puri Garden Hotel', href: 'https://www.instagram.com/purigardenhotel/' },
  { src: '/images/logo/utang.jfif', alt: 'Sumatra Orangutan Trekking', href: 'https://www.instagram.com/sumatraorangutantrekking/' },
  { src: '/images/logo/gibbon.png', alt: 'The Gibbon Experience', href: 'https://www.instagram.com/gibbonexperience/', scale: 1.4 },
  { src: '/images/logo/watershed.png', alt: 'Watershed Saunas', href: 'https://www.instagram.com/watershedsaunas/' },
  { src: '/images/logo/byron.png', alt: 'Cape Byron Kayaks', href: 'https://www.instagram.com/cape_byron_kayaks/' },
];
---

<section class:list={["relative z-0 w-full bg-white pb-12", showStory ? "pt-30" : "pt-8"]}>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">

    <div class="flex justify-center">

      <!-- CONTENT -->
      <div class="w-full self-start pt-0 lg:pt-2">

        {showStory && (<>
        <!-- PREHEADER -->
        <p class="mb-3 text-center text-xs font-medium uppercase tracking-[0.25em] text-[#5CC2BF]">
          {t('collaboration.preheader')}
        </p>

        <!-- TITLE -->
        <h2 class="mb-8 text-center text-3xl leading-[1.1] tracking-[-0.03em] text-black md:text-5xl">
          <span class="font-normal">
            {t('collaboration.titlePart1')}
          </span>

          <span class="font-semibold">
            {t('collaboration.titleHighlight')}
          </span>
        </h2>

        <!-- TEXT -->
        <div class="mx-auto max-w-2xl space-y-4 text-left text-[15px] leading-relaxed text-gray-600 md:text-base">

          <p>
            {t('collaboration.text1')}
          </p>

          <p
            set:html={t('collaboration.text2')
              .replace(
                '{followers}',
                `<span class="font-semibold text-[#5CC2BF]">18.500</span>`
              )
              .replace(
                '{ig1}',
                `<a href="https://www.instagram.com/maywaytravels" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#5CC2BF] transition hover:opacity-70">@maywaytravels</a>`
              )
              .replace(
                '{ig2}',
                `<a href="https://www.instagram.com/mayraaltink" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#5CC2BF] transition hover:opacity-70">@mayraaltink</a>`
              )
            }
          />

          <p class="font-medium text-black">
            {t('collaboration.text3').split('{email}')[0]}

            <a
              href="mailto:maywaytravels1@gmail.com?subject=Collaboration%20MAY%20WAYS"
              class="font-semibold text-[#5CC2BF] transition hover:opacity-70"
            >
              maywaytravels1@gmail.com
            </a>

            {t('collaboration.text3').split('{email}')[1]}
          </p>

        </div>
        </>)}

        <!-- PARTNER LOGO CAROUSEL -->
        <div data-carousel class:list={["relative w-full", { "mt-16": showStory }]}>

          <!-- CAROUSEL TITLE -->
          <h3 class="mb-8 text-center text-3xl font-semibold tracking-[-0.02em] text-black md:text-4xl">
            {t('collaboration.previousTitle')}
          </h3>

<!-- LOGO VIEWPORT -->
<div class="relative">

  <div
    data-carousel-track
    class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
  >

    {logos.map((logo) => (
      <div
        class="partner-item min-w-[calc((100%-2rem)/3)] snap-start sm:min-w-[calc((100%-3rem)/4)] md:min-w-[calc((100%-4rem)/5)]"
      >

        {logo.href ? (
          <a
            href={logo.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${logo.alt} op Instagram`}
            class="flex h-28 w-full items-center justify-center bg-white transition hover:scale-105 hover:opacity-80 md:h-32"
          >
            <img
              src={logo.src}
              alt={logo.alt}
              loading="lazy"
              draggable="false"
              class="max-h-20 w-auto max-w-[95%] select-none object-contain md:max-h-24"
              style={logo.scale ? `transform: scale(${logo.scale})` : undefined}
            />
          </a>
        ) : (
          <div class="flex h-28 w-full items-center justify-center bg-white md:h-32">
            <img
              src={logo.src}
              alt={logo.alt}
              loading="lazy"
              draggable="false"
              class="max-h-20 w-auto max-w-[95%] select-none object-contain md:max-h-24"
              style={logo.scale ? `transform: scale(${logo.scale})` : undefined}
            />
          </div>
        )}

      </div>
    ))}

  </div>

          </div>

          <CarouselControls />

        </div>

      </div>

    </div>

  </div>
</section>

