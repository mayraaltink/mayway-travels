// In de teksten: **woord** = dikgedrukt, *woord* = schuin.
// Foto's: zet ze in /public/images/blogs/ met de namen hieronder. Ontbreekt een foto, dan toont het vlak een turquoise placeholder.
import fs from 'node:fs';
import path from 'node:path';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'nl') as 'nl' | 'en';

function imageSrc(src: string) {
  return fs.existsSync(path.join(process.cwd(), 'public', src)) ? src : null;
}

// Tekst veilig omzetten naar HTML met **dik** en *schuin*
function rich(text: string) {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*\*(.+?)\*\*\*/g, '<strong class="font-semibold text-gray-900"><em>$1</em></strong>')
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');
}

