---
// src/components/ui/Portfolio.astro
// Mini-portfolio: uitgelichte video's + meer content als Reel-kaarten (ReelCard.astro).
// Met een eigen videobestand speelt de kaart af als een Reel; zonder linkt hij naar de Instagram-post.
// Projecten staan in src/data/portfolio.ts.
// variant="full" (For Brands): alles. variant="home" (homepagina): de 3 met home: true + knop naar For Brands.
// Ontbreekt een cover, dan toont de kaart een turquoise placeholder met de merknaam.
import fs from 'node:fs';
import path from 'node:path';
import { ui, defaultLang } from '../../i18n/ui';
import { featured as allFeatured, more as allMore } from '../../data/portfolio';
import CarouselControls from './CarouselControls.astro';
import ReelCard from './ReelCard.astro';

const { variant = 'full' } = Astro.props as { variant?: 'full' | 'home' };
const isHome = variant === 'home';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

function coverSrc(file: string) {
  const exists = fs.existsSync(path.join(process.cwd(), 'public/images/portfolio', file));
  return exists ? `/images/portfolio/${file}` : null;
}

// eigen videobestand in public/videos/portfolio/ (alleen als het bestand er echt staat)
function videoSrc(file?: string) {
  if (!file) return null;
  const exists = fs.existsSync(path.join(process.cwd(), 'public/videos/portfolio', file));
  return exists ? `/videos/portfolio/${file}` : null;
}

const featured = (isHome ? allFeatured.filter((item) => item.home).slice(0, 3) : allFeatured)
  .map((item) => ({ ...item, src: coverSrc(item.cover), videoUrl: videoSrc(item.video) }));

// Overige content: kleinere reels onder de uitgelichte video's (linken naar Instagram)
const more = isHome ? [] : allMore.map((item) => ({ ...item, src: coverSrc(item.cover), videoUrl: videoSrc(item.video) }));

// Daaronder (alleen For Brands): YouTube-video, hier te vervangen door een ander video-ID
const youtubeId = 'qBYOvEy_rAE';


// Vaste classnames zodat Tailwind ze vindt
const featuredCols = { 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5' }[featured.length] ?? 'lg:grid-cols-4';
---

<section id={isHome ? 'projects' : 'portfolio'} class="scroll-mt-20 bg-[#0F7C82] py-16 text-white md:py-28">
  <div data-carousel class:list={['mx-auto px-6', isHome ? 'max-w-5xl' : 'max-w-6xl']}>

    <!-- Kop -->
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-white/80">{t('portfolio.eyebrow')}</p>
      <h2 class="mt-3 text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl">{t('portfolio.title')}</h2>
    </div>

    <!-- Uitgelichte video's (staand, zoals Reels). Mobiel: swipen, desktop: rij -->
    <div data-carousel-track class:list={['-mx-6 mt-12 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-2 md:mt-14 md:gap-4 lg:mx-0 lg:grid lg:overflow-visible lg:px-0 lg:pb-0', featuredCols]}>
      {featured.map((item, i) => (
        <ReelCard
          href={item.href}
          cover={item.src}
          video={item.videoUrl}
          views={item.views}
          brand={item.brand}
          title={item.title}
          viewLabel={t('portfolio.view')}
          class:list={['w-full shrink-0 snap-center sm:w-[40%] sm:snap-start lg:w-auto', { 'lg:translate-y-8': i % 2 === 1 }]}
        />
      ))}
    </div>
    <CarouselControls tone="light" class="lg:hidden" />

    <!-- Alleen For Brands: links de 4K-video van YouTube (privacyvriendelijke embed, cookies pas bij afspelen),
         rechts twee blokken onder elkaar die naar Instagram linken. Mobiel: blokken onder de video, naast elkaar. -->
    {!isHome && (
      <div class="mt-14 grid gap-3 md:mt-20 md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)] md:gap-4">
        <div class="relative aspect-video overflow-hidden rounded-[1.75rem] bg-black/20 shadow-[0_30px_60px_rgba(0,0,0,0.25)] md:rounded-[2rem]">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`}
            title="MAY WAYS – 4K video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="absolute inset-0 h-full w-full"
          ></iframe>
        </div>

        {more.length > 0 && (
          <div class="grid grid-cols-2 gap-3 md:grid-cols-1 md:grid-rows-2 md:gap-4">
            {more.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t('portfolio.view')}
                class="group relative block aspect-[4/5] overflow-hidden rounded-2xl bg-[#1CABB0] shadow-lg md:aspect-auto md:h-full"
              >
                {item.src && (
                  <img src={item.src} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                )}
                <div class="absolute inset-0 bg-black/20 transition group-hover:bg-black/35"></div>
                <!-- Icoon van het platform: TikTok of Instagram (afhankelijk van de link) -->
                <span class="absolute inset-0 flex items-center justify-center text-white">
                  {item.href.includes('tiktok.com') ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="drop-shadow transition group-hover:scale-110"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drop-shadow transition group-hover:scale-110"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
                  )}
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    )}


    <!-- CTA -->
    <div class:list={['flex flex-wrap items-center justify-center gap-4', isHome ? 'mt-12 lg:mt-20' : 'mt-14']}>
      {isHome ? (
        <a
          href={`/${lang}/for-brands#portfolio`}
          class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 text-sm font-semibold text-[#15939a] transition hover:bg-[#E6F6F6]"
        >
          {t('portfolio.all')}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      ) : (
      <a
        href="https://www.instagram.com/mayraaltink/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 text-sm font-semibold text-[#15939a] transition hover:bg-[#E6F6F6]"
      >
        {t('portfolio.cta')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
      </a>
      )}
      {!isHome && (
        <a
          href={`/${lang}/contact`}
          class="inline-flex items-center gap-2 rounded-full border-2 border-white/40 px-7 py-2.5 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
        >
          {t('portfolio.contact')}
        </a>
      )}
    </div>
  </div>

</section>



