---
// src/components/ui/CommunityMoments.astro
// "Jullie momenten": goedgekeurde inzendingen van volgers + formulier om zelf een moment te delen.
// Werkt via de Cloudflare Pages Functions in functions/api/ (zie db/schema.sql).
// Lokaal met `astro dev` draaien die functions niet; dan toont het blok de lege staat.
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

// Teksten die het script nodig heeft
const messages = {
  sending: t('cmoments.form.sending'),
  error: t('cmoments.form.error'),
  size: t('cmoments.form.errorSize'),
};
---

<section id="community-moments" class="scroll-mt-20 bg-[#FFFDFA] px-3 py-16 md:px-6 md:py-24">
  <!-- Wit vlak, zoals een Instagram-feed -->
  <div class="mx-auto max-w-7xl rounded-[2.5rem] bg-white py-14 shadow-[0_20px_60px_rgba(0,0,0,0.06)] ring-1 ring-black/5 md:rounded-[3.5rem] md:py-20">
  <div class="mx-auto max-w-4xl px-4 md:px-6">

    <!-- Profielkop in Instagram-stijl -->
    <div class="flex flex-col items-center gap-6 border-b border-black/10 pb-8 text-center md:flex-row md:items-center md:gap-10 md:pb-10 md:text-left">
      <!-- Avatar met turquoise ring -->
      <div class="shrink-0 rounded-full bg-gradient-to-tr from-[#1CABB0] via-[#4ED2CE] to-[#B8EDEB] p-[3px]">
        <div class="flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-white md:h-28 md:w-28">
          <span class="font-neucha text-2xl font-bold leading-none text-[#4ED2CE] md:text-3xl">MW</span>
        </div>
      </div>

      <div class="flex-1">
        <div class="flex flex-col items-center gap-3 md:flex-row md:gap-5">
          <h2 class="text-2xl font-semibold tracking-tight text-black md:text-3xl">{t('cmoments.title')}</h2>
          <button
            type="button"
            data-open-share
            class="inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#15939a]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
            {t('cmoments.cta')}
          </button>
        </div>
        <p class="mt-2 text-sm text-gray-500">
          <span id="cmoments-count" class="font-semibold text-gray-900">0</span> {t('cmoments.count')} · #maywaymoments
        </p>
        <p class="mt-3 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">{t('cmoments.intro')}</p>
      </div>
    </div>

    <!-- Feed: "+"-tegel eerst, daarna de momenten (worden geladen) -->
    <div id="cmoments-grid" class="mt-1 grid grid-cols-3 gap-1 md:mt-2 md:gap-2">
      <button
        type="button"
        data-open-share
        class="group flex aspect-square flex-col items-center justify-center gap-2 bg-[#E6F6F6] text-[#1CABB0] transition hover:bg-[#D2EFED] md:gap-3"
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-[#1CABB0] transition group-hover:scale-110 md:h-14 md:w-14">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        </span>
        <span class="px-2 text-xs font-semibold md:text-sm">{t('cmoments.cta')}</span>
      </button>

      <!-- Plaatshouders zolang er nog niets is goedgekeurd -->
      {Array.from({ length: 5 }).map(() => (
        <div data-placeholder class="flex aspect-square items-center justify-center bg-[#F4FBFB]">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-opacity="0.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
        </div>
      ))}
    </div>

    <p id="cmoments-empty" class="mt-6 text-center text-sm text-gray-500">{t('cmoments.empty.text')}</p>
  </div>
  </div>

  <!-- Moment groot bekijken -->
  <dialog id="moment-dialog" class="m-auto w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-[1.5rem] p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm">
    <div class="grid md:grid-cols-[1.2fr_1fr]">
      <img id="moment-photo" alt="" class="aspect-square w-full bg-gray-100 object-cover" />
      <div class="relative flex flex-col p-6 md:p-7">
        <button type="button" data-close-moment class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <p id="moment-name" class="pr-10 font-semibold text-gray-900"></p>
        <p id="moment-location" class="mt-0.5 text-xs uppercase tracking-[0.15em] text-[#1CABB0]"></p>
        <p id="moment-story" class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-gray-700"></p>
      </div>
    </div>
  </dialog>

  <!-- Formulier (pop-up) -->
  <dialog id="share-dialog" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-[1.75rem] p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
    <form id="share-form" class="relative p-6 md:p-8" novalidate>
      <button type="button" data-close-share class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>

      <div data-form-fields>
        <h3 class="pr-10 text-2xl font-semibold tracking-tight text-black">{t('cmoments.form.title')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">{t('cmoments.form.intro')}</p>

        <!-- Foto -->
        <label class="mt-6 flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-[#1CABB0]/30 bg-[#F4FBFB] text-center transition hover:border-[#1CABB0]">
          <img id="share-preview" alt="" class="hidden aspect-[4/3] w-full object-cover" />
          <span id="share-photo-label" class="flex flex-col items-center gap-2 px-4 py-8 text-sm text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
            <span class="font-semibold text-gray-900">{t('cmoments.form.photo')}</span>
            <span class="text-xs">{t('cmoments.form.photoHint')}</span>
          </span>
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required class="sr-only" />
        </label>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <input name="name" required maxlength="60" placeholder={t('cmoments.form.name')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
          <input name="location" required maxlength="80" placeholder={t('cmoments.form.location')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
        </div>
        <textarea name="story" required maxlength="600" rows="4" placeholder={t('cmoments.form.story')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]"></textarea>
        <input name="instagram" maxlength="40" placeholder={t('cmoments.form.instagram')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />

        <!-- Spam-val: onzichtbaar voor mensen -->
        <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <label class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-gray-600">
          <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#1CABB0]" />
          {t('cmoments.form.consent')}
        </label>

        <p id="share-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></p>

        <button type="submit" class="mt-6 w-full rounded-full bg-[#1CABB0] px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-[#15939a] disabled:opacity-60">
          {t('cmoments.form.submit')}
        </button>
      </div>

      <!-- Bedankt -->
      <div data-form-thanks class="hidden py-6 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0]">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
        </div>
        <h3 class="mt-5 text-2xl font-semibold tracking-tight text-black">{t('cmoments.thanks.title')}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-600">{t('cmoments.thanks.text')}</p>
        <button type="button" data-close-share class="mt-6 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]">
          {t('cmoments.form.close')}
        </button>
      </div>
    </form>
  </dialog>
</section>

<script define:vars={{ messages }}>
  const grid = document.getElementById('cmoments-grid');
  const empty = document.getElementById('cmoments-empty');
  const dialog = document.getElementById('share-dialog');
  const form = document.getElementById('share-form');
  const errorBox = document.getElementById('share-error');
  const preview = document.getElementById('share-preview');
  const photoLabel = document.getElementById('share-photo-label');
  const fields = form.querySelector('[data-form-fields]');
  const thanks = form.querySelector('[data-form-thanks]');
  const submit = form.querySelector('button[type="submit"]');
  const submitText = submit.textContent;

  const escape = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Goedgekeurde momenten laden en als feed-tegels tonen (na de "+"-tegel)
  const momentDialog = document.getElementById('moment-dialog');
  let moments = [];

  fetch('/api/moments')
    .then((r) => (r.ok ? r.json() : []))
    .catch(() => [])
    .then((items) => {
      if (!Array.isArray(items) || items.length === 0) return;
      moments = items;

      grid.querySelectorAll('[data-placeholder]').forEach((el) => el.remove());
      empty.hidden = true;
      document.getElementById('cmoments-count').textContent = items.length;

      grid.insertAdjacentHTML('beforeend', items.map((m, i) => `
        <button type="button" data-moment="${i}" class="group relative block aspect-square overflow-hidden bg-gray-100">
          <img src="${escape(m.photo)}" alt="${escape(m.location)}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class="absolute inset-0 flex flex-col items-center justify-center gap-1 bg-black/0 p-3 text-center text-white opacity-0 transition group-hover:bg-black/45 group-hover:opacity-100">
            <span class="text-xs uppercase tracking-[0.15em]">${escape(m.location)}</span>
            <span class="text-sm font-semibold">${escape(m.name)}</span>
          </span>
        </button>`).join(''));
    });

  // Moment groot openen
  grid.addEventListener('click', (e) => {
    const tile = e.target.closest('[data-moment]');
    if (!tile) return;
    const m = moments[Number(tile.dataset.moment)];
    document.getElementById('moment-photo').src = m.photo;
    document.getElementById('moment-location').textContent = m.location;
    document.getElementById('moment-story').textContent = m.story;
    document.getElementById('moment-name').innerHTML = escape(m.name) + (m.instagram
      ? ` <a href="https://www.instagram.com/${encodeURIComponent(m.instagram)}/" target="_blank" rel="noopener noreferrer" class="font-normal text-[#1CABB0] hover:underline">@${escape(m.instagram)}</a>`
      : '');
    momentDialog.showModal();
  });
  momentDialog.querySelector('[data-close-moment]').addEventListener('click', () => momentDialog.close());
  momentDialog.addEventListener('click', (e) => { if (e.target === momentDialog) momentDialog.close(); });

  // Pop-up openen en sluiten
  document.querySelectorAll('[data-open-share]').forEach((btn) => btn.addEventListener('click', () => dialog.showModal()));
  form.querySelectorAll('[data-close-share]').forEach((btn) => btn.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    if (!thanks.classList.contains('hidden')) {
      form.reset();
      preview.classList.add('hidden');
      photoLabel.classList.remove('hidden');
      fields.classList.remove('hidden');
      thanks.classList.add('hidden');
    }
  });

  // Fotovoorbeeld
  form.photo.addEventListener('change', () => {
    const file = form.photo.files[0];
    if (!file) return;
    preview.src = URL.createObjectURL(file);
    preview.classList.remove('hidden');
    photoLabel.classList.add('hidden');
  });

  // Versturen
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (form.photo.files[0].size > 5 * 1024 * 1024) {
      errorBox.textContent = messages.size;
      errorBox.classList.remove('hidden');
      return;
    }

    submit.disabled = true;
    submit.textContent = messages.sending;
    try {
      const res = await fetch('/api/moments', { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error();
      fields.classList.add('hidden');
      thanks.classList.remove('hidden');
    } catch {
      errorBox.textContent = messages.error;
      errorBox.classList.remove('hidden');
    } finally {
      submit.disabled = false;
      submit.textContent = submitText;
    }
  });
</script>
