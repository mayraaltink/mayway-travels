---
import BaseLayout from "../../layouts/BaseLayout.astro";
import headerImg from "../../assets/Header.avif";
import { ui, defaultLang } from '../../i18n/ui';
import BlogGrid from "./BlogGrid.astro";

import MayWayMoments from "./MayWayMoments.astro";

const pathLang = Astro.url.pathname.split('/')[1];

const lang =
  pathLang === 'nl' || pathLang === 'en'
    ? pathLang
    : defaultLang;

function t(key: keyof typeof ui[typeof defaultLang]) {
  const dict = ui[lang as keyof typeof ui] ?? ui[defaultLang];
  return dict[key];
}
---

<BaseLayout>
  <section class="relative bg-[#FFFDFA]">

    <!-- HERO -->
    <div class="relative h-screen flex items-center justify-center overflow-hidden -mt-16 rounded-b-[80px]">

      <!-- GRADIENT -->
      <div class="absolute inset-0 bg-gradient-to-b from-gray-900/60 via-gray-900/30 to-transparent z-10"></div>

      <!-- IMAGE -->
<img
  src="/images/australia/aus_main.jpg"
  alt="Australia"
  class="absolute inset-0 z-0 h-full w-full object-cover"
/>


      <!-- CONTENT -->
      <div class="relative z-20 text-center text-white max-w-3xl px-6">

        <!-- PREHEADER -->
        <p class="uppercase tracking-[0.2em] text-xs md:text-xs text-white/80 mb-4">
          {t('community.preheader')}
        </p>

        <!-- TITLE -->
        <h1 class="flex flex-col leading-[0.85] tracking-[-0.03em]">

          <span class="text-xl md:text-5xl font-medium text-white">
            {t('community.titlePart1')}
          </span>

          <span class="text-3xl md:text-5xl font-semibold text-white">
            {t('community.titleHighlight')}
          </span>

        </h1>

        <!-- CTA'S -->
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center sm:items-center">

          <!-- PRIMARY -->
          <a
            href="#blogs"
            class="inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-8 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#15939a]"
          >
            {t('community.ctaBlogs')}

            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <!-- SECONDARY -->
          <a
            href="#webinars"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white"
          >
            {t('community.ctaEvents')}

            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

        </div>

      </div>
    </div>
  </section>

  
  <!-- DESTINATIONS -->
  <section class="bg-[#FFFDFA] px-6 py-20 md:py-28">
    <div class="mx-auto max-w-7xl">

      <!-- SECTION HEADER -->
      <div class="mb-12 text-center">
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-[#1CABB0]">
          Ontdek jouw volgende avontuur
        </p>

        <h2 class="text-3xl font-semibold tracking-tight text-gray-900 md:text-5xl">
          Waar gaat jouw reis naartoe?
        </h2>

        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-600">
          Van roadtrips door Australië tot tropische eilanden in Fiji.
          Laat je inspireren en ontdek wat bij jouw manier van reizen past.
        </p>
      </div>

      <!-- DESTINATION CARDS -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

        <!-- AUSTRALIA -->
        <a
  href={`/${lang}/destinations/australia/`}
  class="group relative isolate min-h-[420px] overflow-hidden rounded-3xl"
>
          <img
            src="/images/travel-plan/Sydney.jpg"
            alt="Sydney, Australië"
            loading="lazy"
            class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

          <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-10">
            <p class="mb-3 text-xs uppercase tracking-[0.18em] text-white/80">
              Sydney · Roadtrip · East Coast
            </p>

            <h3 class="text-3xl font-semibold md:text-4xl">
              Australië
            </h3>

            <p class="mt-3 max-w-md text-sm leading-relaxed text-white/90 md:text-base">
              Roadtrips, surfstranden, nationale parken en bruisende steden.
              Ontdek Australië op jouw manier.
            </p>

            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold">
              Ontdek Australië
              <span class="transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </span>
          </div>
        </a>

        <!-- FIJI -->
 <a
  href={`/${lang}/destinations/fiji/`}
  class="group relative isolate min-h-[420px] overflow-hidden rounded-3xl"
>
          <img
            src="/images/travel-plan/Fiji.jpg"
            alt="Tropische eilanden van Fiji"
            loading="lazy"
            class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

          <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-10">
            <p class="mb-3 text-xs uppercase tracking-[0.18em] text-white/80">
              Eilanden · Snorkelen · Paradise
            </p>

            <h3 class="text-3xl font-semibold md:text-4xl">
              Fiji
            </h3>

            <p class="mt-3 max-w-md text-sm leading-relaxed text-white/90 md:text-base">
              Tropische eilanden, snorkelen, witte stranden en ultieme relax vibes.
              Ontdek het paradijs in de Stille Oceaan.
            </p>

            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold">
              Ontdek Fiji
              <span class="transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>
 

  <BlogGrid />
  <MayWayMoments />


</BaseLayout>