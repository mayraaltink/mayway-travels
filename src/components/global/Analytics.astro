---
// Google Analytics (GA4) + cookie-popup "Beheer toestemming" (midden in beeld).
// GA wordt pas geladen nadat de bezoeker statistieken toestaat (AVG-proof).
// De keuze wordt onthouden in de browser (localStorage: 'mw-cookie-consent' = 'granted' | 'denied').
// De link "Cookie-instellingen" in de footer wist de keuze, zodat deze popup opnieuw verschijnt.
export interface Props {
  lang?: 'nl' | 'en';
}

const GA_ID = 'G-YL718PF28L';
const { lang = 'nl' } = Astro.props;
const t = lang === 'en'
  ? {
      title: 'Manage consent',
      text: 'We use functional and analytical cookies to optimise MAY WAYS and improve your experience.',
      accept: 'Accept cookies',
      deny: 'Functional only',
      prefs: 'View preferences',
      save: 'Save preferences',
      close: 'Close',
      functional: 'Functional',
      functionalText: 'Needed for the website to work properly.',
      always: 'Always active',
      stats: 'Statistics',
      statsText: 'Helps us understand how visitors use the website (Google Analytics).',
    }
  : {
      title: 'Beheer toestemming',
      text: 'Wij gebruiken functionele en analytische cookies om MAY WAYS te optimaliseren en je ervaring te verbeteren.',
      accept: 'Cookies accepteren',
      deny: 'Alleen functioneel',
      prefs: 'Bekijk voorkeuren',
      save: 'Voorkeuren opslaan',
      close: 'Sluiten',
      functional: 'Functioneel',
      functionalText: 'Nodig om de website goed te laten werken.',
      always: 'Altijd actief',
      stats: 'Statistieken',
      statsText: 'Helpt ons te zien hoe bezoekers de website gebruiken (Google Analytics).',
    };
---

<div id="mw-cookie-banner" class="mw-cookie" hidden>
  <div class="mw-cookie__box" role="dialog" aria-modal="true" aria-labelledby="mw-cookie-title">
    <div class="mw-cookie__head">
      <p id="mw-cookie-title" class="mw-cookie__title">{t.title}</p>
      <button type="button" data-action="deny" class="mw-cookie__close" aria-label={t.close}>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
      </button>
    </div>
    <p class="mw-cookie__text">{t.text}</p>

    <!-- Voorkeuren (verborgen tot "Bekijk voorkeuren") -->
    <div id="mw-cookie-prefs" class="mw-cookie__prefs" hidden>
      <div class="mw-cookie__row">
        <div>
          <p class="mw-cookie__label">{t.functional}</p>
          <p class="mw-cookie__small">{t.functionalText}</p>
        </div>
        <span class="mw-cookie__always">{t.always}</span>
      </div>
      <div class="mw-cookie__row">
        <div>
          <p class="mw-cookie__label"><label for="mw-cookie-stats">{t.stats}</label></p>
          <p class="mw-cookie__small">{t.statsText}</p>
        </div>
        <label class="mw-switch">
          <input id="mw-cookie-stats" type="checkbox" checked />
          <span class="mw-switch__slider" aria-hidden="true"></span>
        </label>
      </div>
    </div>

    <div class="mw-cookie__buttons">
      <button type="button" data-action="accept" class="mw-cookie__btn">{t.accept}</button>
      <button type="button" data-action="deny" data-main-view class="mw-cookie__btn mw-cookie__btn--light">{t.deny}</button>
      <button type="button" data-action="prefs" data-main-view class="mw-cookie__btn mw-cookie__btn--light">{t.prefs}</button>
      <button type="button" data-action="save" class="mw-cookie__btn mw-cookie__btn--light" hidden>{t.save}</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  (function () {
    var KEY = 'mw-cookie-consent';

    function loadGA() {
      if (window.__mwGaLoaded) return;
      window.__mwGaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    }

    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}
    if (choice === 'granted') { loadGA(); return; }
    if (choice === 'denied') return;

    function showPopup() {
      var popup = document.getElementById('mw-cookie-banner');
      if (!popup) return;
      var prefs = document.getElementById('mw-cookie-prefs');
      var stats = document.getElementById('mw-cookie-stats');
      var saveBtn = popup.querySelector('[data-action="save"]');
      var mainViewBtns = popup.querySelectorAll('[data-main-view]');

      popup.hidden = false;

      function close(value) {
        try { localStorage.setItem(KEY, value); } catch (err) {}
        popup.hidden = true;
        if (value === 'granted') loadGA();
      }

      popup.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-action]');
        if (!btn) return;
        var action = btn.getAttribute('data-action');
        if (action === 'accept') close('granted');
        if (action === 'deny') close('denied');
        if (action === 'save') close(stats.checked ? 'granted' : 'denied');
        if (action === 'prefs') {
          prefs.hidden = false;
          saveBtn.hidden = false;
          mainViewBtns.forEach(function (b) { b.hidden = true; });
        }
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', showPopup);
    else showPopup();
  })();
</script>

<style>
  .mw-cookie {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
  }
  .mw-cookie[hidden],
  .mw-cookie [hidden] { display: none; }

  .mw-cookie__box {
    pointer-events: auto;
    width: 100%;
    max-width: 520px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding: 18px 20px 20px;
    background: #fff;
    color: #1f2937;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    text-align: center;
    font-size: 12px;
    line-height: 1.6;
  }
  .mw-cookie__head { position: relative; margin-bottom: 14px; }
  .mw-cookie__title { margin: 0; padding: 0 28px; font-size: 14px; font-weight: 500; color: #111827; }
  .mw-cookie__close {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    padding: 4px;
    background: none;
    border: 0;
    color: #111827;
    cursor: pointer;
  }
  .mw-cookie__text { margin: 0 auto 20px; max-width: 400px; color: #374151; }

  .mw-cookie__prefs { margin: 0 0 18px; text-align: left; }
  .mw-cookie__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    margin-bottom: 6px;
    background: #F3F4F6;
    border-radius: 8px;
  }
  .mw-cookie__label { margin: 0; font-size: 13px; font-weight: 600; color: #111827; }
  .mw-cookie__small { margin: 0; font-size: 11px; color: #6b7280; }
  .mw-cookie__always { flex-shrink: 0; font-size: 11px; font-weight: 600; color: #1CABB0; }

  .mw-switch { position: relative; flex-shrink: 0; width: 38px; height: 22px; cursor: pointer; }
  .mw-switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .mw-switch__slider {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: #d1d5db;
    transition: background 0.2s;
    pointer-events: none;
  }
  .mw-switch__slider::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s;
  }
  .mw-switch input:checked + .mw-switch__slider { background: #1CABB0; }
  .mw-switch input:checked + .mw-switch__slider::before { transform: translateX(16px); }
  .mw-switch input:focus-visible + .mw-switch__slider { outline: 3px solid #f59e0b; outline-offset: 2px; }

  .mw-cookie__buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .mw-cookie__btn {
    flex: 1 1 140px;
    padding: 10px 12px;
    border: 0;
    border-radius: 6px;
    background: #1CABB0;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .mw-cookie__btn:hover { background: #15939a; }
  .mw-cookie__btn--light { background: #F3F4F6; color: #1CABB0; }
  .mw-cookie__btn--light:hover { background: #E6F6F6; color: #15939a; }
  .mw-cookie__btn:focus-visible,
  .mw-cookie__close:focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
</style>
