---
// src/components/ui/MayWayMomentsStories.astro
// MAY WAY Moments als Instagram-achtige story-cirkels. Klik op een cirkel → schermvullende story.
// Proefversie: de vorige versie (swipe met kaarten) staat nog in MayWayMoments.astro.
// Terugzetten: vervang in CommunityContent.astro <MayWayMomentsStories /> door <MayWayMoments />.
// De momenten zelf staan in src/data/moments.ts (zelfde bestand voor beide versies).
import fs from 'node:fs';
import path from 'node:path';
import { ui, defaultLang } from '../../i18n/ui';
import { moments as allMoments } from '../../data/moments';
import CarouselControls from './CarouselControls.astro';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

const moments = allMoments.map((m) => ({
  src: fs.existsSync(path.join(process.cwd(), 'public', m.image)) ? m.image : null,
  title: m.title[lang],
  location: m.location,
  // Korte naam onder de cirkel: eerste deel van de plek
  label: m.location.split(',')[0],
  story: m.story[lang],
}));
---

<section id="moments" class="mt-16 scroll-mt-20 bg-[#E6F6F6] py-16 md:mt-24 md:py-24">
  <div data-carousel class="mx-auto max-w-7xl">

    <!-- Kop -->
    <div class="px-6 md:px-10">
      <h2 class="text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">{t('moments.title')}</h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">{t('moments.intro')}</p>
    </div>

    <!-- Story-cirkels -->
    <div data-carousel-track class="mt-10 flex snap-x gap-4 overflow-x-auto scroll-smooth px-6 pb-2 md:mt-12 md:gap-6 md:px-10">
      {moments.map((moment, i) => (
        <button type="button" data-story-open={i} class="group flex w-[5.5rem] shrink-0 snap-start flex-col items-center gap-2 md:w-28">
          <span class="block rounded-full bg-gradient-to-tr from-[#1CABB0] via-[#4ED2CE] to-[#B8EDEB] p-[3px] transition duration-300 group-hover:scale-105">
            <span class="block h-20 w-20 overflow-hidden rounded-full border-[3px] border-[#E6F6F6] bg-gradient-to-br from-[#0F7C82] to-[#084649] md:h-[6.25rem] md:w-[6.25rem]">
              {moment.src && <img src={moment.src} alt="" loading="lazy" draggable="false" class="h-full w-full object-cover" />}
            </span>
          </span>
          <span class="w-full truncate text-center text-xs font-medium text-gray-700 md:text-sm">{moment.label}</span>
        </button>
      ))}
    </div>

    <CarouselControls />
  </div>

  <!-- Story-weergave (schermvullend) -->
  <dialog id="story-viewer" class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/90">
    <div class="flex h-full w-full items-center justify-center gap-4 p-0 md:p-6">

      <!-- Vorige (desktop) -->
      <button type="button" data-story-prev class="hidden h-10 w-10 shrink-0 items-center justify-center text-white/70 transition hover:text-white md:flex" aria-label="Vorige">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>

      <!-- Story -->
      <div class="relative h-full w-full overflow-hidden bg-gradient-to-br from-[#0F7C82] to-[#084649] md:aspect-[9/16] md:h-[min(90vh,52rem)] md:w-auto md:rounded-[1.5rem]">
        <img data-story-photo alt="" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/80"></div>

        <!-- Voortgangsbalkjes -->
        <div data-story-bars class="absolute inset-x-3 top-3 flex gap-1">
          {moments.map(() => (
            <span class="h-[3px] flex-1 overflow-hidden rounded-full bg-white/30"><span class="block h-full w-0 bg-white"></span></span>
          ))}
        </div>

        <!-- Kop: profiel + sluiten -->
        <div class="absolute inset-x-3 top-7 flex items-center gap-2.5 text-white">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white font-neucha text-xs font-bold text-[#4ED2CE]">MW</span>
          <span class="text-sm font-semibold">maywaymoments</span>
          <span data-story-location class="truncate text-xs text-white/75"></span>
          <button type="button" data-story-close class="ml-auto flex h-8 w-8 items-center justify-center text-white" aria-label={t('cmoments.form.close')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
          </button>
        </div>

        <!-- Tikzones: links = vorige, rechts = volgende -->
        <button type="button" data-story-tap="prev" class="absolute inset-y-16 left-0 w-1/3" aria-label="Vorige"></button>
        <button type="button" data-story-tap="next" class="absolute inset-y-16 right-0 w-2/3" aria-label="Volgende"></button>

        <!-- Verhaal -->
        <div class="pointer-events-none absolute inset-x-0 bottom-0 p-5 pb-8 text-white md:p-7">
          <h3 data-story-title class="text-2xl font-semibold leading-tight tracking-tight"></h3>
          <p data-story-text class="mt-3 text-[15px] leading-relaxed text-white/90"></p>
        </div>
      </div>

      <!-- Volgende (desktop) -->
      <button type="button" data-story-next class="hidden h-10 w-10 shrink-0 items-center justify-center text-white/70 transition hover:text-white md:flex" aria-label="Volgende">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>
  </dialog>
</section>

<script define:vars={{ moments }}>
  const DURATION = 7000; // hoe lang één story blijft staan (ms)

  const viewer = document.getElementById('story-viewer');
  const photo = viewer.querySelector('[data-story-photo]');
  const bars = Array.from(viewer.querySelectorAll('[data-story-bars] > span > span'));
  let current = 0;
  let timer;

  function show(i) {
    if (i < 0) i = 0;
    if (i >= moments.length) { viewer.close(); return; }
    current = i;
    const m = moments[i];

    photo.classList.toggle('hidden', !m.src);
    if (m.src) { photo.src = m.src; photo.alt = m.title; }
    viewer.querySelector('[data-story-location]').textContent = m.location;
    viewer.querySelector('[data-story-title]').textContent = m.title;
    viewer.querySelector('[data-story-text]').textContent = m.story;

    // Balkjes: eerdere vol, huidige loopt vol, latere leeg
    bars.forEach((bar, b) => {
      bar.style.transition = 'none';
      bar.style.width = b < i ? '100%' : '0%';
    });
    requestAnimationFrame(() => requestAnimationFrame(() => {
      bars[i].style.transition = `width ${DURATION}ms linear`;
      bars[i].style.width = '100%';
    }));

    clearTimeout(timer);
    timer = setTimeout(() => show(current + 1), DURATION);
  }

  document.querySelectorAll('[data-story-open]').forEach((btn) =>
    btn.addEventListener('click', () => { viewer.showModal(); show(Number(btn.dataset.storyOpen)); })
  );
  viewer.querySelector('[data-story-close]').addEventListener('click', () => viewer.close());
  viewer.querySelector('[data-story-prev]').addEventListener('click', () => show(current - 1));
  viewer.querySelector('[data-story-next]').addEventListener('click', () => show(current + 1));
  viewer.querySelectorAll('[data-story-tap]').forEach((zone) =>
    zone.addEventListener('click', () => show(current + (zone.dataset.storyTap === 'next' ? 1 : -1)))
  );
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
  viewer.addEventListener('close', () => clearTimeout(timer));
</script>
