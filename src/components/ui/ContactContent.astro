---
// src/components/ui/ContactContent.astro
// Contactpagina: links intro + pakketten-kaart + contactgegevens, rechts het formulier.
// Berichten komen per mail binnen via Web3Forms.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

const subjects = t('contact.form.subjects').split('|');

// Socials als icoontjes onder de intro (handle verschijnt bij hover)
const socials = [
  { platform: 'instagram', handle: '@maywaycommunity', href: 'https://www.instagram.com/maywaycommunity/', followers: '' },
  { platform: 'instagram', handle: '@mayraaltink', href: 'https://www.instagram.com/mayraaltink/', followers: '18.4K' },
  { platform: 'tiktok', handle: '@mayraxaltink', href: 'https://www.tiktok.com/@mayraxaltink', followers: '10.6K' },
];

const messages = {
  sending: t('contact.form.sending'),
  successTitle: t('contact.form.successTitle'),
  successText: t('contact.form.successText'),
  errorTitle: t('contact.form.errorTitle'),
  errorText: t('contact.form.errorText'),
};
---
<BaseLayout title={t('contact.title')}>
  <div class="relative z-0 flex-grow bg-[#F4FBFB] px-6 pb-20 pt-28 md:pb-28 md:pt-36">

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 md:grid-cols-[1fr_1.2fr] md:gap-20">

      <!-- Links: intro, pakketten, contactgegevens -->
      <div class="flex flex-col">
        <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('contact.eyebrow')}</p>
        <!-- Normaal + dikgedrukt accent, zelfde stijl als de andere titels op de site -->
        <h1 class="mt-3 text-4xl font-normal leading-[1.0] tracking-tight text-black md:text-5xl [&_b]:font-semibold">
          <Fragment set:html={t('contact.heading')} />
        </h1>
        <p class="mt-6 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">
          {t('contact.intro')}
        </p>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">
          {t('contact.intro2')}
        </p>

        <!-- Contact & socials: alleen icoontjes, direct onder de intro -->
        <div class="mt-8">
          <p class="text-xs uppercase tracking-[0.2em] text-[#1CABB0]">{t('forBrands.socials.title')}</p>
          <ul class="mt-4 flex items-center gap-3">
            <li>
              <a href="mailto:maywaysocials@gmail.com" title="maywaysocials@gmail.com" aria-label="E-mail maywaysocials@gmail.com" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#1CABB0] shadow-sm ring-1 ring-black/5 transition hover:bg-[#1CABB0] hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
              </a>
            </li>
            {socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer" title={social.handle} aria-label={`${social.platform === 'instagram' ? 'Instagram' : 'TikTok'} ${social.handle}`} class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#1CABB0] shadow-sm ring-1 ring-black/5 transition hover:bg-[#1CABB0] hover:text-white">
                  {social.platform === 'instagram' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Rechts: formulier -->
      <div class="relative rounded-[2rem] bg-white p-7 shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:p-12">
        <h2 class="text-2xl font-semibold tracking-tight text-black md:text-3xl">{t('contact.form.title')}</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-600">{t('contact.form.intro')}</p>

        <form id="form" class="mt-8" novalidate>
          <input type="hidden" name="access_key" value="026a1614-327e-4e4b-bdb4-d41e59fe8520" />
          <input type="hidden" name="subject" value="Nieuw bericht via de MAY WAYS website" />
          <input type="hidden" name="from_name" value="MAY WAYS website" />
          <!-- Spam-val: onzichtbaar voor mensen -->
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="naam" class="block text-sm font-semibold text-gray-900">{t('contact.form.nameLabel')}</label>
              <input type="text" id="naam" name="naam" required maxlength="80" placeholder={t('contact.form.namePlaceholder')} class="mt-2 w-full rounded-xl border border-black/10 bg-[#F8FDFC] px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0] focus:bg-white" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900">{t('contact.form.emailLabel')}</label>
              <input type="email" id="email" name="email" required maxlength="120" placeholder={t('contact.form.emailPlaceholder')} class="mt-2 w-full rounded-xl border border-black/10 bg-[#F8FDFC] px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0] focus:bg-white" />
            </div>
          </div>

          <div class="mt-5">
            <label for="bedrijf" class="block text-sm font-semibold text-gray-900">{t('contact.form.companyLabel')}</label>
            <input type="text" id="bedrijf" name="bedrijf" maxlength="80" placeholder={t('contact.form.companyPlaceholder')} class="mt-2 w-full rounded-xl border border-black/10 bg-[#F8FDFC] px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0] focus:bg-white" />
          </div>

          <!-- Onderwerp als keuzeknoppen -->
          <fieldset class="mt-5">
            <legend class="block text-sm font-semibold text-gray-900">{t('contact.form.subjectLabel')}</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {subjects.map((s, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="onderwerp" value={s} checked={i === 0} data-other={i === subjects.length - 1 ? '' : undefined} class="peer sr-only" />
                  <span class="inline-block rounded-full border border-black/10 bg-[#F8FDFC] px-4 py-2 text-sm text-gray-700 transition peer-checked:border-[#1CABB0] peer-checked:bg-[#1CABB0] peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[#1CABB0]/40">{s}</span>
                </label>
              ))}
            </div>
            <!-- Laatste keuze = zelf invullen -->
            <input type="text" id="onderwerp-anders" name="onderwerp_anders" maxlength="80" hidden placeholder={t('contact.form.otherPlaceholder')} class="mt-3 w-full rounded-xl border border-black/10 bg-[#F8FDFC] px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0] focus:bg-white" />
          </fieldset>

          <div class="mt-5">
            <label for="bericht" class="block text-sm font-semibold text-gray-900">{t('contact.form.messageLabel')}</label>
            <textarea id="bericht" name="bericht" rows="5" required maxlength="2000" placeholder={t('contact.form.messagePlaceholder')} class="mt-2 w-full rounded-xl border border-black/10 bg-[#F8FDFC] px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0] focus:bg-white"></textarea>
          </div>

          <button id="submit-btn" type="submit" class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#1CABB0] px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-[#15939a] disabled:cursor-not-allowed disabled:opacity-60">
            <span id="submit-text">{t('contact.form.submit')}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </button>
        </form>

        <!-- Melding na versturen -->
        <div id="notification-box" class="mt-6 hidden rounded-xl px-5 py-4 text-sm">
          <p id="notify-title" class="font-semibold"></p>
          <p id="notify-desc" class="mt-1"></p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script define:vars={{ messages }}>
  function setupContactForm() {
    const form = document.getElementById('form');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';

    // "Anders" gekozen → tekstveld tonen om het onderwerp zelf in te vullen
    const otherInput = document.getElementById('onderwerp-anders');
    form.querySelectorAll('input[name="onderwerp"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const isOther = radio.hasAttribute('data-other') && radio.checked;
        otherInput.hidden = !isOther;
        if (isOther) otherInput.focus();
      });
    });

    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');
    const box = document.getElementById('notification-box');
    const title = document.getElementById('notify-title');
    const desc = document.getElementById('notify-desc');
    const originalText = submitText.textContent;

    function notify(ok, heading, text) {
      box.className = ok
        ? 'mt-6 rounded-xl bg-[#E6F6F6] px-5 py-4 text-sm text-[#0F7C82]'
        : 'mt-6 rounded-xl bg-red-50 px-5 py-4 text-sm text-red-700';
      title.textContent = heading;
      desc.textContent = text;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('was-validated');
      if (!form.checkValidity()) {
        form.querySelector(':invalid')?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitText.textContent = messages.sending;
      box.classList.add('hidden');

      try {
        const data = Object.fromEntries(new FormData(form));
        data.replyto = data.email;
        // Zelf ingevuld onderwerp meesturen als onderwerp
        if (!otherInput.hidden && data.onderwerp_anders) data.onderwerp = `${data.onderwerp} ${data.onderwerp_anders}`;
        delete data.onderwerp_anders;
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error();
        notify(true, messages.successTitle, messages.successText);
        form.reset();
        otherInput.hidden = true;
        form.classList.remove('was-validated');
      } catch {
        notify(false, messages.errorTitle, messages.errorText);
      } finally {
        submitBtn.disabled = false;
        submitText.textContent = originalText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
