---
// src/components/ui/Hero.astro
// Homepagina-header: foto over de volle breedte met een teal laag, tekst in het midden, twee knoppen.
// Foto: /public/images/australia/surf-boys.jpg (tijdelijk, tot er een betere foto is; wordt ook elders gebruikt).
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;

function t(key: keyof typeof ui[typeof defaultLang]) {
  return ui[lang][key];
}
---

<section class="hero relative -mt-16 flex min-h-[100svh] overflow-hidden rounded-b-[60px] bg-[#0F7C82] md:rounded-b-[80px]">

  <!-- Foto -->
  <img
    src="/images/australia/surf-boys.jpg"
    alt="Twee surfers op de rotsen bij de golven"
    class="hero-photo absolute inset-0 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Verloop: gelijkmatig teal voor de tekst in het midden, licht bovenin voor het menu -->
  <div class="absolute inset-0 bg-[#0F7C82]/35"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(15,124,130,0.3),transparent_70%)]"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/25 to-transparent"></div>

  <!-- Inhoud -->
  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center justify-center px-6 pb-24 pt-32 text-center">
    <div class="hero-content max-w-4xl">
      <h1 class="hero-shadow flex flex-col items-center text-white">
        <!-- hoofdboodschap, gecentreerd -->
        <span class="block max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tight [text-wrap:balance] md:text-5xl">
          {t('hero.title1')}
        </span>
        <!-- handgeschreven regel, gecentreerd onder de titel -->
        <span class="font-neucha mt-3 text-2xl leading-none text-[#E8FAF9] md:mt-4 md:text-4xl">
          {t('hero.title2')}
        </span>
      </h1>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#ontdek"
          class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white bg-white px-8 py-3 text-sm font-semibold text-[#0F7C82] shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#E6F6F6]"
        >
          {t('hero.cta.primary')}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
        </a>
        <a
          href={`/${lang}/destinations`}
          class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-white hover:bg-white/10"
        >
          {t('hero.cta.secondary')}
        </a>
      </div>
    </div>
  </div>

  <!-- Locatie van de foto -->
  <a
    href="https://www.google.com/maps/search/?api=1&query=Bondi+Beach,+Sydney,+Australia"
    target="_blank"
    rel="noopener noreferrer"
    class="absolute bottom-5 right-5 z-10 flex items-center gap-2 rounded-full bg-black/20 px-3 py-1.5 text-white/90 backdrop-blur-md transition hover:bg-black/35 md:bottom-8 md:right-8 md:px-4 md:py-2"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 md:h-4 md:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    <span class="text-[10px] uppercase tracking-wide md:text-sm">Bondi Beach, Sydney</span>
  </a>

  <!-- doel van "Ontdek meer" -->
  <span id="ontdek" class="absolute bottom-0" aria-hidden="true"></span>
</section>

<style>
  /* langzaam inzoomen van de foto en tekst die omhoog komt */
  :global(html) {
    scroll-behavior: smooth;
  }
  .hero-shadow {
    text-shadow: 0 2px 18px rgba(4, 40, 42, 0.35);
  }
  .hero-photo {
    animation: hero-zoom 14s ease-out both;
  }
  .hero-content {
    animation: hero-up 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
  }
  @keyframes hero-zoom {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  @keyframes hero-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo,
    .hero-content { animation: none; }
  }
</style>
