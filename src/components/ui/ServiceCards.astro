---
// src/components/ui/ServiceCards.astro
// Fotokaarten van de drie services; elke kaart linkt naar het blok op de For Brands-pagina
import { ui, defaultLang } from '../../i18n/ui';

const lang = Astro.currentLocale || defaultLang;

function t(key: string) {
  const dict = ui[lang as keyof typeof ui] as Record<string, string>;
  return dict[key] ?? key;
}

// Foto's kun je hier vervangen
const services = [
  { num: 1, image: '/images/australia/surf-boys.jpg' },
  { num: 2, image: '/images/about/reis-specialist.jpg' },
  { num: 3, image: '/images/about/Mayra-foto.jpg' },
].map((s) => ({
  ...s,
  href: `/${lang}/for-brands#service-${s.num}`,
  title: t(`forBrands.services.${s.num}.title`),
  // Twee kernzinnen die verschijnen bij hover (teksten in ui.ts)
  text: t(`home.services.${s.num}.text`),
}));
---

<!-- Licht beige (zelfde als de paginakleur) -->
<section class="bg-[#FFFDFA] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 md:px-6">

    <!-- Kop -->
    <!-- Zelfde stijl als de titels op de Australië-pagina (bijv. "Reistips voor Australië") -->
    <h2 class="px-2 text-center text-4xl font-normal leading-[1.05] tracking-tight text-black md:px-0 md:text-left md:text-5xl">
      <span class="block">{t('forBrands.services.title1')}</span>
      <b class="block font-semibold">{t('forBrands.services.title2')}</b>
    </h2>

    <!-- Titel in beeld; tekst + knop klappen open bij hover (desktop) of als de kaart midden in beeld
         gescrold is (telefoon/tablet, via .is-active uit het script hieronder). De titel schuift dan omhoog. -->
    <div class="mt-12 grid gap-4 md:mt-16 md:grid-cols-3 md:gap-3">
      {services.map((service) => (
        <a href={service.href} data-service-card class="group relative block aspect-[4/3] overflow-hidden rounded-[2rem] md:aspect-[5/6]">
          <img
            src={service.image}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105 group-[.is-active]:scale-105"
          />
          <div class="absolute inset-0 bg-gray-900/30 transition duration-500 group-hover:bg-gray-900/60 group-focus-visible:bg-gray-900/60 group-[.is-active]:bg-gray-900/60"></div>

          <div class="relative flex h-full flex-col items-center justify-center px-6 text-center text-white md:px-8">
            <!-- vanaf tablet altijd twee regels hoog, tekst verticaal gecentreerd, zodat het midden van titels van 1 en 2 regels op één lijn ligt -->
            <h3 class="text-2xl font-semibold leading-tight tracking-tight md:flex md:min-h-[2.5em] md:items-center md:justify-center md:text-3xl">{service.title}</h3>

            <div class="grid grid-rows-[0fr] opacity-0 transition-all duration-500 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-visible:grid-rows-[1fr] group-focus-visible:opacity-100 group-[.is-active]:grid-rows-[1fr] group-[.is-active]:opacity-100">
              <div class="overflow-hidden">
                <p class="mx-auto mt-5 max-w-xs text-[15px] leading-relaxed text-white/90 md:text-base">
                  {service.text}
                </p>
                <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#1CABB0] px-7 py-2.5 text-sm font-semibold text-white transition group-hover:bg-[#15939a]">
                  {t('home.services.more')}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // Apparaten zonder muis (telefoon/tablet): kaart klapt open zodra hij midden in beeld staat,
  // en weer dicht als je verder scrolt. Met muis gebeurt dit via hover.
  const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  if (window.matchMedia('(hover: none)').matches) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('is-active', e.isIntersecting)),
        // alleen de middelste strook van het scherm telt
        { rootMargin: '-35% 0px -35% 0px' },
      );
      cards.forEach((card) => observer.observe(card));
    } else {
      cards.forEach((card) => card.classList.add('is-active'));
    }
  }
</script>
