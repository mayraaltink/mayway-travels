---
// src/components/ui/CommunityMoments.astro
// "Jullie momenten": goedgekeurde inzendingen van volgers + formulier om zelf een moment te delen.
// Werkt via de Cloudflare Pages Functions in functions/api/ (zie db/schema.sql).
// Lokaal met `astro dev` draaien die functions niet; dan toont het blok de lege staat.
import { ui, defaultLang } from '../../i18n/ui';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

// Teksten die het script nodig heeft
const messages = {
  sending: t('cmoments.form.sending'),
  error: t('cmoments.form.error'),
  photo: t('cmoments.form.errorPhoto'),
  isNew: t('cmoments.new'),
};

// Melding per mail bij een nieuwe inzending (zelfde Web3Forms-sleutel als het contactformulier)
const notify = {
  accessKey: '026a1614-327e-4e4b-bdb4-d41e59fe8520',
  adminUrl: `${Astro.url.origin}/beheer`,
};
---

<section id="community-moments" class="scroll-mt-20 bg-[#FFFDFA] px-3 py-16 md:px-6 md:py-24">
  <!-- Wit vlak (relative: de iPhone hangt over de overgang met MAY Moments erboven) -->
  <div class="relative mx-auto flex max-w-7xl flex-col rounded-[2.5rem] bg-white py-12 shadow-[0_20px_60px_rgba(0,0,0,0.06)] ring-1 ring-black/5 md:block md:rounded-[3.5rem] md:py-16">

    <!-- iPhone als knop om te delen: desktop half over de overgang, mobiel onderaan het blok -->
    <button type="button" data-open-share aria-label={t('cmoments.cta')} class="group z-20 order-last mx-auto mt-12 flex items-center gap-4 md:absolute md:-top-44 md:right-10 md:mx-0 md:mt-0 lg:right-16">
      <span class="hidden text-lg font-semibold leading-tight text-[#1CABB0] md:mt-24 md:block md:text-right">{t('cmoments.cta')}<br />→</span>

      <span class="relative block rotate-6 rounded-[2rem] bg-gray-900 p-2 shadow-[0_30px_50px_rgba(15,124,130,0.35)] transition duration-300 group-hover:rotate-0 group-hover:scale-105">
        <span class="relative flex h-[19rem] w-[9.5rem] flex-col overflow-hidden rounded-[1.5rem] bg-white">
          <span class="absolute left-1/2 top-1.5 h-3 w-12 -translate-x-1/2 rounded-full bg-gray-900"></span>
          <span class="pt-6 text-center text-[0.6rem] font-semibold text-gray-900">maywaycommunity</span>
          <span class="mt-2 flex items-center gap-2 px-2.5">
            <span class="shrink-0 rounded-full bg-gradient-to-tr from-[#1CABB0] via-[#4ED2CE] to-[#B8EDEB] p-[2px]">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-white font-neucha text-[0.6rem] font-bold text-[#4ED2CE]">MW</span>
            </span>
            <span class="text-[0.6rem] font-semibold leading-tight text-gray-900">YOUR Moments</span>
          </span>
          <span class="mx-2.5 mt-2.5 rounded-md bg-[#1CABB0] py-1.5 text-center text-[0.6rem] font-semibold text-white transition group-hover:bg-[#15939a]">+ {t('cmoments.cta')}</span>
          <span class="mt-2.5 grid grid-cols-3 gap-px border-t border-black/10">
            <span class="flex aspect-square items-center justify-center bg-[#E6F6F6] text-sm font-bold text-[#1CABB0]">+</span>
            <img src="/images/australia/surf-boys.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/about/great-ocean-road.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/australia/unnamed.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/travel-plan/Sydney.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/australia/aus_main.webp" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/about/sydney-opera.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/about/Mayra-foto.jpg" alt="" class="aspect-square w-full object-cover" />
            <img src="/images/about/reis-specialist.jpg" alt="" class="aspect-square w-full object-cover" />
          </span>
        </span>
      </span>
    </button>

  <div class="mx-auto max-w-5xl px-4 md:px-8">

    <!-- Kop -->
    <div class="text-center md:pr-64 md:text-left lg:pr-72">
      <h2 class="text-4xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">{t('cmoments.title')}</h2>
      <p class="mx-auto mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:mx-0 md:text-base">{t('cmoments.intro')}</p>
    </div>

    <!-- Fotofeed: "+"-tegel eerst, daarna de momenten (worden geladen) -->
    <div id="cmoments-grid" class="mt-10 grid grid-cols-3 gap-2 sm:grid-cols-4 md:mt-12 md:gap-3 lg:grid-cols-6">
      <button
        type="button"
        data-open-share
        class="group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-[#1CABB0]/40 bg-[#E6F6F6] text-[#1CABB0] transition hover:border-[#1CABB0] hover:bg-[#D2EFED]"
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-[#1CABB0] transition group-hover:scale-110">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        </span>
        <span class="px-1 text-center text-xs font-semibold">{t('cmoments.card.you')}</span>
      </button>

      <!-- Plaatshouders zolang er nog niets is goedgekeurd (vullen precies één rij) -->
      {Array.from({ length: 5 }).map((_, i) => (
        <div data-placeholder class:list={['aspect-square items-center justify-center rounded-2xl bg-[#F4FBFB]', i < 2 ? 'flex' : i === 2 ? 'hidden sm:flex' : 'hidden lg:flex']}>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-opacity="0.3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
        </div>
      ))}
    </div>
    <p id="cmoments-empty" class="mt-5 text-center text-sm text-gray-500">{t('cmoments.empty.text')}</p>
  </div>
  </div>

  <!-- Moment groot bekijken -->
  <dialog id="moment-dialog" class="m-auto w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-[1.5rem] p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm">
    <div class="grid md:grid-cols-[1.2fr_1fr]">
      <img id="moment-photo" alt="" class="aspect-square w-full bg-gray-100 object-cover" />
      <div class="relative flex flex-col p-6 md:p-7">
        <button type="button" data-close-moment class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <p id="moment-name" class="pr-10 font-semibold text-gray-900"></p>
        <p id="moment-location" class="mt-0.5 text-xs uppercase tracking-[0.15em] text-[#1CABB0]"></p>
        <p id="moment-story" class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-gray-700"></p>
      </div>
    </div>
  </dialog>

  <!-- Formulier (pop-up) -->
  <dialog id="share-dialog" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-[1.75rem] p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm">
    <form id="share-form" class="relative p-6 md:p-8" novalidate>
      <button type="button" data-close-share class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>

      <div data-form-fields>
        <h3 class="pr-10 text-2xl font-semibold tracking-tight text-black">{t('cmoments.form.title')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">{t('cmoments.form.intro')}</p>

        <!-- Foto -->
        <label class="mt-6 flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-[#1CABB0]/30 bg-[#F4FBFB] text-center transition hover:border-[#1CABB0]">
          <img id="share-preview" alt="" class="hidden aspect-[4/3] w-full object-cover" />
          <span id="share-photo-label" class="flex flex-col items-center gap-2 px-4 py-8 text-sm text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1CABB0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
            <span class="font-semibold text-gray-900">{t('cmoments.form.photo')}</span>
            <span class="text-xs">{t('cmoments.form.photoHint')}</span>
          </span>
          <input type="file" name="photo" accept="image/*" required class="sr-only" />
        </label>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <input name="name" required maxlength="60" placeholder={t('cmoments.form.name')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
          <input name="location" required maxlength="80" placeholder={t('cmoments.form.location')} class="rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />
        </div>
        <textarea name="story" required maxlength="600" rows="4" placeholder={t('cmoments.form.story')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]"></textarea>
        <input name="instagram" maxlength="40" placeholder={t('cmoments.form.instagram')} class="mt-3 w-full rounded-xl border border-black/10 px-4 py-3 text-sm outline-none transition focus:border-[#1CABB0]" />

        <!-- Spam-val: onzichtbaar voor mensen -->
        <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <label class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-gray-600">
          <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#1CABB0]" />
          {t('cmoments.form.consent')}
        </label>

        <p id="share-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></p>

        <button type="submit" class="mt-6 w-full rounded-full bg-[#1CABB0] px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-[#15939a] disabled:opacity-60">
          {t('cmoments.form.submit')}
        </button>
      </div>

      <!-- Bedankt -->
      <div data-form-thanks class="hidden py-6 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#E6F6F6] text-[#1CABB0]">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
        </div>
        <h3 class="mt-5 text-2xl font-semibold tracking-tight text-black">{t('cmoments.thanks.title')}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-600">{t('cmoments.thanks.text')}</p>
        <button type="button" data-close-share class="mt-6 rounded-full bg-[#1CABB0] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#15939a]">
          {t('cmoments.form.close')}
        </button>
      </div>
    </form>
  </dialog>
</section>

<script define:vars={{ messages, notify }}>
  const grid = document.getElementById('cmoments-grid');
  const empty = document.getElementById('cmoments-empty');
  const dialog = document.getElementById('share-dialog');
  const form = document.getElementById('share-form');
  const errorBox = document.getElementById('share-error');
  const preview = document.getElementById('share-preview');
  const photoLabel = document.getElementById('share-photo-label');
  const fields = form.querySelector('[data-form-fields]');
  const thanks = form.querySelector('[data-form-thanks]');
  const submit = form.querySelector('button[type="submit"]');
  const submitText = submit.textContent;

  const escape = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Goedgekeurde momenten laden en als feed-tegels tonen (na de "+"-tegel)
  const momentDialog = document.getElementById('moment-dialog');
  let moments = [];

  fetch('/api/moments')
    .then((r) => (r.ok ? r.json() : []))
    .catch(() => [])
    .then((items) => {
      if (!Array.isArray(items) || items.length === 0) return;
      moments = items;

      grid.querySelectorAll('[data-placeholder]').forEach((el) => el.remove());
      empty.hidden = true;

      // Momenten van de afgelopen 7 dagen krijgen een "Nieuw"-label
      const WEEK = 7 * 24 * 60 * 60 * 1000;
      grid.insertAdjacentHTML('beforeend', items.map((m, i) => `
        <button type="button" data-moment="${i}" class="moment-pop group relative block aspect-square overflow-hidden rounded-2xl bg-gray-100" style="animation-delay: ${Math.min(i, 12) * 70}ms">
          <img src="${escape(m.photo)}" alt="${escape(m.location)}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          ${m.approvedAt && Date.now() - new Date(m.approvedAt).getTime() < WEEK ? `<span class="absolute left-2 top-2 z-10 rounded-full bg-[#1CABB0] px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider text-white shadow">${escape(messages.isNew)}</span>` : ''}
        </button>`).join(''));
    });

  // Moment groot openen
  const openMoment = (e) => {
    const tile = e.target.closest('[data-moment]');
    if (!tile) return;
    const m = moments[Number(tile.dataset.moment)];
    document.getElementById('moment-photo').src = m.photo;
    document.getElementById('moment-location').textContent = m.location;
    document.getElementById('moment-story').textContent = m.story;
    document.getElementById('moment-name').innerHTML = escape(m.name) + (m.instagram
      ? ` <a href="https://www.instagram.com/${encodeURIComponent(m.instagram)}/" target="_blank" rel="noopener noreferrer" class="font-normal text-[#1CABB0] hover:underline">@${escape(m.instagram)}</a>`
      : '');
    momentDialog.showModal();
  };
  grid.addEventListener('click', openMoment);
  momentDialog.querySelector('[data-close-moment]').addEventListener('click', () => momentDialog.close());
  momentDialog.addEventListener('click', (e) => { if (e.target === momentDialog) momentDialog.close(); });

  // Pop-up openen en sluiten
  document.querySelectorAll('[data-open-share]').forEach((btn) => btn.addEventListener('click', () => dialog.showModal()));
  form.querySelectorAll('[data-close-share]').forEach((btn) => btn.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    if (!thanks.classList.contains('hidden')) {
      form.reset();
      preview.classList.add('hidden');
      photoLabel.classList.remove('hidden');
      fields.classList.remove('hidden');
      thanks.classList.add('hidden');
    }
  });

  // Fotovoorbeeld
  form.photo.addEventListener('change', () => {
    const file = form.photo.files[0];
    if (!file) return;
    preview.src = URL.createObjectURL(file);
    preview.classList.remove('hidden');
    photoLabel.classList.add('hidden');
  });

  // Foto verkleinen in de browser (max. 1600 px, JPEG), zodat ook grote telefoonfoto's werken
  async function shrinkPhoto(file) {
    const MAX = 1600;
    const url = URL.createObjectURL(file);
    try {
      const img = await new Promise((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = reject;
        el.src = url;
      });
      const scale = Math.min(1, MAX / Math.max(img.naturalWidth, img.naturalHeight));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.naturalWidth * scale);
      canvas.height = Math.round(img.naturalHeight * scale);
      canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
      return await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.82));
    } catch {
      return null;
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  // Versturen
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submit.disabled = true;
    submit.textContent = messages.sending;
    try {
      const photo = await shrinkPhoto(form.photo.files[0]);
      if (!photo) {
        errorBox.textContent = messages.photo;
        errorBox.classList.remove('hidden');
        return;
      }

      const data = new FormData(form);
      data.set('photo', photo, 'moment.jpg');
      const res = await fetch('/api/moments', { method: 'POST', body: data });
      if (!res.ok) throw new Error();

      // Mail naar Mayra (mag mislukken zonder dat de inzending misgaat)
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({
          access_key: notify.accessKey,
          subject: 'Nieuw moment ingestuurd voor YOUR Moments',
          from_name: 'MAY WAYS website',
          Naam: data.get('name'),
          Plek: data.get('location'),
          Verhaal: data.get('story'),
          Instagram: data.get('instagram') || '-',
          Goedkeuren: notify.adminUrl,
        }),
      }).catch(() => {});

      fields.classList.add('hidden');
      thanks.classList.remove('hidden');
    } catch {
      errorBox.textContent = messages.error;
      errorBox.classList.remove('hidden');
    } finally {
      submit.disabled = false;
      submit.textContent = submitText;
    }
  });
</script>

<style is:global>
  /* Speelse binnenkomst van de momenten in de feed */
  @keyframes moment-pop {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
  }
  .moment-pop {
    animation: moment-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
</style>
