---
import BaseLayout from "../../layouts/BaseLayout.astro";
import headerImg from "../../assets/Header.avif";
import { ui, defaultLang } from '../../i18n/ui';
import fs from 'node:fs';
import path from 'node:path';



import MayWayMoments from "./MayWayMoments.astro";
// import CommunityMoments from './CommunityMoments.astro'; // tijdelijk uit, zie onderaan

const pathLang = Astro.url.pathname.split('/')[1];

const lang =
  pathLang === 'nl' || pathLang === 'en'
    ? pathLang
    : defaultLang;

function t(key: string) {
  const dict = (ui[lang as keyof typeof ui] ?? ui[defaultLang]) as Record<string, string>;
  return dict[key] ?? key;
}

function imageSrc(src: string) {
  return fs.existsSync(path.join(process.cwd(), 'public', src)) ? src : null;
}

// Bestemmingen (foto's hier te vervangen; ontbreekt een foto, dan toont de kaart een turquoise vlak)
const destinations = [
  { key: 'au', image: '/images/australia/byronbay.jpg', href: `/${lang}/destinations/australia/`, coords: '25.27° S · 133.77° E' },
  { key: 'nz', image: '/images/australia/nz.jpg', href: `/${lang}/destinations/new-zealand/`, coords: '40.90° S · 174.88° E' },
].map((d) => ({
  ...d,
  src: imageSrc(d.image),
  name: t(`community.dest.${d.key}.name`),
  tags: t(`community.dest.${d.key}.tags`).split('|'),
  desc: t(`community.dest.${d.key}.desc`),
  cta: t(`community.dest.${d.key}.cta`),
}));
---

<BaseLayout>
  <section class="relative bg-[#FFFDFA]">

    <!-- HERO -->
    <!-- Zelfde afmetingen als de hero op For Brands, zodat de titel op exact dezelfde plek staat -->
    <div class="relative flex min-h-[640px] h-[100svh] items-center justify-center overflow-hidden rounded-b-[48px] md:rounded-b-[80px]">

      <!-- Donkere laag, sterker links achter de tekst en bovenin voor het menu (zoals de homepagina) -->
      <div class="absolute inset-0 z-10 bg-black/20"></div>
      <div class="absolute inset-0 z-10 bg-gradient-to-r from-black/45 via-black/15 to-transparent"></div>
      <div class="absolute inset-x-0 top-0 z-10 h-40 bg-gradient-to-b from-black/30 to-transparent"></div>

      <!-- IMAGE -->
<img
  src="/images/australia/aus_main.jpg"
  alt="Australia"
  class="absolute inset-0 z-0 h-full w-full object-cover"
/>


      <!-- CONTENT: zelfde opbouw als de homepagina en For Brands (accent, grote zin, uitleg, knoppen) -->
      <div class="relative z-20 mx-auto w-full max-w-7xl px-6 text-center text-white md:px-12 md:text-left">
       <div class="mx-auto max-w-2xl md:mx-0">

        <p class="font-neucha mb-4 flex items-center justify-center gap-3 text-xl leading-none text-[#8EE3DF] md:justify-start md:text-2xl">
          <span class="hidden h-px w-10 bg-[#8EE3DF] md:block" aria-hidden="true"></span>
          MAY WAY {t('community.title')}
        </p>

        <h1 class="text-5xl font-bold leading-[1.02] tracking-tight text-white [text-wrap:balance] md:text-7xl" style="text-shadow: 0 2px 18px rgba(4, 40, 42, 0.35);">
          {t('community.hero.headline')}
        </h1>

        <p class="mx-auto mt-6 max-w-md text-base text-white/85 md:mx-0 md:text-lg">
          {t('community.hero.line')}
        </p>

        <!-- CTA'S: links wit gevuld, rechts omrand -->
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row md:justify-start">

<a
  href={`/${lang}/destinations`}
  class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white bg-white px-8 py-3 text-sm font-semibold text-[#0F7C82] shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#E6F6F6]"
>
  {t('community.ctaBlogs')}

  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M5 12h14"></path>
    <path d="m12 5 7 7-7 7"></path>
  </svg>
</a>


          <!-- SECONDARY -->
          <a
            href="#moments"
            class="inline-flex min-w-[13rem] items-center justify-center gap-2 rounded-full border-2 border-white/60 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white"
          >
            {t('community.ctaEvents')}

            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

        </div>

       </div>
      </div>

      <!-- Locatie (zelfde als For Brands) -->
      <a href="https://www.google.com/maps/search/?api=1&query=Kakadu+National+Park,+Northern+Territory,+Australia" target="_blank" rel="noopener noreferrer" title="Google Maps" class="absolute bottom-10 right-10 z-20 flex items-center gap-2 rounded-full bg-black/35 px-4 py-2 backdrop-blur-sm transition hover:bg-black/55">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span class="text-[10px] uppercase tracking-wide md:text-sm text-white/90">{t('community.hero.location')}</span>
      </a>
    </div>
  </section>

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-16 md:pt-28 md:pb-24">
      <div class="pointer-events-none absolute -right-24 top-24 h-96 w-96 rounded-full bg-[#4ED2CE]/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -left-32 bottom-0 h-72 w-72 rounded-full bg-[#1CABB0]/10 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-16">
        <div>


<!-- Zelfde stijl als "Avontuur in Down Under": normaal + dikgedrukt deel -->
<h1 class="text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl">
  {t('community.intro.title')} <b class="font-semibold">{t('community.intro.titleBold')}</b>
</h1>

<div class="mt-6 max-w-xl text-base leading-relaxed text-gray-600 md:text-lg">
  <p class="font-semibold text-gray-900">
    {t('community.intro.descBold')}
  </p>

  <p class="mt-6">
    {t('community.intro.descNormal')}
  </p>
</div>

        </div>

        <!-- Twee foto's in dezelfde stijl als de services op For Brands: een grote en een kleine schuin eroverheen -->
        <div class="relative mx-auto w-full max-w-md pb-8 lg:max-w-none">
          <img
            src="/images/comfortzone/jump.jpg"
            alt=""
            class="ml-auto aspect-[4/5] w-[72%] rounded-[2rem] object-cover shadow-[0_25px_60px_rgba(0,0,0,0.15)]"
          />
          <img
            src="/images/comfortzone/lach.jpg"
            alt=""
            loading="lazy"
            class="absolute bottom-0 left-0 aspect-square w-[44%] -rotate-3 rounded-[1.5rem] border-[6px] border-[#FFFDFA] object-cover shadow-xl"
          />
        </div>
      </div>
    </section>


 
  <!-- BESTEMMINGEN: turquoise blok met twee grote kaarten -->
  <section id="reisplan" class="bg-[#FFFDFA] px-3 pt-6 md:px-6 md:pt-10">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-[#0F7C82] px-5 py-14 text-white md:rounded-[3.5rem] md:px-12 md:py-20">

      <!-- Kop -->
      <div class="mx-auto max-w-4xl text-center md:flex md:items-end md:justify-between md:gap-10 md:text-left">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-white/80">{t('community.dest.eyebrow')}</p>
          <h2 class="mt-3 text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl">{t('community.dest.title')}</h2>
        </div>
      </div>

      <!-- Kaarten -->
      <div class="mx-auto mt-12 grid max-w-4xl gap-5 md:mt-14 md:grid-cols-2 md:gap-6">
        {destinations.map((d, i) => (
          <a
            href={d.href}
            class:list={['group relative block aspect-[4/5] overflow-hidden rounded-[2rem] bg-[#0B5F64] shadow-[0_30px_60px_rgba(0,0,0,0.25)]', { 'md:translate-y-10': i === 1 }]}
          >
            {d.src ? (
              <img src={d.src} alt={d.name} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-[#0B5F64] to-[#084649]"></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-black/20"></div>

            <!-- Boven: sfeerlabels + coördinaten -->
            <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-5 md:p-7">
              <ul class="flex flex-wrap gap-2">
                {d.tags.map((tag) => (
                  <li class="rounded-full bg-white/15 px-3 py-1 text-xs backdrop-blur-sm">{tag}</li>
                ))}
              </ul>
              <span class="hidden shrink-0 text-[0.65rem] uppercase tracking-[0.2em] text-white/70 sm:block">{d.coords}</span>
            </div>

            <!-- Onder: nummer, naam, tekst, knop -->
            <div class="absolute inset-x-0 bottom-0 p-6 md:p-9">
              <h3 class="text-3xl font-semibold leading-none tracking-tight md:text-4xl">{d.name}</h3>
              <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-white/85 md:text-base">{d.desc}</p>
              <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-[#0F7C82] transition group-hover:bg-[#1CABB0] group-hover:text-white">
                {d.cta}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="hidden md:block md:h-10"></div>
    </div>
  </section>
 


  <MayWayMoments />
  <!-- YOUR Moments staat tijdelijk uit; weer aanzetten door de regel hieronder terug te zetten -->
  <!-- <CommunityMoments /> -->

</BaseLayout>