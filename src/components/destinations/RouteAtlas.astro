---
// Interactieve routekaart: zoomt per route in, tekent de route en toont per stop een foto.
// Gebruik: <RouteAtlas map="/images/australia/australia-shape.svg" routes={australiaRoutes} />
import fs from "node:fs";
import path from "node:path";
import { ui } from "../../i18n/ui";
import type { RouteDef, RouteStop } from "../../data/routes";

export interface Props {
  /** kaart-svg in /public; stops in `routes` gebruiken het coördinatenstelsel van deze svg */
  map: string;
  routes: RouteDef[];
  /** vertaalsleutel voor de tekst onder de titel */
  subtitleKey?: string;
  /** kleinste uitsnede bij inzoomen, als deel van de kaartbreedte */
  minZoom?: number;
}

const { map, routes: routeDefs, subtitleKey = "routes.section.subtitle", minZoom = 0.25 } = Astro.props;

const lang = (Astro.currentLocale as "nl" | "en") ?? "nl";
const t = ui[lang];
const dict = ui[lang] as Record<string, unknown>;
const text = (key: string) => (dict[key] as string | undefined) ?? "";

const svgRaw = fs.readFileSync(path.join(process.cwd(), "public", map), "utf8");
const landPaths = [...svgRaw.matchAll(/\sd="([^"]+)"/g)].map((m) => m[1]);
const [mx, my, mw, mh] = (svgRaw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 600 600").split(/\s+/).map(Number);

const MAP = { x: mx, y: my, w: mw, h: mh };
const RATIO = MAP.w / MAP.h;
const overview = [MAP.x - 10, MAP.y - 10, MAP.w + 20, MAP.h + 20];

type Stop = RouteStop;

// "Hutt Lagoon" → "hutt-lagoon", "Wānaka" → "wanaka" (sleutel voor de stoptekst in ui.ts)
function stopKey(name: string) {
  return name
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

// **woord** in de tekst wordt dikgedrukt (rest wordt veilig ge-escaped)
function withBold(s: string) {
  const esc = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return esc.replace(/\*\*(.+?)\*\*/g, '<b class="font-semibold text-[#0B1F22]">$1</b>');
}

// "Afstand: ±1.250 km" → { label: "Afstand", value: "±1.250 km" }
function toFact(line: string) {
  const m = line.match(/^([^:]+):\s*(.+)$/);
  return m ? { label: m[1].trim(), value: m[2].trim() } : { label: "", value: line };
}

// NL heeft de expand-tekst als string, EN als object: beide omzetten naar hetzelfde formaat
// feiten = alle "Label: waarde"-regels (route, afstand, reistijd, ...), highlights = de •-regels
function normalizeExpand(expand: unknown) {
  if (typeof expand !== "string") {
    const e = expand as { route?: string; distance?: string; facts?: string[]; highlights?: string[] };
    const lines = [e.route, e.distance, ...(e.facts ?? [])].filter((l): l is string => !!l);
    return { facts: lines.map(toFact), highlights: e.highlights ?? [] };
  }
  const lines = expand.split("\n").map((l) => l.trim()).filter(Boolean);
  return {
    facts: lines.filter((l) => !l.startsWith("•") && !/^Highlights/i.test(l)).map(toFact),
    highlights: lines.filter((l) => l.startsWith("•")).map((l) => l.replace(/^•\s*/, "")),
  };
}

// Vloeiende lijn door alle stops (Catmull-Rom → bezier)
function smoothPath(pts: Stop[]) {
  let d = `M${pts[0].x},${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x},${p2.y}`;
  }
  return d;
}

// Uitsnede van de kaart waar naartoe ingezoomd wordt per route (krappe rand = verder ingezoomd, hele route blijft in beeld)
const PAD = MAP.w * 0.025;
// mobiel: staande kaart (breedte / hoogte) met iets meer rand voor de grotere plaatsnamen
const M_RATIO = 0.68;
const M_PAD = MAP.w * 0.03;
const mobileOverview = (() => {
  const w = overview[2];
  const h = w / M_RATIO;
  return [overview[0], MAP.y + MAP.h / 2 - h / 2, w, h].map((n) => +n.toFixed(2));
})();
const MIN_W = MAP.w * minZoom;
// pins/lijnen ogen op elke kaart even groot (Australië-kaart is 634 breed)
const BASE_W = 634;

const routes = routeDefs.map((r) => {
  const xs = r.stops.map((s) => s.x);
  const ys = r.stops.map((s) => s.y);
  const minX = Math.min(...xs);
  const minY = Math.min(...ys);
  const bw = Math.max(...xs) - minX;
  const bh = Math.max(...ys) - minY;
  const w = Math.max(bw + PAD * 2, (bh + PAD * 2) * RATIO, MIN_W);
  const h = w / RATIO;
  const cx = minX + bw / 2;
  const cy = minY + bh / 2;
  // schaal zodat pins op elk zoomniveau even groot ogen
  const s = w / BASE_W;
  // mobiel: staande uitsnede, zodat lange routes (oost-/westkust) veel verder inzoomen
  const mw = Math.max(bw + M_PAD * 2, (bh + M_PAD * 2) * M_RATIO, MIN_W * 0.6);
  const mh = mw / M_RATIO;
  // Brede, platte routes (zoals de zuidkust) hebben in de staande uitsnede veel ruimte over.
  // Leg die ruimte aan de landkant, zodat er geen lege zee tussen route en foto's komt:
  // routes in de zuidelijke helft onderaan in beeld, in de noordelijke helft bovenaan.
  const maxY = minY + bh;
  const mExtra = mh - (bh + M_PAD * 2);
  const my0 =
    mExtra <= 0 ? cy - mh / 2 : cy > MAP.y + MAP.h / 2 ? maxY + M_PAD - mh : minY - M_PAD;

  return {
    ...r,
    // tussenpunten (via) tellen mee voor de lijn, maar krijgen geen pin, nummer of foto
    stops: r.stops.filter((st) => !st.via),
    title: text(`${r.key}.title`),
    subtitle: text(`${r.key}.subtitle`),
    intro: text(`${r.key}.tagline`),
    // rijtijden-blokje: tekstregels + rijen "traject = rijtijd"
    drive: text(`${r.key}.drive`)
      .split("\n")
      .map((l) => l.trim())
      .map((l) => {
        const [leg, ...time] = l.split("=");
        return time.length ? { leg: leg.trim(), time: time.join("=").trim(), line: "" } : { leg: "", time: "", line: l };
      }),
    info: normalizeExpand(dict[`${r.key}.expand`] ?? ""),
    d: smoothPath(r.stops),
    vb: [cx - w / 2, cy - h / 2, w, h].map((n) => +n.toFixed(2)),
    mvb: [cx - mw / 2, my0, mw, mh].map((n) => +n.toFixed(2)),
    s,
    cx,
  };
});

// vaste classes zodat Tailwind ze vindt
const tabCols =
  routes.length >= 5 ? "md:grid-cols-3 lg:grid-cols-5" : routes.length === 4 ? "lg:grid-cols-4" : "md:grid-cols-3";

const clientData = routes.map((r) => ({
  vb: r.vb,
  mvb: r.mvb,
  // korte tekst per stop (optioneel) uit ui.ts: `stop.<naam>`, bijv. stop.hutt-lagoon
  stops: r.stops.map((s) => ({ name: s.name, img: s.img, desc: text(`stop.${stopKey(s.name)}`) })),
}));
---

<section class="bg-white pb-10 md:pb-12" data-route-atlas>
  <script type="application/json" data-atlas-json set:html={JSON.stringify(clientData)} />

  <!-- Bovenste deel (titel + routekeuze) op een eigen lichte achtergrond, los van het route-verhaal eronder -->
  <div class="bg-[#F1F7F7] py-12 md:py-14">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Titel: op mobiel gecentreerd, vanaf tablet links -->
    <div class="text-center md:text-left">
    <!-- Zelfde grootte als "Ontdek Hotspots" -->
    <h2 class="text-4xl font-normal leading-[1.05] tracking-tight text-black md:text-5xl">
      {t["routes.section.titleStart"]} <b class="font-semibold">{t["routes.section.titleBold"]}</b>
    </h2>
    </div>

    <!-- Routekeuze: knoppen (mobiel onder elkaar, desktop naast elkaar); de gekozen route is turquoise gevuld -->
    <!-- mobiel: compacte knoppen naast elkaar (zo breed als de tekst); vanaf tablet een grid -->
    <div class:list={["mt-8 flex flex-wrap justify-center gap-2 md:mt-10 md:grid md:gap-3", tabCols]} role="tablist">
      {routes.map((r, i) => (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="route-tab flex items-center justify-center gap-3 rounded-full border-2 border-transparent bg-white px-4 py-2 text-center md:px-4 md:py-3"
          data-route-btn={i}
        >
          <span>
            <span class="route-tab-title block text-sm font-semibold leading-tight text-black md:text-base">{r.title}</span>
            <span class="route-tab-sub block text-[11px] text-gray-500 md:text-xs">{r.subtitle}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Route-info + kaart; desktop iets breder dan de tekst, zodat kaart en foto's groter worden -->
    <div class="pt-14 md:pt-16 xl:-mx-12 2xl:-mx-24">

    <!-- Over de route: links titel + route, rechts op een rijtje wat je onderweg ziet -->
    <div data-about-wrap class="scroll-mt-20">
    {routes.map((r, ri) => {
      // eerste feit = de route zelf (Sydney tot Cairns)
      const routeFact = r.info.facts[0];
      return (
      <div class="grid gap-8 border-b border-gray-200 pb-12 text-[#0B1F22] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14" data-about={ri} hidden>
        <!-- desktop: tekst iets naar het midden -->
        <div class="lg:pl-10 xl:pl-20">
          <!-- Route als klein label in blokletters boven de titel (zoals "OVER MAY"), bijv. PERTH — EXMOUTH, met route-icoontje ervoor -->
          {routeFact && (
            <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase leading-none tracking-[0.2em] text-[#12949A]">
              <!-- het horizontale middenstuk van het icoon zit op y=12 (midden); 1px omhoog zodat het
                   gelijk ligt met het midden van de blokletters (die zitten iets boven het midden van de regel) -->
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 -translate-y-px"><circle cx="6" cy="19" r="2.5"></circle><circle cx="18" cy="5" r="2.5"></circle><path d="M8.5 19H17a3.5 3.5 0 0 0 0-7H7a3.5 3.5 0 0 1 0-7h8.5"></path></svg>
              {routeFact.value.replace(/\s+(tot|naar|to)\s+/i, " — ")}
            </p>
          )}
          <h3 class="mt-2 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">{r.title}</h3>
          {r.intro && (
            <p class="mt-4 whitespace-pre-line text-[15px] leading-relaxed text-gray-600 md:text-base" set:html={withBold(r.intro)} />
          )}
        </div>

        <!-- Tekst links blijft even breed; het blokje schuift rechts naast de tekst -->
        <div class="lg:mt-44 lg:w-[26rem] lg:justify-self-center">
        <!-- Rijtijden: turquoise blokje met afstand en een paar trajecten -->
        {r.drive.some((d) => d.leg || d.line) && (
          <div class="max-w-md rounded-2xl bg-[#0F7C82] px-5 py-4 text-white lg:max-w-none">
            {r.drive.map((d) =>
              d.leg ? (
                <p class="flex items-baseline justify-between gap-3 border-b border-white/20 py-1 text-[13px] last:border-0">
                  <span class="font-semibold">{d.leg}</span>
                  <span class="shrink-0 text-white/85">{d.time}</span>
                </p>
              ) : d.line ? (
                <p class="mb-2 text-[13px] leading-snug text-white/90 [&_b]:text-white" set:html={withBold(d.line)} />
              ) : null
            )}
          </div>
        )}
        </div>
      </div>
      );
    })}
    </div>

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-12">

      <!-- Kaart (op mobiel tot bijna aan de schermrand) -->
      <div class="relative -mx-6 md:mx-0">
        <!-- Zoomknoppen: uitzoomen tot heel Australië om te zien waar de route ligt -->
        <div class="absolute right-3 top-3 z-10 flex flex-col overflow-hidden rounded-xl bg-white shadow-[0_8px_24px_rgba(10,59,62,0.15)] md:right-0 md:top-0">
          <button type="button" class="zoom-btn" data-zoom="in" aria-label={t["routes.zoomIn"]} title={t["routes.zoomIn"]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <button type="button" class="zoom-btn border-t border-gray-100" data-zoom="out" aria-label={t["routes.zoomOut"]} title={t["routes.zoomOut"]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
          </button>
          <button type="button" class="zoom-btn border-t border-gray-100" data-zoom="reset" aria-label={t["routes.zoomReset"]} title={t["routes.zoomReset"]}>
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
          </button>
        </div>
        <svg
          class="atlas-map block h-auto w-full"
          viewBox={overview.join(" ")}
          data-mobile-viewbox={mobileOverview.join(" ")}
          role="group"
          aria-label={t["routes.section.title"]}
        >
          <g class="land">
            {landPaths.map((d) => <path d={d} />)}
          </g>

          <!-- alle routes vaag op de achtergrond -->
          <g>
            {routes.map((r) => (
              <path class="ghost" d={r.d} vector-effect="non-scaling-stroke" />
            ))}
          </g>

          {routes.map((r, ri) => (
            <g class="route-layer" data-layer={ri}>
              <path class="route-line" d={r.d} pathLength="1" stroke-width={2.5 * r.s} />
              {r.stops.map((st, i) => {
                const left = st.x > r.cx;
                return (
                  <g
                    class="pin"
                    data-stop={i}
                    tabindex="-1"
                    role="button"
                    aria-label={st.name}
                    transform={`translate(${st.x} ${st.y})`}
                    style={`--i:${i}`}
                  >
                    <!-- pin-body wordt op smalle schermen extra vergroot (zie updatePinScale in het script) -->
                    <g class="pin-body">
                      <circle class="pin-pulse" r={10 * r.s} />
                      <circle class="pin-dot" r={8 * r.s} stroke-width={1.9 * r.s} />
                      <text class="pin-num" font-size={8.5 * r.s} dy={3 * r.s} text-anchor="middle">
                        {i + 1}
                      </text>
                      <text
                        class="pin-label"
                        font-size={12 * r.s}
                        x={(left ? -12.5 : 12.5) * r.s}
                        dy={4.1 * r.s}
                        text-anchor={left ? "end" : "start"}
                        stroke-width={3.8 * r.s}
                      >
                        {st.name}
                      </text>
                    </g>
                  </g>
                );
              })}
            </g>
          ))}
        </svg>
        <p class="mt-4 text-center text-xs text-gray-400">{t["routes.hint"]}</p>
      </div>

      <!-- Stopkaart: grote foto + stops naast de kaart -->
      <div>
        <!-- Foto per stop -->
        <div class="stop-card" data-stop-card>
          <div class="photo relative aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-[#EAF7F7] shadow-[0_24px_50px_rgba(10,59,62,0.18)] lg:aspect-[4/5]">
            <div class="absolute inset-0 grid place-items-center px-6 text-center text-2xl font-semibold tracking-tight text-[#12949A]/60" data-fallback></div>
            <img class="absolute inset-0 h-full w-full object-cover" alt="" data-photo />
          </div>

          <div class="mt-5 flex items-end justify-between gap-4">
            <div class="min-w-0">
              <p class="text-xs uppercase tracking-[0.2em] text-[#12949A]" aria-live="polite">
                {t["routes.stop"]} <span data-counter-i>01</span> / <span data-counter-n>01</span>
              </p>
              <p class="mt-2 truncate text-2xl font-semibold leading-tight tracking-tight text-black md:text-[1.75rem]" data-stop-name></p>
            </div>
            <div class="flex shrink-0 gap-2">
              <button type="button" class="nav-btn" data-prev aria-label={t["routes.prev"]}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
              </button>
              <button type="button" class="nav-btn" data-next aria-label={t["routes.next"]}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
              </button>
            </div>
          </div>

          <!-- Korte tekst per stop; verborgen als er (nog) geen tekst is -->
          <!-- turquoise lijntje links maakt het een rustig, apart tekstblokje onder de naam -->
          <p class="mt-4 max-w-md border-l-2 border-[#12949A]/40 pl-4 text-[13px] leading-relaxed text-gray-600" data-stop-desc hidden></p>
        </div>

        <!-- Stops per route -->
        {routes.map((r, ri) => (
          <div class="mt-6 border-t border-gray-100 pt-6" data-info={ri} hidden>
            <ol class="flex flex-wrap gap-2">
              {r.stops.map((st, i) => (
                <li>
                  <button type="button" class="stop-chip" data-chip={i}>{st.name}</button>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>

    </div>
  </div>
</section>

<style>
  /* ---------- routekeuze ---------- */
  .route-tab {
    cursor: pointer;
    transition: background-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .route-tab:hover {
    transform: translateY(-2px);
    background-color: #e3f0f0;
  }
  /* gekozen route: zelfde petrol als de projecten-achtergrond */
  .route-tab[aria-selected="true"] {
    background-color: #0f7c82;
    box-shadow: 0 12px 28px rgba(15, 124, 130, 0.22);
  }
  .route-tab[aria-selected="true"] .route-tab-title,
  .route-tab[aria-selected="true"] .route-tab-arrow { color: white; }
  .route-tab[aria-selected="true"] .route-tab-sub { color: rgba(255, 255, 255, 0.85); }

  /* ---------- zoomknoppen ---------- */
  .zoom-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: #0f7c82;
    transition: background-color 0.2s;
  }
  .zoom-btn:hover { background: #eaf4f4; }
  @media (hover: hover) {
    .atlas-map { cursor: grab; }
    .atlas-map.is-dragging { cursor: grabbing; }
  }

  /* ---------- kaart ---------- */
  .land path {
    fill: #b5dfe0;
    stroke: white;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ghost {
    fill: none;
    stroke: #12949a;
    stroke-width: 1.25;
    stroke-dasharray: 2 4;
    opacity: 0.3;
  }

  .route-layer {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .route-layer.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .route-line {
    fill: none;
    stroke: #12949a;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .route-layer.is-active .route-line {
    transition: stroke-dashoffset 1.6s ease-in-out 0.6s;
    stroke-dashoffset: 0;
  }

  .pin {
    cursor: pointer;
    opacity: 0;
    outline: none;
  }
  .route-layer.is-active .pin {
    opacity: 1;
    transition: opacity 0.35s calc(0.7s + var(--i) * 0.18s);
  }
  .pin-dot {
    fill: white;
    stroke: #12949a;
    transition: fill 0.25s, stroke 0.25s;
  }
  .pin-num {
    fill: #12949a;
    font-weight: 600;
    pointer-events: none;
  }
  .pin.is-visited .pin-dot { fill: #7fd3d5; stroke: #7fd3d5; }
  .pin.is-current .pin-dot { fill: #0f7c82; stroke: #0f7c82; }
  .pin.is-visited .pin-num,
  .pin.is-current .pin-num { fill: white; }
  .pin-pulse {
    fill: #12949a;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pin.is-current .pin-pulse { animation: pulse 2s ease-out infinite; }
  .pin-label {
    fill: #111827;
    stroke: #fffdfa;
    paint-order: stroke;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .pin:hover .pin-label,
  .pin:focus-visible .pin-label,
  .pin.is-current .pin-label { opacity: 1; }

  @keyframes pulse {
    0% { transform: scale(0.7); opacity: 0.35; }
    100% { transform: scale(2.4); opacity: 0; }
  }

  /* ---------- stopkaart ---------- */
  .stop-card {
    cursor: pointer;
    user-select: none;
    touch-action: pan-y;
  }
  .photo img.is-broken { opacity: 0; }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    background: white;
    color: #12949a;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .nav-btn:hover {
    border-color: #12949a;
    background: rgb(18 148 154 / 0.06);
  }

  .stop-chip {
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    background: white;
    font-size: 0.8rem;
    color: #4b5563;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  /* desktop: grotere stopknoppen */
  @media (min-width: 1024px) {
    .stop-chip {
      padding: 0.5rem 1.1rem;
      font-size: 0.9rem;
    }
  }
  .stop-chip:hover { border-color: #0a3b3e; }
  .stop-chip[aria-current="true"] {
    background: #0a3b3e;
    border-color: #0a3b3e;
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-layer.is-active .route-line,
    .route-layer.is-active .pin { transition: none; }
    .pin.is-current .pin-pulse { animation: none; }
  }
</style>

<script>
  type RouteData = {
    vb: number[];
    mvb: number[];
    stops: { name: string; img: string; desc: string }[];
  };

  document.querySelectorAll<HTMLElement>("[data-route-atlas]").forEach((root) => {
    const routes: RouteData[] = JSON.parse(
      root.querySelector("[data-atlas-json]")?.textContent ?? "[]"
    );
    const svg = root.querySelector<SVGSVGElement>(".atlas-map")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-route-btn]")];
    const layers = [...root.querySelectorAll<SVGGElement>("[data-layer]")];
    const infos = [...root.querySelectorAll<HTMLElement>("[data-info]")];
    const abouts = [...root.querySelectorAll<HTMLElement>("[data-about]")];
    const card = root.querySelector<HTMLElement>("[data-stop-card]")!;
    const photo = root.querySelector<HTMLImageElement>("[data-photo]")!;
    const fallback = root.querySelector<HTMLElement>("[data-fallback]")!;
    const stopName = root.querySelector<HTMLElement>("[data-stop-name]")!;
    const stopDesc = root.querySelector<HTMLElement>("[data-stop-desc]")!;
    const counterI = root.querySelector<HTMLElement>("[data-counter-i]")!;
    const counterN = root.querySelector<HTMLElement>("[data-counter-n]")!;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Op smalle schermen is de kaart klein: vergroot pins en plaatsnamen dan extra (max 2,4x).
    // Via het SVG-attribuut, zodat er rond het midden van de pin geschaald wordt.
    // Op desktop worden rondjes, cijfers en plaatsnamen 1,4x vergroot.
    // Mobiel: elke route heeft een eigen uitsnede, dus corrigeer per route zodat rondjes en
    // plaatsnamen bij alle routes even groot ogen (iets kleiner dan de Zuid-West kust eerst was).
    const M_PIN_REF = 0.955;
    const updatePinScale = () => {
      const small = matchMedia("(max-width: 767px)").matches;
      const k = small ? Math.min(2, Math.max(1, 690 / (svg.clientWidth || 690))) : 1.4;
      layers.forEach((layer, li) => {
        const r = routes[li];
        const f = small && r ? r.mvb[2] / r.vb[2] / M_PIN_REF : 1;
        layer.querySelectorAll<SVGGElement>(".pin-body").forEach((body) =>
          body.setAttribute("transform", `scale(${(k * f).toFixed(3)})`)
        );
      });
    };
    updatePinScale();
    window.addEventListener("resize", updatePinScale);

    let routeIdx = -1;
    let stopIdx = 0;

    // ---------- kaart "vliegt" naar een route ----------
    // Op mobiel een staande kaart met eigen (verder ingezoomde) uitsneden
    const isMobile = matchMedia("(max-width: 767px)").matches;
    if (isMobile) svg.setAttribute("viewBox", svg.dataset.mobileViewbox!);
    const targetOf = (r: RouteData) => (isMobile ? r.mvb : r.vb);
    const overview = svg.getAttribute("viewBox")!.split(/\s+/).map(Number);
    let view = [...overview];
    let raf = 0;

    const setView = (v: number[]) => {
      view = v;
      svg.setAttribute("viewBox", v.map((n) => n.toFixed(2)).join(" "));
    };

    // flight: tussen twee routes even uitzoomen; uit voor de zoomknoppen
    const flyTo = (target: number[], flight = true) => {
      cancelAnimationFrame(raf);
      if (reduceMotion) return setView(target);

      const from = [...view];
      const fromC = [from[0] + from[2] / 2, from[1] + from[3] / 2];
      const toC = [target[0] + target[2] / 2, target[1] + target[3] / 2];
      // tussen twee routes even uitzoomen, zoals een vlucht
      const lift = flight ? Math.max(0, overview[2] * 0.75 - Math.max(from[2], target[2])) : 0;
      // verhouding mag per route verschillen (mobiel): die schuift mee tijdens de vlucht
      const fromR = from[2] / from[3];
      const toR = target[2] / target[3];
      const start = performance.now();
      const duration = flight ? 1300 : 450;

      const step = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        const w = from[2] + (target[2] - from[2]) * e + Math.sin(Math.PI * e) * lift;
        const h = w / (fromR + (toR - fromR) * e);
        const cx = fromC[0] + (toC[0] - fromC[0]) * e;
        const cy = fromC[1] + (toC[1] - fromC[1]) * e;
        setView([cx - w / 2, cy - h / 2, w, h]);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    // ---------- zoomknoppen ----------
    // Uitzoomen schuift stap voor stap naar het midden van Australië, zodat je bij maximaal
    // uitzoomen het hele land ziet en dus waar de route ligt.
    const ZOOM_STEP = 1.6;
    const zoomTo = (dir: "in" | "out") => {
      const [x, y, w, h] = view;
      const c = [x + w / 2, y + h / 2];
      const oc = [overview[0] + overview[2] / 2, overview[1] + overview[3] / 2];
      const ratio = h / w;
      let nw: number;
      let nc = c;
      if (dir === "in") {
        // Mobiel (geen verslepen): ben je verder uitgezoomd dan de route,
        // dan brengt de plus je in één keer terug naar de reisroute
        const route = routes[routeIdx];
        if (isMobile && route) {
          const rv = targetOf(route);
          if (w > rv[2] * 1.01) return flyTo(rv, false);
        }
        nw = Math.max(w / ZOOM_STEP, overview[2] * 0.08);
      } else {
        nw = Math.min(w * ZOOM_STEP, overview[2]);
        const t = overview[2] - w > 0 ? (nw - w) / (overview[2] - w) : 1;
        nc = [c[0] + (oc[0] - c[0]) * t, c[1] + (oc[1] - c[1]) * t];
      }
      const nh = nw * ratio;
      flyTo([nc[0] - nw / 2, nc[1] - nh / 2, nw, nh], false);
    };
    root.querySelector('[data-zoom="in"]')?.addEventListener("click", () => zoomTo("in"));
    root.querySelector('[data-zoom="out"]')?.addEventListener("click", () => zoomTo("out"));
    root.querySelector('[data-zoom="reset"]')?.addEventListener("click", () => {
      if (routes[routeIdx]) flyTo(targetOf(routes[routeIdx]), false);
    });

    // Desktop: kaart verslepen (met de muis) als je ingezoomd bent
    let drag: { x: number; y: number; v: number[]; moved: boolean } | null = null;
    svg.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      drag = { x: e.clientX, y: e.clientY, v: [...view], moved: false };
    });
    window.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 4) return;
      drag.moved = true;
      cancelAnimationFrame(raf);
      const k = drag.v[2] / svg.clientWidth;
      setView([drag.v[0] - dx * k, drag.v[1] - dy * k, drag.v[2], drag.v[3]]);
      svg.classList.add("is-dragging");
    });
    window.addEventListener("pointerup", () => {
      if (drag?.moved) {
        // voorkom dat loslaten op een pin ook een klik wordt
        svg.addEventListener("click", (ev) => ev.stopPropagation(), { capture: true, once: true });
      }
      drag = null;
      svg.classList.remove("is-dragging");
    });

    // ---------- foto's ----------
    photo.addEventListener("error", () => photo.classList.add("is-broken"));
    photo.addEventListener("load", () => photo.classList.remove("is-broken"));

    const setStop = (i: number, animate = true) => {
      const route = routes[routeIdx];
      if (!route) return;
      const n = route.stops.length;
      stopIdx = (i + n) % n;
      const stop = route.stops[stopIdx];

      layers[routeIdx].querySelectorAll<SVGGElement>(".pin").forEach((pin, pi) => {
        pin.classList.toggle("is-current", pi === stopIdx);
        pin.classList.toggle("is-visited", pi < stopIdx);
      });
      infos[routeIdx].querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((chip, ci) => {
        chip.setAttribute("aria-current", String(ci === stopIdx));
      });

      counterI.textContent = String(stopIdx + 1).padStart(2, "0");
      counterN.textContent = String(n).padStart(2, "0");
      stopName.textContent = stop.name;
      stopDesc.textContent = stop.desc;
      stopDesc.hidden = !stop.desc;
      fallback.textContent = stop.name;
      photo.alt = stop.name;
      photo.classList.remove("is-broken");
      photo.src = stop.img;

      if (animate && !reduceMotion) {
        card.animate(
          [
            { opacity: 0, transform: "translateY(8px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 400, easing: "cubic-bezier(.2,.8,.2,1)" }
        );
      }
    };

    const setRoute = (ri: number) => {
      if (ri === routeIdx) return;
      routeIdx = ri;

      tabs.forEach((tab, ti) => tab.setAttribute("aria-selected", String(ti === ri)));
      infos.forEach((info, ii) => (info.hidden = ii !== ri));
      abouts.forEach((about, ai) => (about.hidden = ai !== ri));
      layers.forEach((layer, li) => {
        layer.classList.remove("is-active");
        layer.querySelectorAll<SVGGElement>(".pin").forEach((pin) => {
          pin.setAttribute("tabindex", li === ri ? "0" : "-1");
        });
      });
      // reflow zodat de lijn opnieuw getekend wordt
      void svg.getBoundingClientRect();
      layers[ri].classList.add("is-active");

      flyTo(targetOf(routes[ri]));
      setStop(0);
    };

    // ---------- events ----------
    // Klik op een routeknop: scroll naar de route-info boven de kaart (als die niet al bovenin staat)
    // en teken de route pas als je er bent, zodat je de lijn ziet verschijnen
    const aboutWrap = root.querySelector<HTMLElement>("[data-about-wrap]")!;
    tabs.forEach((tab, ti) =>
      tab.addEventListener("click", () => {
        const headerOffset = 80;
        const rect = aboutWrap.getBoundingClientRect();
        const inView = rect.top >= headerOffset && rect.top <= window.innerHeight / 2;
        if (inView) {
          setRoute(ti);
          return;
        }
        window.scrollTo({ top: window.scrollY + rect.top - headerOffset, behavior: reduceMotion ? "auto" : "smooth" });
        window.setTimeout(() => setRoute(ti), reduceMotion ? 0 : 500);
      })
    );

    layers.forEach((layer) => {
      layer.querySelectorAll<SVGGElement>(".pin").forEach((pin) => {
        const go = () => setStop(Number(pin.dataset.stop));
        pin.addEventListener("click", go);
        pin.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            go();
          }
        });
      });
    });

    infos.forEach((info) => {
      info.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((chip) => {
        chip.addEventListener("click", () => setStop(Number(chip.dataset.chip)));
      });
    });

    root.querySelector("[data-prev]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      setStop(stopIdx - 1);
    });
    root.querySelector("[data-next]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      setStop(stopIdx + 1);
    });

    // klik op de foto = volgende stop, swipen = vorige/volgende
    let startX = 0;
    let swiped = false;
    card.addEventListener("pointerdown", (e) => {
      startX = e.clientX;
      swiped = false;
    });
    card.addEventListener("pointerup", (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) {
        swiped = true;
        setStop(stopIdx + (dx < 0 ? 1 : -1));
      }
    });
    card.addEventListener("click", () => {
      if (!swiped) setStop(stopIdx + 1);
    });

    root.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("[data-route-btn]")) return;
      if (e.key === "ArrowRight") setStop(stopIdx + 1);
      if (e.key === "ArrowLeft") setStop(stopIdx - 1);
    });

    // eerst het hele continent, inzoomen zodra de sectie in beeld komt
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            setRoute(0);
          }
        },
        { threshold: 0.35 }
      );
      io.observe(svg);
    } else {
      setRoute(0);
    }
  });
</script>
