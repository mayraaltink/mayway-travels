---
// src/components/ui/MayWayMoments.astro
// Jouw eigen favoriete momenten als swipe. De momenten staan in src/data/moments.ts.
import fs from 'node:fs';
import path from 'node:path';
import { ui, defaultLang } from '../../i18n/ui';
import { moments as allMoments } from '../../data/moments';

const lang = (Astro.currentLocale || defaultLang) as 'nl' | 'en';

function t(key: string) {
  const dict = ui[lang] as Record<string, string>;
  return dict[key] ?? key;
}

const moments = allMoments.map((m) => ({
  src: fs.existsSync(path.join(process.cwd(), 'public', m.image)) ? m.image : null,
  title: m.title[lang],
  location: m.location,
  story: m.story[lang],
}));
---

<section id="moments" class="scroll-mt-20 bg-[#FFFDFA] px-3 pt-16 md:px-6 md:pt-24">
  <div class="moments-swipe mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-[#E6F6F6] py-14 md:rounded-[3.5rem] md:py-20">

    <!-- Kop -->
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-semibold leading-[1.0] tracking-tight text-black md:text-[2.5rem]">{t('moments.title')}</h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-600 md:text-base">{t('moments.intro')}</p>
    </div>

    <!-- Swipe in dezelfde stijl als de logo-carousel (Eerdere samenwerkingen) -->
    <div class="relative mx-auto mt-10 max-w-6xl px-6 md:mt-12">
      <div class="moments-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth md:gap-5" style="scrollbar-width: none; -ms-overflow-style: none;">
      {moments.map((moment) => (
        <button
          type="button"
          class="moment-card group relative block aspect-[4/5] w-[72%] shrink-0 snap-start overflow-hidden rounded-[1.75rem] bg-[#0B5F64] text-left sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2.5rem)/3)]"
          data-src={moment.src ?? ''}
          data-title={moment.title}
          data-location={moment.location}
          data-story={moment.story}
        >
          {moment.src ? (
            <img src={moment.src} alt={moment.title} loading="lazy" draggable="false" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-[#0F7C82] to-[#084649]"></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>

          <div class="absolute inset-x-0 bottom-0 p-5 text-white md:p-6">
            <p class="flex items-center gap-1.5 text-xs uppercase tracking-[0.15em] text-white/80">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              {moment.location}
            </p>
            <h3 class="mt-2 text-xl font-semibold leading-tight tracking-tight md:text-2xl">{moment.title}</h3>
          </div>

          <!-- Plusje: klik voor het verhaal -->
          <span class="absolute right-4 top-4 flex h-6 w-6 items-center justify-center rounded-full bg-white/25 text-white backdrop-blur-sm transition group-hover:rotate-90 group-hover:bg-white group-hover:text-[#1CABB0]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
          </span>
        </button>
      ))}
      </div>

      <!-- Pijlen links en rechts (zelfde als de logo-carousel) -->
      <button type="button" class="moments-prev absolute left-1 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-black shadow-md transition hover:scale-105 disabled:pointer-events-none disabled:opacity-30 md:left-1" aria-label={t('moments.prev')}>←</button>
      <button type="button" class="moments-next absolute right-1 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-black shadow-md transition hover:scale-105 disabled:pointer-events-none disabled:opacity-30 md:right-1" aria-label={t('moments.next')}>→</button>
    </div>

    <!-- Bolletjes -->
    <div class="moments-dots mt-6 flex justify-center gap-2"></div>
  </div>

  <!-- Moment met verhaal (opent bij klikken) -->
  <dialog class="moment-story m-auto w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-[1.75rem] p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm">
    <div class="grid md:grid-cols-[1.1fr_1fr]">
      <div class="relative aspect-[4/5] bg-gradient-to-br from-[#0F7C82] to-[#084649] md:aspect-auto md:min-h-[28rem]">
        <img data-story-photo alt="" class="absolute inset-0 hidden h-full w-full object-cover" />
      </div>
      <div class="relative flex flex-col justify-center p-6 md:p-9">
        <button type="button" data-story-close class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-gray-200" aria-label={t('cmoments.form.close')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <p data-story-location class="flex items-center gap-1.5 pr-10 text-xs uppercase tracking-[0.15em] text-[#1CABB0]"></p>
        <h3 data-story-title class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-black md:text-3xl"></h3>
        <p data-story-text class="mt-5 text-[15px] leading-relaxed text-gray-600 md:text-base"></p>      </div>
    </div>
  </dialog>
</section>

<script>
  function initMomentsSwipe() {
    const root = document.querySelector<HTMLElement>('.moments-swipe');
    const track = root?.querySelector<HTMLElement>('.moments-track');
    const prev = root?.querySelector<HTMLButtonElement>('.moments-prev');
    const next = root?.querySelector<HTMLButtonElement>('.moments-next');
    const dotsContainer = root?.querySelector<HTMLElement>('.moments-dots');
    if (!track || !prev || !next || !dotsContainer) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>('.moment-card');
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const maxIndex = () => Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / step()));
    const index = () => Math.round(track.scrollLeft / step());
    // Aantal kaarten dat tegelijk in beeld is = één "pagina"; één bolletje per pagina
    const perPage = () => Math.max(1, Math.round(track.clientWidth / step()));
    const goTo = (i: number) => track.scrollTo({ left: Math.min(Math.max(i, 0), maxIndex()) * step(), behavior: 'smooth' });

    const createDots = () => {
      dotsContainer.innerHTML = '';
      const pages = Math.ceil(maxIndex() / perPage()) + 1;
      for (let p = 0; p < pages; p++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'moments-dot h-2 w-2 rounded-full transition-all duration-300';
        dot.setAttribute('aria-label', `${p + 1}`);
        dot.addEventListener('click', () => goTo(p * perPage()));
        dotsContainer.appendChild(dot);
      }
      update();
    };

    const update = () => {
      const dots = dotsContainer.querySelectorAll<HTMLElement>('.moments-dot');
      const active = index() >= maxIndex() ? dots.length - 1 : Math.round(index() / perPage());
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#5CC2BF]', i === active);
        dot.classList.toggle('scale-125', i === active);
        dot.classList.toggle('bg-gray-300', i !== active);
      });
      prev.disabled = index() <= 0;
      next.disabled = index() >= maxIndex();
    };

    prev.addEventListener('click', () => goTo(index() - perPage()));
    next.addEventListener('click', () => goTo(index() + perPage()));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', createDots);
    createDots();

    // Moment openen met het verhaal
    const dialog = document.querySelector<HTMLDialogElement>('.moment-story');
    if (!dialog) return;
    const photo = dialog.querySelector<HTMLImageElement>('[data-story-photo]')!;
    const set = (selector: string, value: string) => { dialog.querySelector(selector)!.textContent = value; };

    track.querySelectorAll<HTMLElement>('.moment-card').forEach((card) => {
      card.addEventListener('click', () => {
        const { src = '', title = '', location = '', story = '' } = card.dataset;
        photo.classList.toggle('hidden', !src);
        if (src) { photo.src = src; photo.alt = title; }
        set('[data-story-location]', location);
        set('[data-story-title]', title);
        set('[data-story-text]', story);
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-story-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMomentsSwipe);
  } else {
    initMomentsSwipe();
  }
</script>

<style>
  .moments-track::-webkit-scrollbar {
    display: none;
  }
</style>
